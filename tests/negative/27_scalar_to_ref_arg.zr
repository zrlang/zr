// 负向用例：普通调用的实参核验——标量值传引用形参必须报错。
//
// 方法调用的 receiver 有"自动取引用"语法糖（`a.lt(b)` 的 `a: i64` 对
// `self: &i64`），普通调用**没有**：`g(v)` 传 `fn(&i64)` 形参必须显式
// `&v`，否则实参从未被核验的静默洞会把值当地址用。
//
// expect: expected `&i64`
fn g(x: &i64) -> i64 { return *x; }

fn main() -> i32 {
    let v: i64 = 5;
    if g(v) != 5 { return 1; }
    return 0;
}
