//=============================================================================
// tests/cases/04_comparisons.zr — 对应《Rust 程序设计语言》「运算符」
//
// 覆盖：比较运算 == != < > <= >= 与逻辑运算 ! && ||。
//=============================================================================

fn main() -> i32 {
    if 1 != 1 {
        return 1;
    }
    if !(2 > 1) {
        return 2;
    }
    if !(2 >= 2) {
        return 3;
    }
    return 0;
}
