//=============================================================================
// tests/cases/68_float_widening.zr — 实参的隐式数值拓宽
//
// zr 允许 C 风格的数值拓宽，但早先只在类型层放行、没有生成转换指令：
// `f32` 的 4 字节位模式被当成 `f64` 读，结果是 0.0；整数则根本不在 XMM
// 里，形参拿到垃圾。现在调用点会插入显式转换（`cvtss2sd` / `cvtsi2sd`）。
//=============================================================================

fn takes_f64(x: f64) -> f64 { return x; }
fn add_f64(a: f64, b: f64) -> f64 { return a + b; }

fn main() -> i32 {
    // --- f32 → f64 ---
    let a: f32 = 3.5;
    if takes_f64(a) != 3.5 { return 1; }

    // --- i32 → f64 ---
    let i: i32 = 3;
    if takes_f64(i) != 3.0 { return 2; }

    // --- u32 → f64（2^32-1 在 f64 里可精确表示）---
    let u: u32 = 4294967295;
    if takes_f64(u) != 4294967295.0 { return 3; }

    // --- 多个实参各自转换 ---
    if add_f64(a, i) != 6.5 { return 4; }

    // --- 显式窄化仍然可用 ---
    let d: f64 = 3.5;
    if takes_f64(d as f32) != 3.5 { return 5; }

    return 0;
}
