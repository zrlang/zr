//=============================================================================
// tests/cases/11_if_else_chain.zr — 对应《Rust 程序设计语言》「控制流」
//
// 覆盖：`else if` 链作为表达式取值（嵌套合流）。
//=============================================================================

fn main() -> i32 {
    let n: i32 = 15;
    let v = if n < 10 { 1 } else if n < 20 { 42 } else { 3 };
    if v != 42 {
        return 1;
    }
    return 0;
}
