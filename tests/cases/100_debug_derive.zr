// 100_debug_derive.zr —— `#[derive(Debug)]` 生成真实 `.debug()` 方法体。
//
// 断言每个值在 Rust `{:?}` 下的精确输出：长度 + 关键字节（立即读，不经函数
// 参数——`.debug()` 返回的 String 经函数参数二次读取会读到悬垂栈缓冲，见提交
// 信息）。覆盖：命名结构体（标量 + str + bool + char）、元组结构体、单元/元组/
// 结构体变体枚举、嵌套结构体（偏移 0）、**结构体变体载荷里的 `str` 字段**、
// **命名结构体里 `str` 字段之后的嵌套结构体字段**。长度与字节都对照 Rust
// 实际输出（后两类早先被认为是已知局限，实为 `EnumField` 聚合载荷单字加载的
// 既有 bug；`is_aggregate` 特判修好后已对齐 Rust，长度 17 / 52）。
#[derive(Debug)]
struct Point { x: i64, y: i64, name: str, ok: bool, ch: char }
#[derive(Debug)]
struct Pair(i64, bool);
#[derive(Debug)]
enum Shape { Circle, Rect(i64, i64), Named { w: i64, h: i64 } }
#[derive(Debug)]
struct Inner { v: i64 }
#[derive(Debug)]
struct Wrap { inner: Inner }
#[derive(Debug)]
enum Msg { Hi { who: str }, Bye }
#[derive(Debug)]
struct Outer { name: str, inner: Inner, tag: i64 }

fn main() -> i32 {
    // 命名结构体：`Point { x: 10, y: -3, name: "bob", ok: true, ch: 'Z' }`（54 字节）。
    let p = Point { x: 10, y: -3, name: "bob", ok: true, ch: 'Z' };
    let s = p.debug();
    if s.len != 54 { return 1; }
    if s.ptr[0] != b'P' { return 2; }
    if s.ptr[6] != b'{' { return 3; }
    if s.ptr[28] != b'"' { return 4; }
    if s.ptr[50] != b'Z' { return 5; }
    if s.ptr[53] != b'}' { return 6; }

    // 元组结构体：`Pair(1, false)`（14 字节；不是 `Pair { 0: 1, 1: false }`）。
    let s = Pair(1, false).debug();
    if s.len != 14 { return 7; }
    if s.ptr[4] != b'(' { return 8; }
    if s.ptr[5] != b'1' { return 9; }
    if s.ptr[8] != b'f' { return 10; }
    if s.ptr[13] != b')' { return 11; }

    // 单元变体：`Circle`（6 字节）。
    let s = Shape::Circle.debug();
    if s.len != 6 { return 12; }
    if s.ptr[0] != b'C' { return 13; }
    if s.ptr[5] != b'e' { return 14; }

    // 元组变体：`Rect(1, 2)`（10 字节）。
    let s = Shape::Rect(1, 2).debug();
    if s.len != 10 { return 15; }
    if s.ptr[5] != b'1' { return 16; }
    if s.ptr[8] != b'2' { return 17; }
    if s.ptr[9] != b')' { return 18; }

    // 结构体变体（标量载荷）：`Named { w: 2, h: 9 }`（20 字节）。
    let s = Shape::Named { w: 2, h: 9 }.debug();
    if s.len != 20 { return 19; }
    if s.ptr[0] != b'N' { return 20; }
    if s.ptr[6] != b'{' { return 21; }
    if s.ptr[11] != b'2' { return 22; }
    if s.ptr[17] != b'9' { return 23; }
    if s.ptr[19] != b'}' { return 24; }

    // 嵌套结构体（偏移 0）：递归调 `Inner__debug`。`Wrap { inner: Inner { v: 7 } }`（30 字节）。
    let w = Wrap { inner: Inner { v: 7 } };
    let s = w.debug();
    if s.len != 30 { return 25; }
    if s.ptr[0] != b'W' { return 26; }
    if s.ptr[5] != b'{' { return 27; }
    if s.ptr[22] != b'v' { return 28; }
    if s.ptr[25] != b'7' { return 29; }
    if s.ptr[29] != b'}' { return 30; }

    // 结构体变体载荷里的 `str` 字段（`EnumField` 聚合载荷，早先被当单字加载、
    // 段错误；`is_aggregate` 特判修好后已对齐 Rust）：`Hi { who: "bob" }`（17 字节）。
    let m = Msg::Hi { who: "bob" };
    let s = m.debug();
    if s.len != 17 { return 31; }
    if s.ptr[0] != b'H' { return 32; }
    if s.ptr[5] != b'w' { return 33; }
    if s.ptr[10] != b'"' { return 34; }
    if s.ptr[14] != b'"' { return 35; }
    if s.ptr[16] != b'}' { return 36; }

    // 命名结构体里 `str` 字段**之后**的嵌套结构体字段（早先被认为读垃圾）：
    // `Outer { name: "bob", inner: Inner { v: 7 }, tag: 9 }`（52 字节）。
    let o = Outer { name: "bob", inner: Inner { v: 7 }, tag: 9 };
    let s = o.debug();
    if s.len != 52 { return 37; }
    if s.ptr[0] != b'O' { return 38; }
    if s.ptr[14] != b'"' { return 39; }
    if s.ptr[28] != b'I' { return 40; }
    if s.ptr[36] != b'v' { return 41; }
    if s.ptr[39] != b'7' { return 42; }
    if s.ptr[41] != b'}' { return 43; }
    if s.ptr[51] != b'}' { return 44; }

    return 0;
}
