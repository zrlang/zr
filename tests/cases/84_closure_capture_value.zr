// 覆盖：**带捕获**闭包作为值——存进变量、多次调用、嵌套、多捕获、返回。
//
// 背景：早先带捕获闭包只支持"定义处立即调用"（`(|x| x + n)(2)`），存进变量 /
// 当实参 / 返回会报错。现在 `let f = |x| x + n;` 登记环境结构体 `__env_N`
// （字段 = 捕获 local 的值拷贝），调用点 `f(a)` 按环境 DefId 查回闭包体，
// 在调用点内联展开（`apply_capture_body`：形参绑定 + 捕获 local 替换成
// `f.__cN`）。
//
// 仍不支持（见 `tests/negative/07_closure_capture.zr`）：把带捕获闭包传给
// `fn(..)` 形参——环境值不是函数指针，被调方拿不到捕获 local，跨函数环境
// 传递机制不存在，明确报错。
//
// 语义差异：捕获是**值拷贝**（`__env_N` 字段 = 捕获时点的值），闭包体内对
// 捕获变量的写入只改环境拷贝，不回写外层局部。
fn main() -> i32 {
    // 1. 单个捕获，存变量、多次调用。
    let n: i32 = 40;
    let cap = |x: i32| x + n;
    if cap(2) != 42 {
        return 1;
    }
    if cap(3) != 43 {
        return 2;
    }

    // 2. 多捕获（两个外层局部）。
    let a: i32 = 5;
    let b: i32 = 6;
    let add = |x: i32| x + a + b;
    if add(1) != 12 {
        return 3;
    }

    // 3. 捕获数组并索引。
    let arr = [1, 2, 3];
    let get = |i: i32| arr[i];
    if get(1) != 2 {
        return 4;
    }

    // 4. 嵌套闭包：外层捕获 `a`，内层捕获 `a` 与外层形参 `p`。
    //    早先外层被误判成无捕获、提升成顶层函数，内层环境里 `a` 悬空，
    //    读未初始化栈槽。现在嵌套捕获向外传播，外层也捕获 `a`。
    let outer = |p: i32| {
        let inner = |q: i32| q + a + p;
        inner(10)
    };
    if outer(2) != 17 {
        return 5;
    }

    // 5. 捕获结构体 / 元组字段。
    let v = (1, 2);
    let tup = |k: i32| v.0 + v.1 + k;
    if tup(3) != 6 {
        return 6;
    }

    // 6. 闭包体内用 `return`（返回类型靠 return 反推）。
    let with_ret = |x: i32| {
        return x + a;
    };
    if with_ret(10) != 15 {
        return 7;
    }

    // 7. 返回闭包（同一函数内定义并返回后立即调用）——值语义下返回的是
    //    环境结构体，仍同函数有效。
    let make = |s: i32| {
        let inner = |t: i32| t + s;
        inner(100)
    };
    if make(2) != 102 {
        return 8;
    }

    return 0;
}
