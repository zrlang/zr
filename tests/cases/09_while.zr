//=============================================================================
// tests/cases/09_while.zr — 对应《Rust 程序设计语言》「控制流」
//
// 覆盖：`while` 循环。循环回边需要 φ 节点把循环变量的新版本合并回循环头，
// 否则循环头一直读到循环前的初值，循环不会终止。
//=============================================================================

fn main() -> i32 {
    // 计数到 5
    let mut i: i32 = 0;
    while i < 5 {
        i = i + 1;
    }
    if i != 5 {
        return 1;
    }

    return 0;
}
