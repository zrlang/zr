//=============================================================================
// tests/cases/21_literal_suffixes.zr — 字面量类型后缀
//
// `42u64`、`3.14f32` 这类后缀此前只被词法器校验、随后**丢弃**：解析器一律
// 传 `None`，于是 `1.5f32` 静默变成 f64、`200u8` 静默变成 i32。现在后缀会
// 一路传到类型推断。
//
// 整数后缀主要影响类型层（值在寄存器里不截断），比较难在运行时观察；这里
// 用「无注解 `let` + 对应类型的函数参数」逼出它，并顺带覆盖 u8/i64/u16/
// usize/isize。浮点后缀则可直接观察：f32 存不下 2^24+1。
//
// 词法层面，整数后缀不能用在浮点字面量上（`1.5i32`），反之亦然（`1f32`），
// 这类组合会报错——见 lexer 的单元测试 `literal_suffix_mismatch_is_error`。
//=============================================================================

fn need_f32(x: f32) -> f32 {
    return x * 100.0;
}

fn need_f64(x: f64) -> f64 {
    return x * 100.0;
}

fn need_usize(x: usize) -> usize {
    return x;
}

fn main() -> i32 {
    // --- 后缀决定字面量类型，无注解时也生效 ---
    let a = 1.5f32;
    if need_f32(a) != 150.0 { return 1; }

    let b = 1.5f64;
    if need_f64(b) != 150.0 { return 2; }

    // --- f32 舍入：2^24+1 落到 2^24；f64 则精确 ---
    let big = 16777217.0f32;
    if (big as i64) != 16777216 { return 3; }
    let big64 = 16777217.0f64;
    if (big64 as i64) != 16777217 { return 4; }

    // --- 整数后缀 ---
    let u = 200u8;
    let i = 41i64;
    let s = 100u16;
    if (u as i32) + 1 != 201 { return 5; }
    if i + 1 != 42 { return 6; }
    if (s as i32) * 2 != 200 { return 7; }

    // --- usize / isize ---
    let z = 7usize;
    let w = 7isize;
    if (z as i32) + (w as i32) != 14 { return 8; }

    // 类型名本身也可用（不只是字面量后缀）。
    let zt: usize = 7;
    let wt: isize = -7;
    if (need_usize(zt) as i32) + (wt as i32) != 0 { return 9; }

    return 0;
}
