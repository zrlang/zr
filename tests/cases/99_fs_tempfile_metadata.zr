//=============================================================================
// 临时文件 + 元数据（P1-6a/b）
//
// 早先 `std/fs` 只有目录/文件操作（create_dir / remove_file / file_size /
// read_dir_*），没有**临时文件**、**修改时间**、**权限（st_mode）** 三个 API。
// 现在补上：
//   fs::temp_file() / temp_file_raw()   创建 `/tmp/zr_tmp_<纳秒>` 并打开（可写）
//   fs::file_mtime(path) -> i64         Unix 秒；不存在 -1
//   fs::file_mode(path) -> i64          st_mode 位；不存在 -1
//
// 运行时新增 `zr_file_mtime` / `zr_file_mode`（macOS x86-64 用 `stat$INODE64`
// 的偏移 48 / 4；Linux x86-64 用 `newfstatat` 的偏移 88 / 24；其它平台暂返回 -1，
// 与 `zr_file_size` 的空实现一致）。`zr_time_unix_ns` 与 `zr_open` 原本就有，
// 临时文件名字用纳秒时间戳保证唯一。
//
// 本用例全部必须在 `-O0..-O3/-Oz` 下编译并返回 0。
//=============================================================================

use fs::{temp_file, file_mtime, file_mode, file_size, file_size_raw, remove_file};
use io::File;

fn main() -> i32 {
    // 1) 临时文件：创建、写入、关闭。
    let f = temp_file();
    if !f.is_ok() { return 1; }
    let n = f.write("hello tempfile");
    if n != 14 { return 2; }
    f.close();

    // 2) 元数据：`/tmp` 一定存在，是目录。
    let mtime = file_mtime("/tmp");
    if mtime <= 0 { return 3; }
    let mode = file_mode("/tmp");
    if mode <= 0 { return 4; }
    if (mode & 0x4000) == 0 { return 5; }   // S_IFDIR = 0x4000

    // 3) 元数据：一个真实存在的常规文件，类型位应是 S_IFREG（0x8000）。
    //    `file_size` 按**路径**取大小（`fs::file_size(str)`）；早先它与
    //    `io::file_size(fd)`（`File::size` 的 fd 版）同名，撞成一个 `z_file_size`
    //    符号、MIR 去重只留首个，调用点可能走到 fd 版（str 被当 fd 读，静默
    //    返回 -1）。io 版已改名 `file_size_fd`，现在 `file_size` 唯一（路径版）。
    let path = "/tmp/zr_fs_meta_test";
    remove_file(path);                       // 清理上次残留（可失败）
    let g = File::open(path, 1);             // FILE_WRITE = 1（截断创建）
    if !g.is_ok() { return 6; }
    let w = g.write("meta");
    if w != 4 { return 7; }
    g.close();
    let fmode = file_mode(path);
    if fmode <= 0 { return 8; }
    if (fmode & 0x8000) == 0 { return 9; }   // S_IFREG = 0x8000
    // 路径版 `file_size`（字面量 + 变量路径都走这条，不再被 io::file_size 遮蔽）。
    if file_size(path) != 4 { return 10; }
    let pathvar = path;                       // 变量路径：早先返回 -1 的误判根因
    if file_size(pathvar) != 4 { return 11; }
    let mut pb: [u8; 64] = [0; 64];
    let mut i: usize = 0;
    while i < path.len { pb[i] = path.ptr[i]; i = i + 1; }
    pb[i] = 0;
    if file_size_raw(&pb[0] as *const u8) != 4 { return 12; }
    remove_file(path);

    // 4) 元数据：不存在的路径应返回 -1（不是垃圾值）。
    let missing = "/tmp/zr_no_such_path_xyz";
    if file_mtime(missing) != -1 { return 13; }
    if file_mode(missing) != -1 { return 14; }

    return 0;
}
