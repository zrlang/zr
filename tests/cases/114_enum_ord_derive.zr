//=============================================================================
// tests/cases/114_enum_ord_derive.zr — 枚举上的 `#[derive(PartialOrd, Ord)]`
//
// 早先 derive 对枚举的 `PartialOrd` / `Ord` 直接报错：
//   cannot derive `Ord`/`PartialOrd` for enum ..: ordering needs discriminant
//   comparison, which derive does not implement
// 理由是"要按判别式排序"。但**无显式判别式**的枚举，判别式就是声明下标——
// 按声明顺序比即是正确语义，完全不需要求值任何表达式。现在生成两级 match：
// 外层按 self 的变体、内层按 other 的变体，不同变体按声明顺序定序，同一变体
// 内再对载荷字段做字典序比较（与结构体 `__lt` 同一规则）。带显式判别式
// （`A = 5`）的枚举仍然显式报错：那时声明顺序与判别式顺序可能分家，按声明
// 顺序生成会给出错的顺序（连判别式表达式一起求值属另一个特性）。
//
// 覆盖：无载荷枚举（三种变体的全序）、带载荷枚举（同变体内的字典序、
// 跨变体的声明顺序）、命名类型载荷（递归进 `Key` 的 `__lt`）、
// 运算符形式与方法形式（`.lt/.le/.gt/.ge`）的一致性。
//=============================================================================

#[derive(PartialEq, Eq, PartialOrd, Ord)]
enum Col { R, G, B }

#[derive(PartialEq, Eq, PartialOrd, Ord)]
enum Rank { Low, Mid(i32), High(i32, i32) }

#[derive(PartialEq, Eq, PartialOrd, Ord)]
struct Key { major: i32, minor: i32 }

// 命名类型载荷：载荷比较必须递归进 `Key__lt`（而不是按地址比较）。
#[derive(PartialEq, Eq, PartialOrd, Ord)]
enum Ev { Nop, Put(Key) }

fn check_unit_enum() -> i32 {
    let r: Col = Col::R;
    let g: Col = Col::G;
    let b: Col = Col::B;
    // 声明顺序 R < G < B
    if !(r < g) { return 1; }
    if !(g < b) { return 2; }
    if !(r < b) { return 3; }
    if g < r { return 4; }
    if b < g { return 5; }
    if !(r <= r) { return 6; }
    if !(r >= r) { return 7; }
    if r > r { return 8; }
    // 方法形式与运算符形式必须一致
    if !r.lt(g) || !r.le(g) || !g.gt(r) || !g.ge(r) { return 9; }
    if r.eq(g) || r.lt(r) { return 10; }
    // 最大变体的 `gt` 对任何更早的变体都成立
    if !b.gt(r) || !b.ge(g) { return 11; }
    return 0;
}

fn check_payload_enum() -> i32 {
    // 跨变体：声明顺序压倒载荷值（Low < Mid(-100)）
    let lo: Rank = Rank::Low;
    let m0: Rank = Rank::Mid(0);
    let mneg: Rank = Rank::Mid(-100);
    if lo < m0 { } else { return 20; }
    if mneg < lo { return 21; }
    if !(lo < mneg) { return 22; }
    let h: Rank = Rank::High(0, 0);
    if !(m0 < h) { return 23; }
    if h < lo { return 24; }

    // 同一变体内：载荷字典序
    let m1: Rank = Rank::Mid(1);
    let m2: Rank = Rank::Mid(2);
    if !(m1 < m2) { return 25; }
    if m2 < m1 { return 26; }
    let h12: Rank = Rank::High(1, 2);
    let h13: Rank = Rank::High(1, 3);
    let h20: Rank = Rank::High(2, 0);
    if !(h12 < h13) { return 27; } // 第一个字段相同，看第二个
    if !(h12 < h20) { return 28; } // 第一个字段决定
    if h13 < h12 { return 29; }
    if h12 < h12 { return 30; }
    if !(h12 <= h12) { return 31; }
    if !h12.lt(h13) || !h12.le(h13) || !h13.gt(h12) { return 32; }
    return 0;
}

fn check_named_payload() -> i32 {
    let n: Ev = Ev::Nop;
    let p12: Ev = Ev::Put(Key { major: 1, minor: 2 });
    let p13: Ev = Ev::Put(Key { major: 1, minor: 3 });
    let p20: Ev = Ev::Put(Key { major: 2, minor: 0 });
    if !(n < p12) { return 40; }
    if p12 < n { return 41; }
    // 载荷是命名类型：必须走 `Key__lt`（按内容），不是按地址
    if !(p12 < p13) { return 42; }
    if !(p13 < p20) { return 43; }
    if p20 < p13 { return 44; }
    if p12 < p12 { return 45; }
    if !p12.lt(p13) { return 46; }
    return 0;
}

fn main() -> i32 {
    let r1 = check_unit_enum();
    if r1 != 0 { return r1; }
    let r2 = check_payload_enum();
    if r2 != 0 { return r2; }
    let r3 = check_named_payload();
    if r3 != 0 { return r3; }
    return 0;
}
