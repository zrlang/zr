//=============================================================================
// tests/cases/16_comptime_fn.zr — comptime 函数与常量
//
// 覆盖：`comptime fn` 的编译期调用与折叠、递归、嵌套调用、编译期循环、
// `const` 的右值内联，以及 `const` 在运行期表达式中的引用。
//
// 这些都是回归用例。早先编译器有三个独立的缺陷会让它们红：
//
//  1. `comptime fn` 被解析器吃掉修饰符后丢弃，编译器根本没有调用它的能力；
//  2. `const` 引用在 MIR 降级时被替换成 `Unit` —— 于是
//     `const LIMIT: i32 = 40; if LIMIT != 40` 是拿 unit 做比较，恒不相等；
//  3. 引用 `const` 的表达式类型从常量类型退化成 unit，上下文类型检查跟着报错。
//=============================================================================

const LIMIT: i32 = 40;
const ANSWER: i32 = 42;

// 递归：编译期求值的主要用途
comptime fn fact(n: i32) -> i32 {
    if n <= 1 { 1 } else { n * fact(n - 1) }
}

comptime fn fib(n: i32) -> i32 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

// 编译期循环 + 累加
comptime fn sum_to(n: i32) -> i32 {
    let mut total = 0;
    let mut i = 1;
    while i <= n {
        total += i;
        i += 1;
    }
    return total;
}

// 带 break 的编译期循环
comptime fn first_divisor(n: i32) -> i32 {
    let mut d = 2;
    loop {
        if n % d == 0 { break d; }
        d += 1;
    }
}

// 编译期比较 + 布尔返回
comptime fn is_even(n: i32) -> bool {
    return n % 2 == 0;
}

// `const` 的右值直接调用 comptime 函数
const FACT5: i32 = fact(5);
const FIB10: i32 = fib(10);
const SUM100: i32 = sum_to(100);

fn main() -> i32 {
    // --- comptime 函数被折叠成常量 ---
    if FACT5 != 120 { return 1; }
    if FIB10 != 55 { return 2; }
    if SUM100 != 5050 { return 3; }

    // --- comptime 表达式上下文里的直接调用 ---
    if comptime fact(6) != 720 { return 4; }
    if comptime fib(12) != 144 { return 5; }
    if comptime sum_to(10) != 55 { return 6; }
    if comptime first_divisor(91) != 7 { return 7; }
    if comptime first_divisor(97) != 97 { return 8; }

    // --- comptime 返回 bool ---
    if comptime !is_even(4) { return 9; }
    if comptime is_even(5) { return 10; }

    // --- 嵌套：compptime 结果作为另一个 comptime 调用的实参 ---
    if comptime fact(fib(5)) != 120 { return 11; }

    // --- 常量在运行期表达式中的引用（曾经被降级成 unit）---
    if LIMIT != 40 { return 12; }
    if ANSWER != 42 { return 13; }
    if LIMIT + 2 != ANSWER { return 14; }
    if FACT5 / 4 != 30 { return 15; }
    if LIMIT * 2 != 80 { return 16; }

    // --- 常量参与比较与逻辑运算 ---
    if !(LIMIT < ANSWER) { return 17; }
    if (ANSWER > 100) || (LIMIT > ANSWER) { return 18; }

    // --- 位运算 ---
    if comptime (1 << 10) != 1024 { return 19; }
    if comptime (0xFF & 0x0F) != 15 { return 20; }
    if comptime (0xF0 | 0x0F) != 255 { return 21; }
    if comptime (0xFF ^ 0x0F) != 240 { return 22; }

    // --- 除法 / 取模的编译期折叠 ---
    if comptime 100 / 7 != 14 { return 23; }
    if comptime 100 % 7 != 2 { return 24; }

    return 0;
}