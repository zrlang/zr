//=============================================================================
// tests/cases/14_spill.zr — 寄存器溢出（spilling）
//
// 可分配寄存器只有 10 个 GPR，其中跨调用存活的还只能占 4 个 callee-save。
// 活跃值一多就必须溢出到栈帧，否则后端的寄存器分配会安静地算错。
//
// 这个用例故意让 24 个值同时存活：超过池子大小，逼出溢出路径。
// 覆盖被溢出值作为运算操作数、除数、被除数、比较对象，以及跨调用的值。
//=============================================================================

fn helper(a: i32, b: i32) -> i32 {
    return a - b;
}

fn main() -> i32 {
    let v0: i32 = 1;
    let v1: i32 = 2;
    let v2: i32 = 3;
    let v3: i32 = 4;
    let v4: i32 = 5;
    let v5: i32 = 6;
    let v6: i32 = 7;
    let v7: i32 = 8;
    let v8: i32 = 9;
    let v9: i32 = 10;
    let v10: i32 = 11;
    let v11: i32 = 12;
    let v12: i32 = 13;
    let v13: i32 = 14;
    let v14: i32 = 15;
    let v15: i32 = 16;
    let v16: i32 = 17;
    let v17: i32 = 18;
    let v18: i32 = 19;
    let v19: i32 = 20;
    let v20: i32 = 21;
    let v21: i32 = 22;
    let v22: i32 = 23;
    let v23: i32 = 24;

    // 跨调用存活：这类值只能放 callee-save，池子更紧张
    let t: i32 = helper(v0, v1);
    let s: i32 = v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12 + v13 + v14 + v15 + v16 + v17 + v18 + v19 + v20 + v21 + v22 + v23;

    if s != 300 {
        return 1;
    }

    let u: i32 = s + t - 1;  // 298
    if u != 298 {
        return 2;
    }

    // 被溢出值当除数 / 被除数：x86 的 div 用 rax:rdx，
    // 操作数不能借那两个寄存器，是最容易出错的地方
    let q: i32 = u / 7;
    if q != 42 {
        return 3;
    }

    let w: i32 = u - q * 7;
    if w != 4 {
        return 4;
    }

    let m: i32 = q * 3 + 1;
    if m != 127 {
        return 5;
    }

    // 比较与移位也要走溢出路径
    let sh: i32 = 1;
    let sh2: i32 = sh << 5;
    if sh2 != 32 {
        return 6;
    }

    if q >= u {
        return 7;
    }

    return 0;
}
