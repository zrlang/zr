//=============================================================================
// tests/cases/20_f32.zr — f32（单精度）浮点运算
//
// f32 与 f64 的指令（movss/addss/...）和常量位宽都不同，这一组用例专门
// 覆盖它。此前 IR 的浮点常量不携带位宽（一律存成 f64 位模式），f32 会被
// 按 f64 编码读到错的位，所以后端选择直接报错。
//
// 覆盖：算术、比较（含 NaN）、取负、int<->f32、f32<->f64、跨函数实参/返回、
// 循环累加，以及几条曾静默出错的类型推断路径：
//   - 无注解 `let s = f();`（函数返回 f32，不再是 `_`）
//   - `x_f32 * 100.0` 的字面量位宽跟随左操作数
//   - `-30.0` 这种一元取负的操作数位宽
//   - 取负（一元）结果曾被强行拔到 64 位
//
// 用 2 的幂次分母的值（3.5 / 1.25 / 0.25...），放大成整数后精确可比。
//=============================================================================

fn addf(a: f32, b: f32) -> f32 {
    return a + b;
}

fn hyp2(x: f32, y: f32) -> f32 {
    return x * x + y * y;
}

fn main() -> i32 {
    // --- 基本算术 ---
    let a: f32 = 3.5;
    let b: f32 = 1.25;
    if (a + b) * 100.0 != 475.0 { return 1; }
    if (a - b) * 100.0 != 225.0 { return 2; }
    if (a * b) * 1000.0 != 4375.0 { return 3; }
    if (a / b) * 10.0 != 28.0 { return 4; }

    // --- 循环里的 f32 累加（φ + 回边） ---
    let mut acc: f32 = 0.0;
    let mut i: f32 = 1.0;
    while i <= 4.0 {
        acc = acc + i;
        i = i + 1.0;
    }
    if acc * 100.0 != 1000.0 { return 5; }

    // --- 跨函数的 f32 实参与返回值（走 xmm） ---
    let s: f32 = addf(2.5, 3.25);
    if s * 100.0 != 575.0 { return 6; }
    let h = hyp2(3.0, 4.0);
    if h * 100.0 != 2500.0 { return 7; }

    // --- 无注解 let 绑定一个返回 f32 的调用 ---
    // 这条曾在 `let s = addf(..)` 时把 s 推断成 `_`，后续字面量回落到 f64。
    let u = addf(1.5, 2.0); // 3.5
    if u * 2.0 != 7.0 { return 8; }

    // --- 整数 <-> f32 ---
    let n: i32 = -3;
    let nf: f32 = n as f32;
    if nf * 10.0 != -30.0 { return 9; }
    if nf as i32 != -3 { return 10; }

    // --- f32 <-> f64 ---
    let f1: f32 = 3.5;
    let d: f64 = f1 as f64;
    if d * 100.0 != 350.0 { return 11; }
    let e: f64 = 2.5;
    let ef: f32 = e as f32;
    if ef * 10.0 != 25.0 { return 12; }

    // --- 比较：负数按数值序（`-1.0` / `-30.0` 也顺带覆盖一元取负位宽） ---
    let neg: f32 = -1.0;
    let pos: f32 = 1.0;
    if !(neg < pos) { return 13; }
    if neg > pos { return 14; }
    if !(neg <= -1.0) { return 15; }
    if neg != -1.0 { return 16; }
    if neg == pos { return 17; }

    // --- 取负 ---
    let p: f32 = 3.0;
    if (-p) * 10.0 != -30.0 { return 18; }
    if (-(-p)) * 10.0 != 30.0 { return 19; }

    // --- NaN 语义（IEEE754），与 f64 路径同源 ---
    let zero: f32 = 0.0;
    let nan = zero / zero;
    if nan == nan { return 20; }
    if !(nan != nan) { return 21; }
    if nan < 1.0 { return 22; }
    if nan > 1.0 { return 23; }

    return 0;
}
