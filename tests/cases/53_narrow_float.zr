//=============================================================================
// tests/cases/53_narrow_float.zr — 窄浮点（f8 / f16）
//
// f8 与 f16 的位宽比 f32 窄，寄存器里以 f32 形态存放、落到内存时才按窄
// 位宽打包。这一组用例覆盖：
//   - 算术、比较、取负
//   - 循环累加
//   - 跨函数的实参与返回值
//   - 整数 <-> f16 / f8、f16 <-> f32 / f64
//   - 结构体字段与数组元素（走内存的窄位宽存取）
//   - 舍入：f16 的尾数 10 位、f8 的尾数 3 位，多出来的位要就近偶数舍入
//   - 溢出成 Inf、下溢成 ±0
//
// 用 2 的幂次分母的值（3.5 / 1.25 / 0.25…），放大成整数后精确可比。
//=============================================================================

struct Pair {
    x: f16,
    y: f8,
}

fn add16(a: f16, b: f16) -> f16 {
    return a + b;
}

fn add8(a: f8, b: f8) -> f8 {
    return a + b;
}

fn main() -> i32 {
    // --- f16 基本算术 ---
    let a: f16 = 3.5;
    let b: f16 = 1.25;
    if (a + b) * 100.0 != 475.0 { return 1; }
    if (a - b) * 100.0 != 225.0 { return 2; }
    if (a * b) * 1000.0 != 4375.0 { return 3; }
    if (a / b) * 10.0 != 28.0 { return 4; }

    // --- f8 基本算术 ---
    //
    // f8 的取值范围很小（最大约 240，尾数只有 3 位），所以这里用能被 f8
    // 精确表示的值来比，不放大成整数——放大本身就会先舍入一次。
    let c: f8 = 3.5;
    let d: f8 = 1.25;
    if (c + d) != 5.0 { return 5; }   // 4.75 舍入到 5.0（就近偶数）
    if (c - d) != 2.25 { return 6; }
    if (c * d) != 4.375 { return 7; } // 4.375 恰好 3 位尾数
    if (c / d) != 2.75 { return 8; }  // 2.8 舍入到 2.75

    // --- 循环里的窄浮点累加 ---
    let mut acc: f16 = 0.0;
    let mut i: f16 = 1.0;
    while i <= 4.0 {
        acc = acc + i;
        i = i + 1.0;
    }
    if acc * 100.0 != 1000.0 { return 9; }

    // --- 跨函数的实参与返回值 ---
    let s: f16 = add16(2.5, 3.25);
    if s * 100.0 != 575.0 { return 10; }
    let t: f8 = add8(1.5, 2.5);
    if t * 100.0 != 400.0 { return 11; }

    // --- 整数 <-> 窄浮点 ---
    let n: i32 = -3;
    let nf: f16 = n as f16;
    if nf * 10.0 != -30.0 { return 12; }
    if nf as i32 != -3 { return 13; }
    let nf8: f8 = n as f8;
    if nf8 * 10.0 != -30.0 { return 14; }

    // --- 窄浮点 <-> f32 / f64 ---
    let f1: f16 = 3.5;
    let dd: f64 = f1 as f64;
    if dd * 100.0 != 350.0 { return 15; }
    let e: f64 = 2.5;
    let ef: f16 = e as f16;
    if ef * 10.0 != 25.0 { return 16; }
    let g: f32 = 1.25;
    let gf: f8 = g as f8;
    if gf != 1.25 { return 17; }

    // --- 比较（负数按数值序） ---
    let neg: f16 = -1.0;
    let pos: f16 = 1.0;
    if !(neg < pos) { return 18; }
    if neg > pos { return 19; }
    if neg == pos { return 20; }
    if !(neg <= -1.0) { return 21; }

    // --- 取负 ---
    let p: f16 = 3.0;
    if (-p) * 10.0 != -30.0 { return 22; }

    // --- 结构体字段（窄位宽存内存） ---
    let mut pr = Pair { x: 1.5, y: 2.5 };
    if pr.x != 1.5 { return 23; }
    if pr.y != 2.5 { return 24; }
    pr.x = 4.5;
    pr.y = 4.5;
    if pr.x != 4.5 { return 25; }
    if pr.y != 4.5 { return 26; }

    // --- 数组元素 ---
    let mut arr: [f16; 3] = [1.5, 2.5, 3.5];
    if arr[0] != 1.5 { return 27; }
    if arr[2] != 3.5 { return 28; }
    arr[1] = 9.5;
    if arr[1] != 9.5 { return 29; }
    if arr[0] != 1.5 { return 30; }

    // --- 舍入：f16 的尾数 10 位，1/1024 之后进位 ---
    // 1 + 2^-11 恰好落在 1.0 与 1.0009765625 的中间，就近偶数舍入到 1.0。
    let half: f16 = 1.0f16 + 0.00048828125f16;
    if half != 1.0 { return 31; }
    // 1 + 3/2048 恰好在 1+2^-10 与 1+2^-9 的中间，就近偶数舍入到后者。
    let over: f16 = 1.0f16 + 0.00146484375f16;
    if over * 1024.0 != 1026.0 { return 32; }

    // --- f8 的尾数只有 3 位：1/16 之后进位 ---
    let h8: f8 = 1.0f8 + 0.0625f8;
    if h8 != 1.0 { return 33; }

    // --- 溢出成 Inf、下溢成 ±0 ---
    let big: f16 = 100000.0;
    let inf: f16 = big * 100.0; // 超过 f16 的上限（65504）→ Inf
    if !(inf == inf) { return 34; } // Inf 等于自己（NaN 才不等于自己）
    let nan: f16 = inf - inf;     // Inf - Inf → NaN
    if nan == nan { return 35; }
    let tiny: f16 = 0.000000001;  // 远小于 f16 的最小次正规数（2^-24）→ ±0
    if tiny != 0.0 { return 36; }

    return 0;
}
