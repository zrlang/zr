//=============================================================================
// tests/cases/13_casts.zr — 类型转换 `as`
//
// 覆盖：整数的截断、符号扩展、零扩展，以及转换后参与比较/算术。
//
// 两条约定：
//
// 1. 每条断言都写成"比较"而不是直接把转换结果当返回值——退出码只有 8 位，
//    `-56` 和 `200` 在退出码里长得一模一样，直接比较会掩盖错误。
// 2. 只用 32 位及以下的类型。`as i64` 在 arm-none-eabi / wasm 上还没实现
//    （32 位目标没有 64 位寄存器），写进来会让跨目标编译矩阵直接报错。
//    64 位截断的验证放在宿主（x86-64）上手工做。
//=============================================================================

fn main() -> i32 {
    // --- 同位宽转换是恒等 ---
    let a: i32 = 42;
    if (a as i32) != 42 {
        return 1;
    }

    // --- 变窄：截断到目标位宽 ---
    // 321 = 0b1_0100_0001，取低 8 位是 0b0100_0001 = 65
    let big: i32 = 321;
    if (big as i8) as i32 != 65 {
        return 2;
    }
    // 低 16 位不变
    if (big as i16) as i32 != 321 {
        return 3;
    }

    // --- 符号扩展：i8 的 200（0xC8）应是 -56 ---
    let c200: i32 = 200;
    let s8: i8 = c200 as i8;
    if s8 >= 0 {
        return 4; // 零扩展才会 >= 0
    }
    // -56 + 56 == 0
    if (s8 as i32) + 56 != 0 {
        return 5;
    }

    // --- 零扩展：u8 的 200 就是 200 ---
    let u200: i32 = 200;
    let z8: u8 = u200 as u8;
    if z8 <= 0 {
        return 6; // 符号扩展才会 <= 0
    }
    if (z8 as i32) != 200 {
        return 7;
    }

    // --- 16 位同理：0xFFxx ---
    // 0xFF00 | 0x42 = 0xFF42 = 65346，取低 16 位不变，取低 8 位是 0x42
    let w16: i32 = 65346;
    if (w16 as u16) as i32 != 65346 {
        return 8;
    }
    if (w16 as u8) as i32 != 0x42 {
        return 9;
    }
    // 按 i8 解释 0x42：最高位是 0，所以仍然是正的 0x42 = 66
    let w8s: i8 = w16 as i8;
    if (w8s as i32) != 0x42 {
        return 10;
    }

    // --- 转换参与算术与除法 ---
    // 无符号除法：100 / 7 == 14
    let x: u32 = 100;
    let y: u32 = 7;
    if ((x / y) as i32) != 14 {
        return 11;
    }
    if ((x % y) as i32) != 2 {
        return 12;
    }

    // --- 转换结果可以继续参与比较 ---
    let neg: i8 = -5;
    if (neg as i32) >= 0 {
        return 13;
    }

    return 0;
}