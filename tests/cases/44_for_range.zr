//=============================================================================
// tests/cases/44_for_range.zr — `for x in start..end` 范围循环
//
// 覆盖：排他/包含范围、终点只求值一次、continue（自增仍执行）、break、
// 通配模式、嵌套循环中的 continue 归属，以及 u8 范围。
//=============================================================================

fn end_of(calls: *mut i32) -> i32 {
    *calls = *calls + 1;
    return 4;
}

fn main() -> i32 {
    let mut sum = 0;
    for i in 0..5 {
        sum = sum + i;
    }
    if sum != 10 { return 1; }

    sum = 0;
    for i in 0..=4 {
        sum = sum + i;
    }
    if sum != 10 { return 2; }

    let mut calls = 0;
    sum = 0;
    for i in 0..end_of(&mut calls) {
        sum = sum + i;
    }
    if calls != 1 { return 3; }
    if sum != 6 { return 4; }

    sum = 0;
    for i in 0..5 {
        if i == 1 || i == 3 { continue; }
        sum = sum + i;
    }
    if sum != 6 { return 5; }

    sum = 0;
    for i in 0..10 {
        if i == 3 { break; }
        sum = sum + i;
    }
    if sum != 3 { return 6; }

    let mut count = 0;
    for _ in 0..3 {
        count = count + 1;
    }
    if count != 3 { return 7; }

    sum = 0;
    for i in 0..2 {
        for j in 0..3 {
            if j == 1 { continue; }
            sum = sum + i * 10 + j;
        }
    }
    if sum != 24 { return 8; }

    let mut acc: u8 = 0;
    for i in 0u8..3u8 {
        acc = acc + i;
    }
    if acc != 3 { return 9; }

    return 0;
}
