//=============================================================================
// tests/cases/97_loop_value.zr — `loop` 表达式带值 `break` 的返回值
//
// 早先 `ExprKind::Break` 只记标签、丢弃值，`Expression::Loop` 恒为
// `Ty::Never`：`let x = loop { break 7; };` 静默得 0，`fn f() -> u64 {
// loop { break 5; } }` 也返回 0。本用例钉住（标量）：
//   - `loop` 作为表达式产生带值 `break` 的值
//   - 计算出的累加值（循环体写累加器再 break）
//   - 嵌套循环：内层 break 值被外层丢弃，外层 break 值生效
//   - 绑到变量的 `loop` 表达式
//   - 循环体不 break ⇒ 发散（`fn infinite() -> i64 { loop {} }` 编译通过）
//   - `while` / `for` 是语句：break 值不产生表达式值
//   - 聚合（结构体）作为 break 值——早先 `-O3`/`-Oz` 触发寄存器分配缺陷
//     （值横跨循环出口被与常量 `8` 合并，段错误），见 `docs/task-table.md`
//     P0-7；已修（regalloc 线性位置改按 RPO 编号）。
//=============================================================================

fn const_break() -> i64 { loop { break 5; } }

fn accumulator() -> i64 {
    let mut i: i64 = 0;
    let mut s: i64 = 0;
    loop {
        if i >= 4 { break s; }
        s = s + i;
        i = i + 1;
    }
}

fn nested() -> i64 {
    let mut i: i64 = 0;
    loop {
        let mut j: i64 = 0;
        loop {
            if j >= 3 { break 100; }   // 内层 break 值（被外层丢弃）
            j = j + 1;
        }
        i = i + 1;
        if i >= 2 { break 55; }        // 外层 break 值
    }
}

struct P { x: i64, y: i64 }

fn agg() -> P {
    let mut i: i64 = 0;
    loop {
        if i >= 2 { break P { x: 7, y: 9 }; }
        i = i + 1;
    }
}

fn infinite() -> i64 { loop { } }      // 永不 break：发散，不调用

fn main() -> i32 {
    if const_break() != 5 { return 1; }
    if accumulator() != 6 { return 2; }   // 0+1+2+3
    if nested() != 55 { return 3; }
    // 绑到变量的 `loop` 表达式
    let x = loop { break 7; };
    if x != 7 { return 4; }
    // 聚合 break 值（`-O3`/`-Oz` 早先段错误，见上）
    let p = agg();
    if p.x != 7 || p.y != 9 { return 5; }
    // `while` / `for` 是语句：break 值不产生表达式值
    let mut w: i64 = 0;
    let mut i: i64 = 0;
    while i < 3 { break 99; }          // 作语句，值丢弃
    i = 0;
    for j in 0..3 { break 88; }
    if w != 0 { return 6; }

    return 0;
}
