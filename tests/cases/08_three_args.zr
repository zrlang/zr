//=============================================================================
// tests/cases/08_three_args.zr — 对应《Rust 程序设计语言》「函数」
//
// 覆盖：三参数函数（SysV AMD64 约定下实参走 rdi/rsi/rdx）。
//=============================================================================

/// 三数相加。
fn sum3(a: i32, b: i32, c: i32) -> i32 {
    return a + b + c;
}

fn main() -> i32 {
    if sum3(10, 20, 12) != 42 {
        return 1;
    }
    return 0;
}
