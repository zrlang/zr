//=============================================================================
// tests/cases/31_fn_ptr.zr — 一等函数指针与间接调用
//=============================================================================

fn add(a: i32, b: i32) -> i32 { a + b }
fn sub(a: i32, b: i32) -> i32 { a - b }

fn apply(f: fn(i32, i32) -> i32, a: i32, b: i32) -> i32 {
    f(a, b)
}

fn choose(which: i32) -> fn(i32, i32) -> i32 {
    if which == 0 { add } else { sub }
}

fn fadd(a: f64, b: f64) -> f64 { a + b }

struct Pair {
    a: i32,
    b: i32,
}

fn make_pair(a: i32, b: i32) -> Pair {
    Pair { a, b }
}

struct Ops {
    f: fn(i32, i32) -> i32,
}

fn main() -> i32 {
    let f: fn(i32, i32) -> i32 = add;
    if f(2, 3) != 5 { return 1; }

    let mut g = add;
    g = sub;
    if g(9, 4) != 5 { return 2; }

    if apply(add, 5, 3) != 8 { return 3; }
    if apply(sub, 5, 3) != 2 { return 4; }

    let h = choose(0);
    if h(7, 2) != 9 { return 5; }
    let k = choose(1);
    if k(7, 2) != 5 { return 6; }

    let c = 1;
    let branch = if c == 0 { add } else { sub };
    if branch(8, 3) != 5 { return 7; }

    let ops = Ops { f: add };
    if ops.f(4, 6) != 10 { return 8; }

    let arr = [add, sub];
    let selected = arr[c];
    if selected(10, 4) != 6 { return 9; }

    let nested = apply(choose(0), 20, 22);
    if nested != 42 { return 10; }

    let fa: fn(f64, f64) -> f64 = fadd;
    if fa(1.5, 2.0) != 3.5 { return 11; }

    let mk: fn(i32, i32) -> Pair = make_pair;
    let p = mk(4, 5);
    if p.a != 4 || p.b != 5 { return 12; }

    return 0;
}
