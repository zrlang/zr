//=============================================================================
// tests/cases/121_let_destructure.zr — `let` 位置上的解构模式
//
// `let` 位置只允许**不可反驳**模式：元组 / 结构体 / 定长切片 / 通配。
// 每条解构 `let` 都展开成"先求值到临时量、再逐个子值写进各自的绑定"，
// 因此子绑定一定被初始化。
//
// 早先 `Statement::Let` 只取 `first_binding(...)` 当唯一绑定，而它只认
// 简单绑定 `x`——`let (a, b) = (3, 4);` 的子绑定分配了却永不写值，
// 编译通过、运行读到栈上垃圾（`a + b` 得到随机数）。
//
// 覆盖：
//   - 元组 / 嵌套元组
//   - 结构体模式
//   - 定长数组上的切片模式
//   - 切片上的切片模式（`let [a, b] = xs else { .. };`）
//   - 通配 `let _ = ...`
//=============================================================================

struct P { x: i32, y: i32 }

fn pair() -> (i32, i32) {
    return (3, 4);
}

fn head2(xs: []i32) -> i32 {
    let [a, b] = xs else { return -1; };
    return a * 10 + b;
}

fn main() -> i32 {
    // --- 元组 ---
    let (a, b) = (3, 4);
    if a + b != 7 { return 1; }

    // 初始值是函数调用（临时量）
    let (c, d) = pair();
    if c * d != 12 { return 2; }

    // --- 嵌套元组 ---
    let ((e, f), g) = ((5, 6), 7);
    if e + f + g != 18 { return 3; }

    // --- 结构体模式 ---
    let P { x, y } = P { x: 10, y: 20 };
    if x + y != 30 { return 4; }

    // 结构体模式里的字面量是**可反驳**的，所以只能放在 match / if let；
    // 这里用通配 + 绑定确认字段取值正确。
    let P { x: p, y: _ } = P { x: 9, y: 99 };
    if p != 9 { return 5; }

    // --- 定长数组的切片模式（长度是编译期常量） ---
    let arr: [i32; 2] = [7, 8];
    let [h, i] = arr;
    if h + i != 15 { return 6; }

    let arr3: [i32; 3] = [1, 2, 3];
    let [j, k, l] = arr3;
    if j * 100 + k * 10 + l != 123 { return 7; }

    // --- 切片上的切片模式：长度未知，走 `let ... else` ---
    let s = arr3[1..];
    if head2(s) != 23 { return 8; }
    if head2(arr3[0..2]) != 12 { return 9; }
    let empty: []i32 = arr3[0..0];
    if head2(empty) != -1 { return 10; }

    // --- 通配丢弃 ---
    let _ = pair();
    let _discard = pair();

    // --- match 上的切片模式 ---
    let m = match arr3 {
        [1, 2, 3] => 10,
        [_, _, _] => 20,
        _ => 30,
    };
    if m != 10 { return 11; }
    let n = match s {
        [2, 3] => 40,
        _ => 50,
    };
    if n != 40 { return 12; }

    return 0;
}
