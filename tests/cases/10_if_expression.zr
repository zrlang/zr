//=============================================================================
// tests/cases/10_if_expression.zr — 对应《Rust 程序设计语言》「控制流」
//
// 覆盖：`if` 作为**表达式**取值。then/else 两个分支的值在 join 块合流，
// 同样依赖 φ 节点。
//=============================================================================

fn main() -> i32 {
    let n: i32 = 5;

    // 条件为真
    let v = if n > 3 { 42 } else { 7 };
    if v != 42 {
        return 1;
    }

    return 0;
}
