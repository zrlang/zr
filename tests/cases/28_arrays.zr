// tests/cases/28_arrays.zr — 定长数组与逐元素运算
//
// 覆盖：数组字面量、`[v; N]`、索引读写、数组参数、纯量逐元素展开，
// 以及 128 位整数/浮点数组在 x86-64 上走 SSE 的逐元素运算。

fn sum4(a: [i32; 4]) -> i32 {
    return a[0] + a[1] + a[2] + a[3];
}

fn mutate(mut a: [i32; 3]) -> i32 {
    a[0] = 99;
    return a[0];
}

fn make3() -> [i32; 3] {
    return [10, 20, 30];
}

fn pass3(a: [i32; 3]) -> [i32; 3] {
    return a;
}

fn main() -> i32 {
    let a: [i32; 4] = [1, 2, 3, 4];
    let b: [i32; 4] = [10, 20, 30, 40];
    if a[0] != 1 || a[3] != 4 { return 1; }

    let mut m: [i32; 4] = [1, 2, 3, 4];
    m[1] = 20;
    if m[0] + m[1] + m[2] + m[3] != 28 { return 2; }

    let rep: [i32; 3] = [7; 3];
    if rep[0] != 7 || rep[1] != 7 || rep[2] != 7 { return 3; }

    if sum4(b) != 100 { return 4; }

    // SSE2：i32x4 add/sub/and。
    let add: [i32; 4] = a + b;
    let sub: [i32; 4] = b - a;
    let andv: [i32; 4] = a & b;
    if sum4(add) != 110 { return 5; }
    if sum4(sub) != 90 { return 6; }
    if andv[0] != 0 || andv[1] != 0 || andv[2] != 2 || andv[3] != 0 { return 7; }

    // 非 128 位数组退回逐元素展开。
    let x: [i32; 3] = [1, 2, 3];
    let y: [i32; 3] = [4, 5, 6];
    let z: [i32; 3] = x + y;
    if z[0] != 5 || z[1] != 7 || z[2] != 9 { return 8; }
    let w: [i32; 3] = y * x;
    if w[0] != 4 || w[1] != 10 || w[2] != 18 { return 9; }

    // SSE：f32x4 与 f64x2。
    let fa: [f32; 4] = [1.5, 2.5, 3.5, 4.5];
    let fb: [f32; 4] = [10.0, 20.0, 30.0, 40.0];
    let fc: [f32; 4] = fa * fb;
    let fs: f32 = fc[0] + fc[1] + fc[2] + fc[3];
    if fs < 349.9 || fs > 350.1 { return 10; }

    let da: [f64; 2] = [1.5, 2.5];
    let db: [f64; 2] = [4.0, 8.0];
    let dc: [f64; 2] = db / da;
    let ds: f64 = dc[0] + dc[1];
    if ds < 5.86 || ds > 5.87 { return 11; }

    // SSE2：i64x2 add。
    let ia: [i64; 2] = [7, 9];
    let ib: [i64; 2] = [3, 4];
    let ic: [i64; 2] = ia + ib;
    if ic[0] != 10 || ic[1] != 13 { return 12; }

    // 数组是值语义：赋值/传参都复制，不共享底层存储。
    let orig: [i32; 3] = [1, 2, 3];
    let mut copy: [i32; 3] = orig;
    copy[0] = 9;
    if copy[0] != 9 || orig[0] != 1 { return 13; }
    if mutate(orig) != 99 || orig[0] != 1 { return 14; }

    // 返回数组写入调用方提供的返回槽，返回后仍然有效。
    let made = make3();
    if made[0] != 10 || made[1] != 20 || made[2] != 30 { return 15; }
    let passed = pass3(orig);
    if passed[0] != 1 || passed[2] != 3 { return 16; }

    return 0;
}
