//=============================================================================
// tests/cases/06_functions.zr — 对应《Rust 程序设计语言》「函数」
//
// 覆盖：函数定义、参数、返回值与嵌套调用。
//=============================================================================

/// 加法。
fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

/// 内层再调一层。
fn outer(a: i32, b: i32) -> i32 {
    return add(a, b);
}

fn main() -> i32 {
    if add(20, 22) != 42 {
        return 1;
    }
    if outer(1, 2) != 3 {
        return 2;
    }
    return 0;
}
