//=============================================================================
// tests/cases/65_slices.zr — 切片表达式
//
// 覆盖：
//   - `a[lo..hi]` / `a[lo..=hi]` / `a[lo..]` / `a[..hi]` / `a[..]`
//   - 定长数组、`str`、切片套切片
//   - 运行期边界、切片作为函数参数 / 返回值
//=============================================================================

use path::{substr, basename, extname, has_extension};

fn sum(xs: []i32) -> i32 {
    let mut s = 0;
    let mut i = 0;
    while i < xs.len {
        s = s + xs[i];
        i = i + 1;
    }
    return s;
}

fn head(xs: []i32, n: usize) -> []i32 {
    return xs[..n];
}

fn zero(xs: []mut i32) {
    let mut i = 0;
    while i < xs.len {
        xs[i] = 0;
        i = i + 1;
    }
}

fn tail_str(s: str, from: usize) -> str {
    return s[from..];
}

fn eq(s: str, other: str) -> bool {
    if s.len != other.len {
        return false;
    }
    let mut i = 0;
    while i < s.len {
        if s.ptr[i] != other.ptr[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn main() -> i32 {
    let a: [i32; 6] = [1, 2, 3, 4, 5, 6];

    let s1 = a[1..4];
    if s1.len != 3 { return 1; }
    if sum(s1) != 9 { return 2; }

    let s2 = a[1..=3];
    if s2.len != 3 { return 3; }
    if s2[2] != 4 { return 4; }

    let s3 = a[4..];
    if s3.len != 2 { return 5; }
    if s3[0] != 5 { return 6; }

    let s4 = a[..2];
    if s4.len != 2 { return 7; }
    if s4[1] != 2 { return 8; }

    let s5 = a[..];
    if s5.len != 6 { return 9; }

    // 运行期边界
    let lo = 2;
    let hi = 5;
    let s6 = a[lo..hi];
    if s6.len != 3 { return 10; }
    if sum(s6) != 12 { return 11; }

    // 切片套切片
    let s7 = s1[1..];
    if s7.len != 2 { return 12; }
    if s7[0] != 3 { return 13; }

    // 切片作为参数 / 返回值
    if sum(head(a, 2)) != 3 { return 14; }

    // str 切片
    let text = "hello.zr";
    let name = text[..5];
    if name.len != 5 { return 15; }
    if name.ptr[0] != 104 { return 16; }

    let ext = text[6..];
    if ext.len != 2 { return 17; }
    if ext.ptr[0] != 122 { return 18; }

    if !eq(tail_str(text, 6), "zr") { return 19; }

    // 路径模块现在直接用切片取子串
    if !eq(substr(text, 0, 5), "hello") { return 20; }
    if !eq(basename("/a/b/c.txt"), "c.txt") { return 21; }
    if !eq(extname("/a/b/c.txt"), "txt") { return 22; }
    if !has_extension("c.txt", "txt") { return 23; }

    // 可变切片 / 只读切片
    let mut m: [i32; 3] = [7, 8, 9];
    zero(m);
    if m[1] != 0 { return 26; }
    let cs: []const i32 = m;
    if cs.len != 3 { return 27; }
    if sum(m[1..]) != 0 { return 28; }

    // 空切片
    let empty = a[2..2];
    if empty.len != 0 { return 24; }
    let empty_s = text[3..3];
    if empty_s.len != 0 { return 25; }

    return 0;
}
