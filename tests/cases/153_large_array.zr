// tests/cases/153_large_array.zr — 大数组 `[v; N]`（N > 16）的正确性
//
// 回归钉住 `copy_array_into` 的运行期循环路径：早先对任意 N 都把数组拷贝
// 展开成 N 条 MIR load-store 指令，[0; 65536] 编译要 2:44。现在 N > 16
// 时生成 `for i in 0..N { dst[i] = src[i]; }` 循环，编译时间与 N 无关。
// 这里覆盖 >16 的零填充与非零填充，验证元素值与边界。

fn main() -> i32 {
    // 零填充：[0u8; 1000] 每个字节都必须是 0。
    let zeros: [u8; 1000] = [0; 1000];
    let mut i: usize = 0;
    while i < 1000 {
        if zeros[i] != 0 { return 1; }
        i = i + 1;
    }

    // 非零填充：[42i32; 100] 每个元素都必须是 42。
    let vals: [i32; 100] = [42; 100];
    let mut j: usize = 0;
    while j < 100 {
        if vals[j] != 42 { return 2; }
        j = j + 1;
    }

    // 跨过 16 阈值的小数组（恰好 17），确认循环路径边界正确。
    let edge: [u8; 17] = [9; 17];
    let mut k: usize = 0;
    while k < 17 {
        if edge[k] != 9 { return 3; }
        k = k + 1;
    }

    // 赋值语义：大数组按值复制，修改副本不影响原件。
    let orig: [i32; 50] = [7; 50];
    let mut copy: [i32; 50] = orig;
    copy[0] = 999;
    if orig[0] != 7 { return 4; }
    if copy[0] != 999 { return 5; }

    return 0;
}
