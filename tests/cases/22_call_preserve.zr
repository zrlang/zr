//=============================================================================
// tests/cases/22_call_preserve.zr — 跨调用存活的值必须被保住
//
// 调用会破坏 caller-save 寄存器。调用期间仍然存活的值必须落在 callee-save
// 寄存器（或栈槽）里，否则被调用方覆盖后，调用之后读到的就是脏数据。
//
// 这里让 p、q 在调用前后都活着，被调函数又用满一批参数/临时寄存器。
// 参数控制在 6 个以内：x86-64 SysV 只有 6 个整数寄存器实参槽，第 7 个起
// 走栈上传参，那个路径尚未实现。
//=============================================================================

fn heavy(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32) -> i32 {
    let s1 = a + b;
    let s2 = c + d;
    let s3 = e + f;
    return s1 + s2 + s3;
}

fn main() -> i32 {
    let p: i32 = 1000;
    let q: i32 = 2000;

    let r: i32 = heavy(1, 2, 3, 4, 5, 6); // (1+2)+(3+4)+(5+6) = 21

    // 调用之后 p、q 必须还是原值。
    if p != 1000 { return 1; }
    if q != 2000 { return 2; }
    if r != 21 { return 3; }

    // 调用结果又被后续调用使用，反复考验跨调用存活。
    let r2: i32 = heavy(p, q, 3, 4, 5, 6); // 3000+7+11 = 3018
    let r3: i32 = heavy(1, 1, 1, 1, 1, 1); // 2+2+2 = 6
    if r2 + r3 != 3024 { return 4; }

    return 0;
}
