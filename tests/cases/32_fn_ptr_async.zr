//=============================================================================
// tests/cases/32_fn_ptr_async.zr — 异步状态机中的函数指针调用
//=============================================================================

fn add(a: i32, b: i32) -> i32 { a + b }

fn apply(f: fn(i32, i32) -> i32, a: i32, b: i32) -> i32 {
    f(a, b)
}

async fn work(f: fn(i32, i32) -> i32) -> i32 {
    f(20, 21)
}

async fn main() -> i32 {
    let r = work(add).await;
    if r != 41 { return 1; }

    let g: fn(i32, i32) -> i32 = add;
    let s = apply(g, 40, 2);
    if s != 42 { return 2; }

    return 0;
}
