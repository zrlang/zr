//=============================================================================
// tests/cases/75_use_alias.zr — `use a as b` 重命名
//
// 重命名此前**只在单段路径上生效**：`use make as mkr` 能过，但多段路径
// `use core::Option as Opt` 被静默忽略——既不登记别名、也不报错，使用点
// 只剩一句无头无尾的 `cannot find value `Opt` in this scope`（P0 级静默失败）。
//
// 两个环节都要修，缺一不可：
//
// * `modules::use_tree_root` 早先对 `Rename(..)` 一律返回 `None`，于是带
//   `as` 的导入**一个模块都不加载**，别名目标从未进入符号表。
// * `typeck::resolve_use_tree` 只匹配 `Rename(Name(..), ..)`，而多段路径被
//   解析成 `Rename(Group([..]), ..)`，于是别名即使模块加载了也没被登记。
//
// 第二个环节尤其隐蔽：同一文件里只要还有另一条不带 `as` 的 `use io::...`，
// 模块就会被那条顺带拉进来，问题随即消失。本用例只留**带 `as` 的导入**，
// 任何一环坏了它都会红。
//
// 刻意不引入 `io` 的格式化调用：`std/io.zr::print_fmt` 里对 `align_of` 的调用
// 被降级成无 `z_` 前缀的外部引用（`U _align_of`），链接必然失败——那是另一条
// 独立在途的问题，与本用例无关。
//=============================================================================

// 多段路径重命名（标准库）：叶子才是名字，模块段只起限定作用。
use core::Option as Opt;

// 单段路径重命名（本地函数）：基线本来就好，不能被多段修复弄坏。
fn make() -> i32 {
    return 42;
}
use make as mkr;

fn main() -> i32 {
    // 值位置：函数别名可调用，返回类型不变。
    if mkr() != 42 {
        return 1;
    }

    // 类型位置：别名能标注变量、能带泛型实参、能取关联函数。
    let o: Opt<i32> = Opt::None;
    if o.is_some() {
        return 2;
    }
    let s: Opt<i32> = Opt::Some(3);
    if !s.is_some() {
        return 3;
    }
    return 0;
}
