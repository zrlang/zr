//=============================================================================
// tests/cases/03_precedence.zr — 对应《Rust 程序设计语言》「运算符」
//
// 覆盖：运算优先级、括号、一元负号、整数宽度。
//=============================================================================

fn main() -> i32 {
    if 2 + 3 * 4 != 14 {
        return 1;
    }
    if (2 + 3) * 4 != 20 {
        return 2;
    }
    if 10 - 2 - 3 != 5 {
        return 3;
    }
    if 100 / 10 / 2 != 5 {
        return 4;
    }
    return 0;
}
