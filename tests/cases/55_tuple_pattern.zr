//=============================================================================
// tests/cases/55_tuple_pattern.zr — 元组：字面量、字段访问与模式
//
// 元组值在运行期是"指向元素存储的地址"，与结构体同一套布局：字段按序排、
// 各自对齐，末尾补齐到最大对齐。`t.0` / `t.1` 按下标访问，模式
// `(a, b)` 逐元素拆解——匹配条件是各元素条件之合，绑定取的是对应元素。
//
// 覆盖：
//   - 元组字面量与字段访问
//   - 元组模式：全匹配 / 带绑定 / 不匹配
//   - 不可反驳的元组模式（`(_, _)`）也能兜底
//   - `if let` 里的元组模式
//   - 元组作为实参与返回值
//=============================================================================

fn swap(t: (i32, i32)) -> (i32, i32) {
    return (t.1, t.0);
}

fn main() -> i32 {
    // --- 字面量与字段访问 ---
    let t = (1, 2);
    if t.0 != 1 { return 1; }
    if t.1 != 2 { return 2; }

    // --- 元组模式：带绑定 ---
    match t {
        (1, v) => {
            if v != 2 { return 3; }
        }
        _ => { return 4; }
    }

    // --- 元组模式：不匹配时落到下一条臂 ---
    let u = (3, 4);
    match u {
        (1, _) => { return 5; }
        (3, v) => {
            if v != 4 { return 6; }
        }
        _ => { return 7; }
    }

    // --- 不可反驳的元组模式也能兜底 ---
    let w = (5, 6);
    match w {
        (5, v) => {
            if v != 6 { return 8; }
        }
        (_, _) => { return 9; }
    }

    // --- if let 里的元组模式 ---
    let x = (7, 8);
    if let (7, v) = x {
        if v != 8 { return 10; }
    } else {
        return 11;
    }

    // --- 元组作为实参与返回值 ---
    let s = swap((12, 13));
    if s.0 != 13 { return 12; }
    if s.1 != 12 { return 13; }

    return 0;
}
