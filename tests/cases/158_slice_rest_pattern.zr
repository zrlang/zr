// 切片模式 `[a, .., b]` 的 `..` 剩余模式（Rust 风格）。
//
// 语义：`..` 可以匹配 **0 个或多个**中间元素，两侧元素按下标约束。
//
//   - 无 `..`（`[a, b, c]`）：精确长度匹配，所有下标正序（旧语义）。
//   - 有 `..`：长度条件从 `len == n` 改为 `len >= n`（`..` 至少跳过 0 个）。
//     尾部元素下标从尾部倒序取：`[first, .., last]` 在长度 5 数组上，
//     `first` 取 `arr[0]`、`last` 取 `arr[4]`；在长度 2 数组上，`..`
//     跳过 0 个，等价于 `[first, last]`。
//   - 只能一个 `..`（`[.., ..]` / `[a, .., .., b]` parser 阶段报错）。

fn main() -> i32 {
    let a = [1, 2, 3, 4, 5];

    // --- let 位置 ---

    // 中间 `..`
    let [first, .., last] = a;
    if first != 1 { return 1; }
    if last != 5 { return 2; }

    // 尾部 `..`：取前几个
    let [x, y, ..] = a;
    if x != 1 { return 3; }
    if y != 2 { return 4; }

    // 头部 `..`：取后几个
    let [.., p, q] = a;
    if p != 4 { return 5; }
    if q != 5 { return 6; }

    // 跳过 0 个元素：`..` 可以匹配空序列
    let [m, .., n] = [10, 20];
    if m != 10 { return 7; }
    if n != 20 { return 8; }

    // 多头部 + 单尾部 + 中间 `..`
    let [a1, a2, a3, .., b1] = [100, 200, 300, 400, 500];
    if a1 != 100 { return 9; }
    if a2 != 200 { return 10; }
    if a3 != 300 { return 11; }
    if b1 != 500 { return 12; }

    // 多尾部
    let [.., x1, x2, x3] = [7, 8, 9, 10];
    if x1 != 8 { return 13; }
    if x2 != 9 { return 14; }
    if x3 != 10 { return 15; }

    // --- match 位置（同一条 pat_match 路径） ---
    let arr = [10, 20, 30, 40, 50];

    let r = match arr {
        [10, .., 50] => 1,
        [.., 99] => 2,
        _ => 3,
    };
    if r != 1 { return 16; }

    let r2 = match arr {
        [10, .., 99] => 1,
        [.., 50] => 2,
        _ => 3,
    };
    if r2 != 2 { return 17; }

    // match 臂条件：尾部 pattern 必须是数组尾部的精确值
    let r3 = match arr {
        [10, .., 40] => 1,
        [10, .., 50] => 2,
        _ => 3,
    };
    if r3 != 2 { return 18; }

    // 无 `..` 的旧形态仍然 OK
    let [b1, b2, b3, b4, b5] = a;
    if b1 != 1 || b2 != 2 || b3 != 3 || b4 != 4 || b5 != 5 { return 19; }

    return 0;
}
