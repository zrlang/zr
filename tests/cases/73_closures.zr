//=============================================================================
// tests/cases/73_closures.zr — 闭包（单态化内联）
//
// 覆盖：无捕获闭包、单捕获闭包、多参数闭包、闭包立即调用。
//
// 第一版闭包走"定义处立即调用"的单态化内联：闭包体在调用点展开，形参
// 绑定到新局部、捕获变量复用外层 local。`main` 返回 0 表示全部通过。
//=============================================================================

fn main() -> i32 {
    // --- 无捕获、单参数 ---
    let r: i32 = (|x: i32| x + 1)(41);
    if r != 42 {
        return 1;
    }

    // --- 捕获外层局部（不可变）---
    let n: i32 = 40;
    let s: i32 = (|x: i32| x + n)(2);
    if s != 42 {
        return 2;
    }

    // --- 多参数、不捕获 ---
    let m: i32 = (|a: i32, b: i32| a * b + 2)(5, 8);
    if m != 42 {
        return 3;
    }

    // --- 捕获 + 多参数 ---
    let base: i32 = 10;
    let t: i32 = (|a: i32, b: i32| a * b + base + base + base + base + 2)(4, 0);
    // 4*0 + 10*4 + 2 = 42
    if t != 42 {
        return 4;
    }

    // --- 闭包体含多条语句：中间量绑定 + 尾表达式取值（20*2 + 2 = 42）---
    // 语句里的 `let y = x * 2` 必须把形参引用换到实参上，否则内联后 x 悬空。
    let u: i32 = (|x: i32| {
        let y: i32 = x * 2;
        let z: i32 = y + 2;
        z
    })(20);
    if u != 42 {
        return 5;
    }

    return 0;
}
