//=============================================================================
// tests/cases/19_float.zr — f64 浮点运算
//
// 覆盖：算术、比较（含 NaN 与负数的序）、取负、int<->f64 转换、跨函数的
// 浮点实参/返回值、循环里的浮点累加（走 φ + 回边）。
//
// 为什么每条断言都乘以 10 或 100 再比较：
// 退出码只有 8 位，而浮点的精确相等很难直接表达。把期望值放大到整数，
// 就能用 `!=` 做确定性判断，同时避开 0.1+0.2 这类二进制表示误差
// （本文件只用 2 的幂次分母的值，放大后都是精确整数）。
//
// f32 见 20_f32.zr：浮点常量现在携带位宽，后端能按 f32 指令编码。
//=============================================================================

fn addf(a: f64, b: f64) -> f64 {
    return a + b;
}

fn hyp2(x: f64, y: f64) -> f64 {
    return x * x + y * y;
}

fn main() -> i32 {
    // --- 基本算术 ---
    let a: f64 = 3.5;
    let b: f64 = 1.25;
    if (a + b) * 100.0 != 475.0 { return 1; }
    if (a - b) * 100.0 != 225.0 { return 2; }
    if (a * b) * 1000.0 != 4375.0 { return 3; }
    if (a / b) * 10.0 != 28.0 { return 4; }

    // --- 循环里的浮点累加：走的是 φ + 回边 ---
    let mut acc: f64 = 0.0;
    let mut i: f64 = 1.0;
    while i <= 4.0 {
        acc = acc + i;
        i = i + 1.0;
    }
    if acc * 100.0 != 1000.0 { return 5; } // 1+2+3+4 = 10

    // --- 跨函数的浮点实参与返回值（走 xmm 寄存器） ---
    let s = addf(2.5, 3.25);
    if s * 100.0 != 575.0 { return 6; }
    let h = hyp2(3.0, 4.0);
    if h * 100.0 != 2500.0 { return 7; } // 9 + 16 = 25

    // --- 整数 <-> 浮点 双向转换 ---
    let n: i32 = -3;
    let nf = n as f64;
    if nf * 10.0 != -30.0 { return 8; }
    let back = (nf * 1.0) as i32;
    if back != -3 { return 9; }

    // 无符号也走同一条 cvtsi2sd 路径
    let big: u32 = 4000000;
    if (big as f64) * 1.0 != 4000000.0 { return 10; }

    // --- 浮点比较：负数按数值序，不是位模式序 ---
    let neg: f64 = -1.0;
    let pos: f64 = 1.0;
    if !(neg < pos) { return 11; }
    if neg > pos { return 12; }
    if !(neg <= -1.0) { return 13; }
    if neg != -1.0 { return 14; }
    if neg == pos { return 15; }

    // --- 浮点取负 ---
    let p: f64 = 3.0;
    if (-p) * 10.0 != -30.0 { return 16; }
    if (-(-p)) * 10.0 != 30.0 { return 17; }

    // --- NaN 语义（IEEE754）---
    // NaN 参与的比较里只有 != 为真，其余全为假。
    // 这一条曾在优化等级切换时静默出错：`ucomisd` 在 NaN 上会把 ZF 和 PF
    // 一起置 1，只用 `sete` 判相等会把 `NaN == NaN` 判成真。
    let zero: f64 = 0.0;
    let nan = zero / zero;
    if nan == nan { return 18; }
    if !(nan != nan) { return 19; }
    if nan < 1.0 { return 20; }
    if nan > 1.0 { return 21; }
    if nan <= 1.0 { return 22; }
    if nan >= 1.0 { return 23; }

    return 0;
}
