//=============================================================================
// tests/cases/45_for_array.zr — `for x in array` 数组遍历
//
// 覆盖：标量/结构体/Drop 数组、continue/break、嵌套遍历，以及源表达式
// 只求值一次。
//=============================================================================

struct P { v: i32 }
impl Drop for P { fn drop(&mut self) { } }
fn make(calls: *mut i32) -> [i32; 2] {
    *calls = *calls + 1;
    return [4, 5];
}
fn main() -> i32 {
    let a = [1, 2, 3, 4];
    let mut sum = 0;
    for x in a { sum = sum + x; }
    if sum != 10 { return 1; }

    sum = 0;
    for x in [10, 20, 30] {
        if x == 20 { continue; }
        sum = sum + x;
    }
    if sum != 40 { return 2; }

    let mut n = 0;
    for x in [1, 2, 3] {
        if x == 2 { break; }
        n = n + 1;
    }
    if n != 1 { return 3; }

    sum = 0;
    for x in [1, 2] {
        for y in [10, 20] {
            sum = sum + x * y;
        }
    }
    if sum != 90 { return 4; }

    let mut calls = 0;
    sum = 0;
    for x in make(&mut calls) { sum = sum + x; }
    if calls != 1 || sum != 9 { return 5; }

    let ps = [P { v: 1 }, P { v: 2 }, P { v: 3 }];
    sum = 0;
    for p in ps { sum = sum + p.v; }
    if sum != 6 { return 6; }

    sum = 0;
    for p in [P { v: 7 }, P { v: 8 }] {
        if p.v == 7 { sum = sum + p.v; }
    }
    if sum != 7 { return 7; }

    return 0;
}
