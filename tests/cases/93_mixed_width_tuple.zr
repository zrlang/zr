//=============================================================================
// tests/cases/93_mixed_width_tuple.zr — 混合宽度元组的字段访问
//
// 早先元组字面量 `(1, 5)` 里的元素用**独立推断变量**检查，于是整数字面量各自
// 落成默认的 `i32`。存进 `(i32, i64)` 槽时只写低 4 字节，`t.1` 读到
// "值 | 高位垃圾"——静默产出错误结果。`55_tuple_pattern` 只覆盖了同宽元组
// `(i32, i32)`（无填充、无截断），所以没被测出。
//
// 覆盖：
//   - `(i32, i64)`：首元素 i32、次元素 i64（跨对齐）
//   - `(i64, i32)`：首元素 i64（大对齐）、次元素 i32
//   - `(i32, i32)`：同宽（回归）
//   - 元组作为结构体字段、按值传参两种位置
//=============================================================================

struct B { t: (i32, i64) }
struct C { t: (i64, i32) }

fn read_second(t: (i32, i64)) -> i64 {
    return t.1;
}

fn main() -> i32 {
    // --- (i32, i64)：首元素 i32、次元素 i64（跨对齐，之前 t.1 读垃圾） ---
    let t: (i32, i64) = (1, 5);
    if t.0 != 1 { return 1; }
    if t.1 != 5 { return 2; }

    // --- (i64, i32)：首元素 i64（之前连 t.0 都读错） ---
    let u: (i64, i32) = (7, 9);
    if u.0 != 7 { return 3; }
    if u.1 != 9 { return 4; }

    // --- (i32, i32)：同宽（回归，之前本来就对） ---
    let v: (i32, i32) = (11, 13);
    if v.0 != 11 { return 5; }
    if v.1 != 13 { return 6; }

    // --- 结构体字段位置 ---
    let b = B { t: (21, 25) };
    if b.t.0 != 21 { return 7; }
    if b.t.1 != 25 { return 8; }
    let c = C { t: (31, 33) };
    if c.t.0 != 31 { return 9; }
    if c.t.1 != 33 { return 10; }

    // --- 按值传参位置 ---
    if read_second((41, 45)) != 45 { return 11; }

    return 0;
}
