//=============================================================================
// tests/cases/02_scalars.zr — 对应《Rust 程序设计语言》「数据类型」
//
// 覆盖：整数标量与算术运算（+ - * / %）。
//=============================================================================

/// 乘法（无分支的纯函数）。
fn mul(a: i32, b: i32) -> i32 {
    return a * b;
}

fn main() -> i32 {
    if 20 + 22 != 42 {
        return 1;
    }
    if 50 - 8 != 42 {
        return 2;
    }
    if mul(6, 7) != 42 {
        return 3;
    }
    if 84 / 2 != 42 {
        return 4;
    }
    if 44 % 5 != 4 {
        return 5;
    }
    if 40 / 4 / 5 != 2 {
        return 6;
    }

    // --- 有符号运算：负数会走到和正数完全不同的指令路径 ---
    // 除法必须先做符号扩展（cqo）；`xor edx, edx` 只在被除数非负时等价。
    let neg: i32 = -42;
    let two: i32 = 2;
    if neg / two != -21 {
        return 5;
    }
    if -43 % 5 != -3 {
        return 6;
    }
    // 右移是算术右移（补符号位），不是逻辑右移。
    let minus8: i32 = -8;
    if minus8 >> 2 != -2 {
        return 7;
    }
    if minus8 >> 1 != -4 {
        return 8;
    }
    // 正数右移不受影响
    if 8 >> 2 != 2 {
        return 9;
    }

    return 0;
}
