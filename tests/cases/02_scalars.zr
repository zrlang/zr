//=============================================================================
// tests/cases/02_scalars.zr — 对应《Rust 程序设计语言》「数据类型」
//
// 覆盖：整数标量与算术运算（+ - * / %）。
//=============================================================================

/// 乘法（无分支的纯函数）。
fn mul(a: i32, b: i32) -> i32 {
    return a * b;
}

fn main() -> i32 {
    if 20 + 22 != 42 {
        return 1;
    }
    if 50 - 8 != 42 {
        return 2;
    }
    if mul(6, 7) != 42 {
        return 3;
    }
    if 84 / 2 != 42 {
        return 4;
    }
    if 44 % 5 != 4 {
        return 5;
    }
    if 40 / 4 / 5 != 2 {
        return 6;
    }
    return 0;
}
