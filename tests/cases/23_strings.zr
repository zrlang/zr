//=============================================================================
// tests/cases/23_strings.zr — 字符串字面量落到 .rodata 并可按地址比较
//
// 字符串字面量去重后放进 .rodata（NUL 结尾）。取字面量即取其地址，因此内容
// 相同的字面量指向同一地址，`==` / `!=` 可以直接观察到这一点。这里还让 `str`
// 作为实参跨函数传递，覆盖寄存器传参与重定位回填两条路径。
//=============================================================================

fn same(a: str, b: str) -> bool {
    return a == b;
}

fn main() -> i32 {
    let a = "hello";
    let b = "hello";
    let c = "world";

    // 同内容共享同一 .rodata 槽：指针对应相等。
    if a != b { return 1; }
    // 不同内容落在不同的槽。
    if a == c { return 2; }

    // 作为实参跨调用传递后仍能正确比较（调用方/被调方两侧都有重定位）。
    if !same(a, b) { return 3; }
    if same(a, c) { return 4; }

    // 更长、含空格与逗号的字面量也走同一路径。
    let p = "hello, world";
    let q = "hello, world";
    if p != q { return 5; }
    if !same(p, q) { return 6; }

    return 0;
}
