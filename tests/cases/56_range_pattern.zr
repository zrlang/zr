//=============================================================================
// tests/cases/56_range_pattern.zr — 范围模式
//
// 范围模式 `a..=b`（两端都含）与 `a..b`（上端不含）的匹配条件是
// `a <= x && x <= b` / `a <= x && x < b`。范围两端的类型跟被匹配的值
// 一致（字面量也因此拿到正确的类型，而不是各自推断成默认的 i32 / f64）。
//
// 覆盖：
//   - 闭区间 / 开区间的边界
//   - 区间不匹配时落到下一条臂
//   - `if let` 里的范围模式
//   - char 的范围
//=============================================================================

fn classify(n: i32) -> i32 {
    match n {
        0 => { return 0; }
        1..=10 => { return 1; }
        11..20 => { return 2; }
        _ => { return 3; }
    }
}

fn main() -> i32 {
    // --- 闭区间 / 开区间的边界 ---
    if classify(0) != 0 { return 1; }
    if classify(1) != 1 { return 2; }
    if classify(10) != 1 { return 3; }
    if classify(11) != 2 { return 4; }
    if classify(19) != 2 { return 5; }
    if classify(20) != 3 { return 6; }

    // --- if let 里的范围模式 ---
    let n = 5;
    if let 1..=10 = n {
        return 0;
    }
    return 7;

    // --- 或模式 + 范围 ---
    let m = 8;
    match m {
        1..=3 | 20 => { return 9; }
        7..=9 | 30 => { return 0; }
        _ => { return 10; }
    }

    // --- char 的范围 ---
    let c = 'm';
    match c {
        'a'..'z' => { return 0; }
        _ => { return 8; }
    }
}
