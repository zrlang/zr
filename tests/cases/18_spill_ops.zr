//=============================================================================
// tests/cases/18_spill_ops.zr — 溢出值的运算
//
// 可分配寄存器只有 10 个 GPR（`rax`/`rcx`/`rdx` 保留给除法、移位与
// `setcc`）。活跃值一多就必须溢出到栈帧，而**溢出值的每一次读取都要重新
// 装载**——这里面的寄存器选择稍有偏差就会静默算错。
//
// 覆盖：溢出值作为加减乘除的左右操作数、比较对象、移位计数，以及除法里
// 最容易出错的组合（被除数与除数都溢出）。
//=============================================================================

fn main() -> i32 {
    // 24 个同时存活的值把 10 个寄存器占满，后面每个操作数都得从栈帧装载。
    let a0: i32 = 1;   let a1: i32 = 2;   let a2: i32 = 3;   let a3: i32 = 4;
    let a4: i32 = 5;   let a5: i32 = 6;   let a6: i32 = 7;   let a7: i32 = 8;
    let a8: i32 = 9;   let a9: i32 = 10;  let b0: i32 = 11;  let b1: i32 = 12;
    let b2: i32 = 13;  let b3: i32 = 14;  let b4: i32 = 15;  let b5: i32 = 16;
    let b6: i32 = 17;  let b7: i32 = 18;  let b8: i32 = 19;  let b9: i32 = 20;
    let c0: i32 = 21;  let c1: i32 = 22;  let c2: i32 = 23;  let c3: i32 = 24;

    // --- 加减乘：右操作数溢出 ---
    let s1: i32 = a0 + c3;          // 25
    if s1 != 25 { return 1; }
    let s2: i32 = c3 - a0;          // 23
    if s2 != 23 { return 2; }
    let s3: i32 = c3 * a1;          // 48
    if s3 != 48 { return 3; }

    // --- 左操作数溢出 ---
    let s4: i32 = b9 - a9;          // 10
    if s4 != 10 { return 4; }
    let s5: i32 = b9 + c0;          // 41
    if s5 != 41 { return 5; }

    // --- 除法：除数溢出时走 `idiv [rsp+disp32]` 内存操作数 ---
    let d1: i32 = c3 / b1;          // 24 / 12 = 2
    if d1 != 2 { return 6; }
    // 被除数与除数**都**溢出：rax 装被除数，rdx 由 cqo 写
    let d2: i32 = b9 / a5;          // 20 / 6 = 3
    if d2 != 3 { return 7; }
    let d3: i32 = b9 / b9;          // 20 / 20 = 1
    if d3 != 1 { return 8; }

    // --- 取模：结果在 rdx ---
    let r1: i32 = c3 % b1;          // 24 % 12 = 0
    if r1 != 0 { return 9; }
    let r2: i32 = b9 % a5;          // 20 % 6 = 2
    if r2 != 2 { return 10; }
    let r3: i32 = c3 % b2;          // 24 % 13 = 11
    if r3 != 11 { return 11; }

    // --- 移位：计数固定走 cl ---
    let h1: i32 = a0 << b0;         // 1 << 11 = 2048
    if h1 != 2048 { return 12; }
    let h2: i32 = b9 >> a1;         // 20 >> 2 = 5
    if h2 != 5 { return 13; }

    // --- 位运算 ---
    let t1: i32 = b0 & b1;          // 11 & 12 = 8
    if t1 != 8 { return 14; }
    let t2: i32 = b0 | b1;          // 11 | 12 = 15
    if t2 != 15 { return 15; }
    let t3: i32 = b0 ^ b1;          // 11 ^ 12 = 7
    if t3 != 7 { return 16; }

    // --- 比较：两个操作数都溢出 ---
    if !(a0 < c3) { return 17; }
    if !(c3 > a0) { return 18; }
    if a0 == c3 { return 19; }
    if !(a0 != c3) { return 20; }
    if !(a0 <= a0) { return 21; }
    if !(c3 >= c3) { return 22; }

    // --- 混合：运算结果再次溢出，与新溢出值继续运算 ---
    let x1: i32 = (a0 + b0) * (c1 - b9);   // 12 * 2 = 24
    if x1 != 24 { return 23; }
    let x2: i32 = x1 / a2 + x1 % a3;       // 24/3 + 24%4 = 8 + 0
    if x2 != 8 { return 24; }

    // --- 一元运算作用在溢出值上 ---
    let n1: i32 = -c3;                     // -24
    if n1 != -24 { return 25; }
    let n2: i32 = ~a0;                     // -2
    if n2 != -2 { return 26; }
    let n3: i32 = !a0;                     // false -> 0
    if n3 != 0 { return 27; }

    // --- 溢出值作为返回值 ---
    let last: i32 = c3;
    if last != 24 { return 28; }

    return 0;
}