//=============================================================================
// tests/cases/05_logic.zr — 对应《Rust 程序设计语言》「运算符」
//
// 覆盖：布尔字面量与逻辑运算 ! ||。
//=============================================================================

fn main() -> i32 {
    if !true {
        return 1;
    }
    if !(false || false) {
        return 2;
    }
    return 0;
}
