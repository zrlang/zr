//=============================================================================
// tests/cases/07_control_flow.zr — 对应《Rust 程序设计语言》「控制流」
//
// 覆盖：`if` / `else` 作为语句、else if 链、以及分支中的提前 `return`。
//=============================================================================

/// 依据阈值返回不同结果（在被调函数里使用 if + 早返回）。
fn classify(n: i32) -> i32 {
    if n > 100 {
        return 2;
    }
    if n > 10 {
        return 1;
    }
    return 0;
}

fn main() -> i32 {
    let n: i32 = 42;

    // 基本 if
    if n > 3 {
        return 0;
    }
    return 1;
}
