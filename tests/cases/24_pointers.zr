//=============================================================================
// tests/cases/24_pointers.zr — 指针解引用 / 索引 与 字符串按字节索引
//
// 覆盖新的"内存模型"最小集：
//   - 字符串字面量按字节索引 `s[i]`（元素类型 u8，缩放 1）；
//   - 取局部变量地址 `&x`（只读）/ `&mut x`（可写）、解引用读写 `*p` / `*p = v`；
//   - 指针索引 `p[i]` / `p[i] = v`（按元素字节大小缩放）；
//   - 指针算术 `p + n` / `n + p`（按元素大小缩放）、`p - q`（元素个数）；
//   - 被取地址的局部变量改走栈槽（与 φ / 循环交互）；
//   - 有符号字节加载的符号扩展（i8 -1 读回来仍是 -1）；
//   - 写入必须经过可变指针：`*const` / `&x` 写入在类型检查直接拒绝。
//=============================================================================

fn byte_at(s: str, i: i64) -> u8 {
    return s[i];
}

fn main() -> i32 {
    // 1. 字符串按字节索引：'A' 'B' 'C' == 65 66 67。
    let s = "ABC";
    if s[0] != 65 { return 1; }
    if s[1] != 66 { return 2; }
    if s[2] != 67 { return 3; }
    if byte_at(s, 1) != 66 { return 4; }

    // 2. 取地址 + 解引用读（`&x` 是只读指针，只许读）。
    let mut x: i32 = 7;
    let p: *i32 = &x;
    if *p != 7 { return 5; }

    // 3. 通过**可变**指针写回，从原变量读到；再读指针。
    //    写入必须走 `&mut` + `*mut`：`&x`（`*const`）只读，`*p = v` 会报编译错误。
    let pm: *mut i32 = &mut x;
    if *pm != 7 { return 5; }
    *pm = 42;
    if x != 42 { return 6; }
    if *pm != 42 { return 7; }

    // 4. 指针索引写 / 读。
    pm[0] = 99;
    if x != 99 { return 8; }
    if pm[0] != 99 { return 9; }

    // 5. 循环里通过可变指针累加：0+1+2+3+4 = 10。
    let mut acc: i32 = 0;
    let q: *mut i32 = &mut acc;
    let mut i: i32 = 0;
    while i < 5 {
        *q = *q + i;
        i = i + 1;
    }
    if acc != 10 { return 10; }

    // 6. 循环里对字符串字节求和：A+B+C = 198。
    //    顺带覆盖：对只读指针 `s[k]` 只读不写。
    let mut k: i32 = 0;
    let mut sum: i32 = 0;
    while k < 3 {
        sum = sum + s[k] as i32;
        k = k + 1;
    }
    if sum != 198 { return 11; }

    // 7. i8 指针：有符号字节加载要符号扩展（-1 读回来仍是 -1）。只读即可。
    let b: i8 = -1;
    let pb: *i8 = &b;
    let w: i32 = *pb as i32;
    if w != -1 { return 12; }

    // 8. 指针算术：`p + n` / `n + p` 按元素字节大小缩放（i32 → 4 字节）。
    let pa: *i32 = &x;
    let pc: *i32 = pa + 3;
    if (pc as i64) - (pa as i64) != 12 { return 13; }
    if ((2 + pa) as i64) - (pa as i64) != 8 { return 14; }

    // 9. 指针相减：结果是元素个数（isize / i64），不是字节差。
    if (pa - pc) != 0 - 3 { return 15; }
    if (pc - pa) != 3 { return 16; }

    // 10. 指针宽度为 1 的算术不缩放。
    let byte: i8 = 1;
    let pbyte: *i8 = &byte;
    if ((pbyte + 5) as i64) - (pbyte as i64) != 5 { return 17; }

    return 0;
}
