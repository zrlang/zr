//=============================================================================
// tests/cases/24_pointers.zr — 指针解引用 / 索引 与 字符串按字节索引
//
// 覆盖新的"内存模型"最小集：
//   - 字符串字面量按字节索引 `s[i]`（元素类型 u8，缩放 1）；
//   - 取局部变量地址 `&x`、解引用读写 `*p` / `*p = v`；
//   - 指针索引 `p[i]` / `p[i] = v`（按元素字节大小缩放）；
//   - 被取地址的局部变量改走栈槽后，与 φ / 循环仍能正确交互；
//   - 有符号字节加载的符号扩展（i8 -1 读回来仍是 -1）。
//=============================================================================

fn byte_at(s: str, i: i64) -> u8 {
    return s[i];
}

fn main() -> i32 {
    // 1. 字符串按字节索引：'A' 'B' 'C' == 65 66 67。
    let s = "ABC";
    if s[0] != 65 { return 1; }
    if s[1] != 66 { return 2; }
    if s[2] != 67 { return 3; }
    if byte_at(s, 1) != 66 { return 4; }

    // 2. 取地址 + 解引用读。
    let x: i32 = 7;
    let p: *i32 = &x;
    if *p != 7 { return 5; }

    // 3. 通过指针写回，从原变量读到；再读指针。
    *p = 42;
    if x != 42 { return 6; }
    if *p != 42 { return 7; }

    // 4. 指针索引写 / 读。
    p[0] = 99;
    if x != 99 { return 8; }
    if p[0] != 99 { return 9; }

    // 5. 循环里通过指针累加：0+1+2+3+4 = 10。
    let acc: i32 = 0;
    let q: *i32 = &acc;
    let i: i32 = 0;
    while i < 5 {
        *q = *q + i;
        i = i + 1;
    }
    if acc != 10 { return 10; }

    // 6. 循环里对字符串字节求和：A+B+C = 198。
    let k: i32 = 0;
    let sum: i32 = 0;
    while k < 3 {
        sum = sum + s[k] as i32;
        k = k + 1;
    }
    if sum != 198 { return 11; }

    // 7. i8 指针：有符号字节加载要符号扩展（-1 读回来仍是 -1）。
    let b: i8 = -1;
    let pb: *i8 = &b;
    let w: i32 = *pb as i32;
    if w != -1 { return 12; }

    return 0;
}
