//=============================================================================
// tests/cases/111_i128.zr — 128 位整数（i128/u128）在 64 位目标上的基本运算
//
// 机器字长 64 位，宽于它的整数在栈上占**两个连续 8 字节槽**（lo / hi）。
// 加减用 `adc`/`sbb` 接进位，移位用 `shld`/`shrd`，比较按"先比高位、
// 高位相等再比低位"定序，传参/返回走寄存器对（rdx:rax）。
//
// 本用例的关键点是**低 64 位为零**的常量（`2^64`）：若被截断成 64 位就会
// 读成 0，于是任何 128 位的遗漏都会在这里暴露。所有断言都在 `main` 里用
// `return <非零>` 自证数值——`tests/zr_language.rs` 只断言退出码。
//
// 乘 / 除 / 取模在 64 位目标上需要更长的算法（乘要拆四段、除走软件长除），
// 暂不支持（`emit_binary_wide` 里 `Mul | Div | Rem` 直接报错），不放在本
// 正向用例里。
//=============================================================================

/// 两个 i128 相加（覆盖跨 64 位边界的进位传播）。
fn add128(x: i128, y: i128) -> i128 {
    return x + y;
}

/// 两个 i128 相减（覆盖借位传播）。
fn sub128(x: i128, y: i128) -> i128 {
    return x - y;
}

/// i128 取负并返回（覆盖一元运算 + 返回值寄存器对）。
fn neg128(x: i128) -> i128 {
    return -x;
}

fn main() -> i32 {
    // 2^64：低 64 位为 0。若 i128 被截断成 64 位，这里读到的就是 0。
    let a: i128 = 18446744073709551616; // 2^64 = 0x1_0000_0000_0000_0000
    let b: i128 = 1;

    // --- 常量 ---
    if a == 0 { return 1; }

    // --- 加 / 减（进位 / 借位跨 64 位边界）---
    let c = a + b;
    if c != 18446744073709551617 { return 2; }
    let d = a - b;
    if d != 18446744073709551615 { return 3; }
    // 低字两者都满、进位必须把它带上高字
    let lowmax: i128 = 18446744073709551615; // 2^64 - 1
    if lowmax + 1 != a { return 4; }

    // --- 位运算 ---
    let e = a | b;
    if e != 18446744073709551617 { return 5; }
    let f = a & b;
    if f != 0 { return 6; }
    let g = a ^ (a | b);
    if g != b { return 7; }
    let nz: i128 = 0;
    if ~nz != -1 { return 8; }

    // --- 移位 ---
    let sh = b << 64i128; // n >= 64：整字挪
    if sh != a { return 9; }
    let shr = a >> 64i128;
    if shr != 1 { return 10; }
    let shl4 = b << 4i128; // n < 64：shld 补位
    if shl4 != 16 { return 11; }
    let shr4 = a >> 4i128;
    if shr4 != 1152921504606846976 { return 12; } // 2^60
    // 有符号算术右移：负数补 1
    let neg: i128 = -2;
    if neg >> 1i128 != -1 { return 13; }

    // --- 比较（含 2^64 对 1：低位差全 1、高字为零，专门钉 sbb 后 ZF 语义）---
    if a <= b { return 14; }
    if b >= a { return 15; }
    if a == b { return 16; }
    if a != b { } else { return 17; }
    if a < b { return 18; }
    if b > a { return 19; }
    if !(a > b) { return 20; }
    if !(b < a) { return 21; }

    // --- 转换 ---
    let i64v: i64 = 5;
    if (i64v as i128) != 5 { return 22; }
    let ni64: i64 = -1;
    if (ni64 as i128) != -1 { return 23; } // 符号扩展
    let u64v: u64 = 18446744073709551615;
    // u64 as i128 必须**零**扩展：不能按目标的有符号性补符号位
    if (u64v as i128) != 18446744073709551615 { return 24; }
    // i128 -> i64 截断取低字
    if (a as i64) != 0 { return 25; }

    // --- 传参 / 返回（寄存器对 rdx:rax）---
    if add128(a, b) != 18446744073709551617 { return 26; }
    if sub128(a, b) != 18446744073709551615 { return 27; }
    if neg128(a) != -18446744073709551616 { return 28; }
    // 两个 i128 形参必须分别拿到各自的值，不能整体错位
    if add128(b, a) != add128(a, b) { return 29; }

    // --- u128：无符号比较 + 逻辑右移 ---
    let ua: u128 = 18446744073709551616; // 2^64
    let ub: u128 = 1;
    if ua <= ub { return 30; }
    if ub >= ua { return 31; }
    if !(ua > ub) { return 32; }
    let us = ua >> 1u128;
    if us != 9223372036854775808 { return 33; } // 2^63
    let uzero: u128 = 0;
    let uall = ~uzero; // u128 最大值（2^128 - 1）
    // 高位全 1 时逻辑右移应补 0（u128 没有算术右移）
    if (uall >> 64u128) != 18446744073709551615 { return 34; }
    if uall < ua { return 35; } // 无符号：最大值不小于 2^64

    return 0;
}
