// 覆盖：越界检查在**合法下标**下不误报，且各种接收者形态都能正常取值。
//
// 背景：zr 早先切片/数组索引**不做越界检查**（`check_index_scalar` 不检查
// 边界，AGENTS §4），越界会静默读到相邻内存。现在对**编译期已知长度**
// （定长数组 `[T; N]`，或指向定长数组的指针/引用）配**字面量下标**做边界
// 检查——越界的用例在 `tests/negative/` 里（必须编译失败），本文件只钉住
// 「合法下标不被误伤」这一半，因为 `tests/cases/` 下每个用例都必须编译
// 通过并返回 0。
//
// 不在本用例覆盖范围（留待后续接线）：
// - 运行期变量的下标（`let i = ...; arr[i]`）——需要 MIR 层越界检查
//   （AGENTS §8.8 的 `ZR_BOUNDS_CHECK` 开关）。
// - 动态长度切片 `[]T` 与 `str`——长度只有运行期才有，编译期查不了。
// - 指向不定长内存的裸指针 `*const T` / `*mut T`——没有长度信息，
//   `p[k]` 是 unsafe 的原始内存访问，与 C 一致不检查。
fn main() -> i32 {
    // 1. 定长数组：首元素、末元素（合法的边界值）都必须能取到。
    let arr = [1, 2, 3, 4];
    if arr[0] != 1 {
        return 1;
    }
    if arr[3] != 4 {
        return 2;
    }

    // 2. 单元素数组：`[0]` 是唯一合法下标。
    let one = [42];
    if one[0] != 42 {
        return 3;
    }

    // 3. 指向定长数组的裸指针：长度已知，合法下标照常工作。
    //    （用具名数组取址；`&[0,1,2]` 这种数组字面量取址有单独的类型
    //    推断怪癖，与本用例要测的"指针下标不误报"无关。）
    let p = &[0, 1, 2];
    unsafe {
        if p[2] != 2 {
            return 4;
        }
    }

    // 4. 嵌套数组：`[[i32; 2]; 2]` 的外层与内层下标。
    let nested = [[1, 2], [3, 4]];
    if nested[1][0] != 3 {
        return 5;
    }

    // 5. 运行期变量下标：目前不做检查（值本身合法，所以不误报）。
    let i: i32 = 1;
    let v = [10, 20, 30][i];
    if v != 20 {
        return 6;
    }

    return 0;
}
