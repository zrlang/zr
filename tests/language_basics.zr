//=============================================================================
// tests/language_basics.zr — zr 语言核心功能测试
//
// 每个 `test_*` 函数验证一个语言特性。测试运行器会依次调用它们，
// 任一返回非 0 即视为失败。
//=============================================================================

use core::{Option, Result, panic, min, max, clamp, assert, assert_eq};
use io::{println, println_int, print_fmt, FormatArg};

//=============================================================================
// 1. 变量绑定与基本运算
//=============================================================================

fn test_variables_and_arithmetic() -> i32 {
    let x: i32 = 10;
    let y: i32 = 20;
    assert_eq(x + y, 30, "arithmetic should work");
    assert_eq(x * y, 200, "multiplication should work");

    let mut counter = 0;
    counter = counter + 1;
    assert(counter == 1, "mut reassignment should work");

    return 0;
}

//=============================================================================
// 2. 控制流
//=============================================================================

fn test_control_flow() -> i32 {
    // if / else
    let n = 7;
    let is_odd = if n % 2 == 1 { true } else { false };
    assert(is_odd, "if expression should work");

    // while
    let mut sum = 0;
    let mut i = 1;
    while i <= 10 {
        sum = sum + i;
        i = i + 1;
    }
    assert_eq(sum, 55, "while loop sum should be 55");

    // for-in（通过 Range 迭代器）
    sum = 0;
    let range = Range::new(1, 11);
    let mut it = range;
    loop {
        let p = it.next();
        if p == 0 as *mut i64 { break; }
        sum = sum + *p;
    }
    assert_eq(sum, 55, "for-range should match while sum");

    // loop + break + continue
    let mut acc = 0;
    let mut k = 0;
    loop {
        k = k + 1;
        if k > 10 { break; }
        if k % 2 == 0 { continue; }
        acc = acc + k;
    }
    assert_eq(acc, 25, "loop with break/continue should sum odds");

    return 0;
}

//=============================================================================
// 3. 模式匹配
//=============================================================================

fn test_pattern_matching() -> i32 {
    let value: i32 = 2;
    let result = match value {
        0        => 100,
        1 | 2    => 200,  // 或模式
        3..=5    => 300,  // 范围模式
        _        => 999,  // 通配符
    };
    assert_eq(result, 200, "or-pattern match failed");

    // 嵌套匹配
    let nested: i32 = 4;
    let r2 = match nested {
        0..=2   => "small",
        3..=7   => "medium",
        _       => "large",
    };
    assert(r2 == "medium", "range pattern match failed");

    return 0;
}

//=============================================================================
// 4. 函数与递归
//=============================================================================

fn fib(n: u64) -> u64 {
    if n <= 1 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn test_functions() -> i32 {
    assert_eq(fib(0), 0, "fib(0)");
    assert_eq(fib(1), 1, "fib(1)");
    assert_eq(fib(10), 55, "fib(10)");
    assert_eq(fib(20), 6765, "fib(20)");
    return 0;
}

//=============================================================================
// 5. Option / Result
//=============================================================================

fn test_option_result() -> i32 {
    let some = Option::Some(42);
    assert(some.is_some(), "Option::Some.is_some");
    assert(!some.is_none(), "Option::Some.is_none");
    assert_eq(some.unwrap(), 42, "Option::unwrap");

    let none: Option<i32> = Option::None;
    assert(none.is_none(), "Option::None.is_none");
    assert_eq(none.unwrap_or(99), 99, "Option::unwrap_or");

    let ok = Result::Ok::<i32, &'static str>(123);
    assert(ok.is_ok(), "Result::Ok.is_ok");
    assert_eq(ok.unwrap(), 123, "Result::unwrap");

    let err = Result::Err::<i32, &'static str>("boom");
    assert(err.is_err(), "Result::Err.is_err");

    // 链式 map
    let mapped = some.map(|x: i32| -> i32 { return x * 2; });
    assert_eq(mapped.unwrap(), 84, "Option::map");

    return 0;
}

//=============================================================================
// 6. 泛型与 trait
//=============================================================================

fn test_generics() -> i32 {
    let a = min(10, 3);
    assert_eq(a, 3, "min");

    let b = max(10, 3);
    assert_eq(b, 10, "max");

    let c = clamp(15, 0, 10);
    assert_eq(c, 10, "clamp upper");

    let d = clamp(-5, 0, 10);
    assert_eq(d, 0, "clamp lower");

    return 0;
}

//=============================================================================
// 7. 数组与切片
//=============================================================================

fn test_arrays_and_slices() -> i32 {
    let arr: [i32; 5] = [10, 20, 30, 40, 50];
    assert_eq(arr.len, 5, "array len");
    assert_eq(arr[0], 10, "array index");
    assert_eq(arr[4], 50, "array last");

    // 切片
    let s: []const i32 = arr;
    assert_eq(s.len, 5, "slice len");
    assert_eq(*s.ptr, 10, "slice deref");

    return 0;
}

//=============================================================================
// 8. 字符串
//=============================================================================

fn test_strings() -> i32 {
    let mut s = String::new();
    s.push_byte(b'H');
    s.push_byte(b'i');
    assert_eq(s.len(), 2, "String::len");

    let mut s2 = String::from_bytes("hello");
    assert_eq(s2.len(), 5, "String::from_bytes len");
    assert(s2.starts_with("he"), "starts_with");
    assert(s2.ends_with("lo"), "ends_with");
    assert(s2.contains("ell"), "contains");

    let mut s3 = String::from_bytes("abc");
    s3.push_byte(b'd');
    assert_eq(s3.len(), 4, "String::push_byte");

    s2.destroy();
    s3.destroy();

    return 0;
}

//=============================================================================
// 9. 结构体与方法
//=============================================================================

pub struct Counter {
    pub count: u64,
}

impl Counter {
    pub fn new() -> Counter {
        return Counter { count: 0 };
    }

    pub fn increment(self: &mut Counter) -> u64 {
        self.count = self.count + 1;
        return self.count;
    }

    pub fn reset(self: &mut Counter) {
        self.count = 0;
    }
}

fn test_structs_and_methods() -> i32 {
    let mut c = Counter::new();
    assert_eq(c.increment(), 1, "Counter::increment 1");
    assert_eq(c.increment(), 2, "Counter::increment 2");
    assert_eq(c.count, 2, "Counter.count");
    c.reset();
    assert_eq(c.count, 0, "Counter::reset");

    return 0;
}

//=============================================================================
// 10. 枚举与代数数据类型
//=============================================================================

pub enum List<T> {
    Nil,
    Cons(T, *mut List<T>),
}

fn test_enums() -> i32 {
    // 构造一个单元素列表
    let head = List::Cons(42, 0 as *mut List<i32>);
    match head {
        List::Cons(v, _) => assert_eq(v, 42, "enum payload extraction"),
        List::Nil        => panic("should be Cons"),
    }
    return 0;
}

//=============================================================================
// 11. 闭包
//=============================================================================

fn test_closures() -> i32 {
    let factor = 3;
    let multiply = |x: i32| -> i32 { return x * factor; };
    assert_eq(multiply(7), 21, "closure with capture");

    // 高阶函数
    let apply = |x: i32, f: fn(i32) -> i32| -> i32 { return f(f(x)); };
    let double = |x: i32| -> i32 { return x * 2; };
    assert_eq(apply(5, double), 20, "higher-order function");

    return 0;
}

//=============================================================================
// 12. 断言与 panic
//=============================================================================

fn test_assertions() -> i32 {
    // 这些不应触发 panic
    assert(1 + 1 == 2, "basic assertion");
    assert_eq(2 * 3, 6, "equality assertion");

    // 故意触发 panic 应被测试框架捕获（这里用子进程语义）
    // panic("this would abort");

    return 0;
}

//=============================================================================
// 13. 格式化输出
//=============================================================================

fn test_formatting() -> i32 {
    // 验证 print_fmt 不崩溃
    print_fmt(
        "test: {}, {}, {}",
        &[FormatArg::Int(1), FormatArg::Uint(2), FormatArg::Bool(true)],
    );
    println("");
    return 0;
}

//=============================================================================
// 测试入口
//=============================================================================

/// 测试运行器：依次执行所有测试，统计结果。
fn main() -> i32 {
    println("=== zr test suite ===");
    println("");

    let tests: []const (fn() -> i32) = &[
        test_variables_and_arithmetic,
        test_control_flow,
        test_pattern_matching,
        test_functions,
        test_option_result,
        test_generics,
        test_arrays_and_slices,
        test_strings,
        test_structs_and_methods,
        test_enums,
        test_closures,
        test_assertions,
        test_formatting,
    ];

    let mut passed = 0;
    let mut failed = 0;
    let mut i = 0;
    while i < tests.len {
        let result = tests.ptr[i]();
        if result == 0 {
            passed = passed + 1;
            println(".");
        } else {
            failed = failed + 1;
            println("F");
        }
        i = i + 1;
    }

    println("");
    println("---");
    print_fmt(
        "{} passed, {} failed, {} total",
        &[FormatArg::Uint(passed), FormatArg::Uint(failed), FormatArg::Uint(tests.len)],
    );
    println("");

    if failed > 0 {
        return 1;
    }
    println("all tests passed");
    return 0;
}
