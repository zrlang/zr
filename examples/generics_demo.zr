//=============================================================================
// generics_demo.zr — 展示 zr 的泛型、trait 与数据结构
//
// 实现一个简单的泛型栈，并演示 trait 约束、关联类型、默认实现等。
//=============================================================================

use core::{Option, panic};
use std::collections::Vec;

//=============================================================================
// 一个可入栈/出栈的 trait
//=============================================================================

pub trait Stack<T> {
    fn push(self: &mut Self, value: T);
    fn pop(self: &mut Self) -> Option<T>;
    fn peek(self) -> Option<T>;
    fn len(self) -> usize;

    /// 默认方法：判断是否为空
    fn is_empty(self) -> bool {
        return self.len() == 0;
    }
}

//=============================================================================
// 泛型栈实现
//=============================================================================

pub struct StackImpl<T> {
    inner: Vec<T>,
}

impl<T> StackImpl<T> {
    pub fn new() -> StackImpl<T> {
        return StackImpl { inner: Vec::new() };
    }

    pub fn with_capacity(cap: usize) -> StackImpl<T> {
        return StackImpl { inner: Vec::with_capacity(cap) };
    }
}

impl<T> Stack<T> for StackImpl<T> {
    fn push(self: &mut StackImpl<T>, value: T) {
        self.inner.push(value);
    }

    fn pop(self: &mut StackImpl<T>) -> Option<T> {
        return self.inner.pop();
    }

    fn peek(self) -> Option<T>
    where T: Copy
    {
        if self.inner.is_empty() { return Option::None; }
        return Option::Some(self.inner.get(self.inner.len() - 1));
    }

    fn len(self) -> usize {
        return self.inner.len();
    }
}

//=============================================================================
// 约束于多个 trait 的泛型函数
//=============================================================================

/// 把一个可栈类型里的所有元素弹出并累加。
/// 要求 T 可累加（实现 Accumulate），栈元素可复制。
pub trait Accumulate {
    fn accumulate(self, other: Self) -> Self;
}

impl Accumulate for i32 {
    fn accumulate(self, other: i32) -> i32 {
        return self + other;
    }
}

impl Accumulate for f64 {
    fn accumulate(self, other: f64) -> f64 {
        return self + other;
    }
}

fn drain_accumulate<T: Copy + Accumulate, S: Stack<T>>(stack: &mut S) -> T
where T: Accumulate
{
    let mut acc = Option::None;
    while !stack.is_empty() {
        let v = stack.pop().unwrap();
        acc = match acc {
            Option::Some(a) => Option::Some(a.accumulate(v)),
            Option::None    => Option::Some(v),
        };
    }
    return acc.unwrap();
}

//=============================================================================
// 关联类型示例
//=============================================================================

/// 一个"容器"trait，其元素类型通过关联类型暴露。
pub trait Container {
    type Elem;

    fn len(self) -> usize;
    fn get(self, index: usize) -> Option<Self::Elem>;
}

impl<T: Copy> Container for Vec<T> {
    type Elem = T;

    fn len(self) -> usize {
        return self.len();
    }

    fn get(self, index: usize) -> Option<T> {
        if index >= self.len() { return Option::None; }
        return Option::Some(self.get(index));
    }
}

/// 取容器首尾两元素之和（若足够长）。
fn sum_ends<C: Container>(c: C) -> Option<C::Elem>
where C::Elem: Accumulate + Copy
{
    if c.len() < 2 { return Option::None; }
    let first = c.get(0).unwrap();
    let last = c.get(c.len() - 1).unwrap();
    return Option::Some(first.accumulate(last));
}

//=============================================================================
// 递归泛型数据结构
//=============================================================================

/// 二叉树的节点。
pub struct TreeNode<T> {
    pub value: T,
    pub left:  Option<Box<TreeNode<T>>>,
    pub right: Option<Box<TreeNode<T>>>,
}

impl<T> TreeNode<T> {
    pub fn leaf(value: T) -> TreeNode<T> {
        return TreeNode {
            value,
            left:  Option::None,
            right: Option::None,
        };
    }

    pub fn with_children(
        value: T,
        left: TreeNode<T>,
        right: TreeNode<T>,
    ) -> TreeNode<T> {
        return TreeNode {
            value,
            left:  Option::Some(Box::new(left)),
            right: Option::Some(Box::new(right)),
        };
    }

    /// 计算树的高度。
    pub fn height(self: &TreeNode<T>) -> usize {
        let lh = match &self.left {
            Option::Some(node) => node.height(),
            Option::None        => 0,
        };
        let rh = match &self.right {
            Option::Some(node) => node.height(),
            Option::None        => 0,
        };
        let greater = if lh > rh { lh } else { rh };
        return 1 + greater;
    }

    /// 计算节点总数。
    pub fn size(self: &TreeNode<T>) -> usize {
        let ls = match &self.left {
            Option::Some(node) => node.size(),
            Option::None        => 0,
        };
        let rs = match &self.right {
            Option::Some(node) => node.size(),
            Option::None        => 0,
        };
        return 1 + ls + rs;
    }
}

//=============================================================================
// 比较 trait 的泛型使用
//=============================================================================

fn find_max<T: Ord + Copy>(slice: []const T) -> Option<T> {
    if slice.len == 0 { return Option::None; }
    let mut m = slice[0];
    let mut i = 1;
    while i < slice.len {
        if m.lt(slice[i]) { m = slice[i]; }
        i = i + 1;
    }
    return Option::Some(m);
}

fn find_min<T: Ord + Copy>(slice: []const T) -> Option<T> {
    if slice.len == 0 { return Option::None; }
    let mut m = slice[0];
    let mut i = 1;
    while i < slice.len {
        if slice[i].lt(m) { m = slice[i]; }
        i = i + 1;
    }
    return Option::Some(m);
}

/// 返回切片中的最值对。
fn min_max<T: Ord + Copy>(slice: []const T) -> Option<(T, T)> {
    let mn = find_min(slice)?;
    let mx = find_max(slice)?;
    return Option::Some((mn, mx));
}

//=============================================================================
// 主入口
//=============================================================================

fn main() -> i32 {
    use io::{println, println_int};

    println("=== zr generics demo ===");
    println("");

    // 1. 栈
    let mut stack = StackImpl::<i32>::new();
    stack.push(10);
    stack.push(20);
    stack.push(30);
    println("stack len =");
    println_int(stack.len() as i64);
    println(", is_empty =");
    // print_bool(stack.is_empty());

    let top = stack.pop();
    println("popped =");
    println_int(top.unwrap() as i64);

    // 2. 累加
    let mut s2 = StackImpl::<i32>::new();
    s2.push(1);
    s2.push(2);
    s2.push(3);
    s2.push(4);
    let total = drain_accumulate(&mut s2);
    println("sum of stack =");
    println_int(total as i64);

    // 3. 关联类型
    let mut v = Vec::<i32>::new();
    v.push(100);
    v.push(200);
    v.push(300);
    let ends = sum_ends(v);
    println("sum of ends =");
    println_int(ends.unwrap() as i64);

    // 4. 二叉树
    let tree = TreeNode::with_children(
        1,
        TreeNode::with_children(2, TreeNode::leaf(4), TreeNode::leaf(5)),
        TreeNode::with_children(3, TreeNode::leaf(6), TreeNode::leaf(7)),
    );
    println("tree size =");
    println_int(tree.size() as i64);
    println("tree height =");
    println_int(tree.height() as i64);

    // 5. 泛型算法
    let nums: [i32; 6] = [42, 7, 99, 13, 6, 55];
    let (mn, mx) = min_max(nums).unwrap();
    println("min =");
    println_int(mn as i64);
    println("max =");
    println_int(mx as i64);

    return 0;
}
