//=============================================================================
// showcase.zr — 全面展示 zr 的语言特性
//
// 本文件演示 zr 的大部分语法与语义：函数、泛型、trait、模式匹配、
// 枚举、结构体、切片、循环、闭包、错误类型、属性、可见性等。
//=============================================================================

use core::{Option, Result, panic, min, max, swap};
use io::{print, println, println_int, print_fmt, FormatArg};

//=============================================================================
// 1. 函数与重载/泛型
//=============================================================================

/// 计算两个整数的最大值（用 trait 约束的泛型版本）。
fn max3<T: Ord>(a: T, b: T, c: T) -> T {
    let ab = max(a, b);
    return max(ab, c);
}

/// 递归阶乘。
fn factorial(n: u64) -> u64 {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

/// 可变参数风格的求和（通过切片）。
fn sum_slice(values: []const i32) -> i32 {
    let mut total = 0;
    let mut i = 0;
    while i < values.len {
        total = total + values.ptr[i];
        i = i + 1;
    }
    return total;
}

//=============================================================================
// 2. 结构体与实现
//=============================================================================

/// 表示一个二维点。
pub struct Point {
    pub x: f64,
    pub y: f64,
}

impl Point {
    /// 构造函数。
    pub fn new(x: f64, y: f64) -> Point {
        return Point { x, y };
    }

    /// 计算到原点的距离。
    pub fn distance(self) -> f64 {
        return (self.x * self.x + self.y * self.y).sqrt();
    }

    /// 平移。
    pub fn translate(self: &mut Point, dx: f64, dy: f64) {
        self.x = self.x + dx;
        self.y = self.y + dy;
    }
}

//=============================================================================
// 3. 枚举与模式匹配
//=============================================================================

/// 一个简单的算术表达式 AST。
pub enum Expr {
    Num(f64),
    Add(*const Expr, *const Expr),
    Mul(*const Expr, *const Expr),
    Neg(*const Expr),
}

impl Expr {
    /// 求值一个表达式。
    pub fn eval(self: &Expr) -> f64 {
        match self {
            Expr::Num(n)        => return *n,
            Expr::Add(lhs, rhs) => return (*lhs).eval() + (*rhs).eval(),
            Expr::Mul(lhs, rhs) => return (*lhs).eval() * (*rhs).eval(),
            Expr::Neg(inner)    => return -(*inner).eval(),
        }
    }
}

//=============================================================================
// 4. trait 与 impl
//=============================================================================

/// 可累加的抽象。
pub trait Accumulate {
    fn accumulate(self, other: Self) -> Self;
}

impl Accumulate for i32 {
    fn accumulate(self, other: i32) -> i32 {
        return self + other;
    }
}

impl Accumulate for String {
    fn accumulate(self, other: String) -> String {
        return String::concat(&self, &other);
    }
}

//=============================================================================
// 5. 闭包与高阶函数
//=============================================================================

/// 用闭包实现一个简单的"管道"处理。
fn transform<T>(value: T, pipeline: fn(T) -> T) -> T {
    return pipeline(value);
}

//=============================================================================
// 6. 属性与可见性
//=============================================================================

/// 内联提示属性。
#[inline(always)]
fn hot_path(x: i32) -> i32 {
    return x * 2 + 1;
}

/// 不导出的内部辅助函数。
fn internal_helper() -> i32 {
    return 42;
}

//=============================================================================
// 7. 异步示例
//=============================================================================

async fn fetch_data(url: String) -> Result<String, &'static str> {
    // 模拟异步 I/O
    println("fetching: ");
    print(url.as_bytes());
    println("");

    // 真实场景中这里会 await 一个 I/O Future
    // await sleep(100);

    return Result::Ok(String::from_bytes("response body"));
}

async fn main_async() -> i32 {
    let url = String::from_bytes("https://example.org");
    match fetch_data(url) {
        Result::Ok(body) => {
            println("got response:");
            print(body.as_bytes());
            println("");
            return 0;
        }
        Result::Err(err) => {
            println(err);
            return 1;
        }
    }
}

//=============================================================================
// 主入口
//=============================================================================

fn main() -> i32 {
    println("=== zr showcase ===");

    // 泛型函数
    let m = max3(10, 25, 17);
    println("max3(10, 25, 17) =");
    println_int(m);

    // 递归
    let fact = factorial(10);
    println("factorial(10) =");
    println_int(fact as i64);

    // 切片
    let nums: [i32; 5] = [1, 2, 3, 4, 5];
    let total = sum_slice(nums);
    println("sum([1,2,3,4,5]) =");
    println_int(total);

    // 结构体与方法
    let mut p = Point::new(3.0, 4.0);
    println("point distance =");
    // println_float(p.distance());  // 若已实现
    p.translate(1.0, 1.0);
    println("translated");

    // 枚举与模式匹配
    let e = Expr::Add(
        &Expr::Num(2.0) as *const Expr,
        &Expr::Mul(
            &Expr::Num(3.0) as *const Expr,
            &Expr::Num(4.0) as *const Expr,
        ) as *const Expr,
    );
    let val = e.eval();
    // println_float(val);

    // 闭包
    let doubled = transform(21, |x: i32| -> i32 { return x * 2; });
    println("transform(21, *2) =");
    println_int(doubled);

    // 格式化输出
    print_fmt(
        "formatted: x={}, y={}, z={}",
        &[FormatArg::Int(1), FormatArg::Uint(2), FormatArg::Bool(true)],
    );
    println("");

    // trait 实现
    let acc = 1.accumulate(2);
    println("Accumulate::accumulate(1, 2) =");
    println_int(acc);

    // 工具函数
    swap(&m, &m);
    println("after swap (no-op demo)");

    return 0;
}
