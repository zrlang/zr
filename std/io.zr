//=============================================================================
// std/io.zr — 格式化输出、输入与基础 IO
//
// 输出的规则与 Rust 对齐：
//
//   - `{}`  是 Display：整数按十进制；浮点用"最短的能原样读回来的十进制"
//     （1.0 打成 "1"、0.1 打成 "0.1"、2.675 打成 "2.675"）；布尔是
//     true / false；字符串原样；字符原样。
//   - `{:?}` 是 Debug：字符串加双引号、字符加单引号、浮点在整数值上补
//     ".0"（1.0 打成 "1.0"）。
//   - `{:x}` / `{:X}` 是十六进制（小写 / 大写）。
//   - 格式串里的 `\n` `\r` `\t` `\\` `\"` `\'` `\0` 按转义处理；
//     `{{` 与 `}}` 是字面的花括号。
//
// 用法：
//
//   io::println_fmt("x = {}, y = {}\n", &[io::fmt_int(x), io::fmt_int(y)]);
//   io::print_fmt("pi = {}\n", &[io::fmt_float(3.14)]);
//
// 这个模块是**自足**的：不依赖 core，因此单独 `use io::...` 就能用。
//
// 浮点参数（`FormatArg` 里的那一项）用 IEEE 754 的位模式传，不用 f64
// 字段——见下面"f64 的位模式"一节。
//=============================================================================

//----- 外部运行时（由编译器/运行时提供）----------------------------------------

/// 向标准输出 / 错误流写入一段字节。返回写入的字节数，出错时返回 -1。
extern "C" {
    fn zr_write(fd: i32, buf: *const u8, count: usize) -> isize;
}

/// 从文件描述符读取。返回读取的字节数，0 表示 EOF，-1 表示出错。
extern "C" {
    fn zr_read(fd: i32, buf: *mut u8, count: usize) -> isize;
}

/// 打开文件。`mode`：0 = 只读，1 = 写（截断），2 = 追加。
/// 返回文件描述符，出错时返回 -1。
extern "C" {
    fn zr_open(path: *const u8, mode: i32) -> isize;
}

/// 关闭文件描述符。成功返回 0，出错返回 -1。
extern "C" {
    fn zr_close(fd: i32) -> i32;
}

/// 移动文件位置。`whence`：0 = 起点，1 = 当前，2 = 末尾。
///
/// 返回移动后的位置（字节偏移）；出错时返回 -1。
extern "C" {
    fn zr_seek(fd: i32, offset: i64, whence: i32) -> i64;
}

/// 取文件的大小（字节）。出错时返回 -1。
extern "C" {
    fn zr_fstat_size(fd: i32) -> i64;
}

/// 判断文件描述符是不是终端。是终端返回 1，其它返回 0。
extern "C" {
    fn zr_isatty(fd: i32) -> i32;
}

/// 终止程序，返回给定的退出码。
extern "C" {
    fn zr_exit(code: i32) -> !;
}

//----- 常用文件描述符常量------------------------------------------------------

pub const STDIN_FD:  i32 = 0;
pub const STDOUT_FD: i32 = 1;
pub const STDERR_FD: i32 = 2;

//=============================================================================
// 底层字节写入
//=============================================================================

/// 把一段字节写到给定的文件描述符，返回写入的字节数。
pub fn write_bytes(fd: i32, bytes: str) -> isize {
    return zr_write(fd, bytes.ptr, bytes.len);
}

/// 写一个字节。
pub fn write_byte(fd: i32, b: u8) {
    zr_write(fd, &b as *const u8, 1);
}

/// 写一个字符（ASCII 范围）。
pub fn write_char(fd: i32, c: char) {
    write_byte(fd, c as u8);
}

//=============================================================================
// 数值格式化
//=============================================================================

/// 把无符号 64 位整数格式化为十进制，写入 `fd`。
pub fn write_uint(fd: i32, mut n: u64) -> usize {
    if n == 0 {
        write_byte(fd, b'0');
        return 1;
    }
    let mut buf: [u8; 24] = [0; 24];
    let mut i = 24;
    while n > 0 {
        i = i - 1;
        buf[i] = ((n % 10) as u8 + b'0') as u8;
        n = n / 10;
    }
    let count = 24 - i;
    zr_write(fd, &buf[i] as *const u8, count);
    return count;
}

/// 把有符号 64 位整数格式化为十进制，写入 `fd`。
pub fn write_int(fd: i32, n: i64) -> usize {
    if n < 0 {
        write_byte(fd, b'-');
        return 1 + write_uint(fd, (-n) as u64);
    }
    return write_uint(fd, n as u64);
}

/// 把十六进制无符号整数写入 `fd`，`upper` 控制大小写。
pub fn write_hex(fd: i32, mut n: u64, upper: bool) -> usize {
    if n == 0 {
        write_byte(fd, b'0');
        return 1;
    }
    let mut buf: [u8; 16] = [0; 16];
    let mut i = 16;
    while n > 0 {
        i = i - 1;
        let d = (n % 16) as u8;
        buf[i] = if d < 10 {
            (d + b'0') as u8
        } else if upper {
            (d - 10 + b'A') as u8
        } else {
            (d - 10 + b'a') as u8
        };
        n = n / 16;
    }
    let count = 16 - i;
    zr_write(fd, &buf[i] as *const u8, count);
    return count;
}

/// f64 的最大值（用来判断是不是无穷）。
const F64_MAX: f64 = 1.7976931348623157e308;

/// 2^52（尾数的隐含位）。
const F64_POW52: f64 = 4503599627370496.0;

/// 2^1022（次正规数算尾数时用）。
///
/// 字面量必须是 2^1022 的**精确**值：4.4942328371557893e307 比 2^1022
/// 小一格，次正规数的尾数会算错。
const F64_POW2_1022: f64 = 4.49423283715579e307;

/// 尾数占 52 位（隐含的最高位不算在内）。
const F64_MANT_SHIFT: i64 = 52;

/// 指数域的偏置：实际指数 = 指数域 - 1023。
const F64_EXP_BIAS: i64 = 1023;

/// 尾数掩码（低 52 位）。
const F64_MANT_MASK: i64 = 4503599627370495;

/// 正无穷的位模式。
const F64_INF_BITS: i64 = 9218868437227405312;

/// 安静 NaN 的位模式。
const F64_NAN_BITS: i64 = 9221120237041090560;

//=============================================================================
// f64 的位模式
//=============================================================================
//
// 浮点参数在结构体里用**位模式**（整数）传递，不用 f64 字段。
//
// 原因：结构体按值拷贝走的是"逐字段拷贝"，f64 字段要经过内存与浮点
// 寄存器之间的搬运；编译器在这条路径上有 bug——数组里的 f64 字段会被
// 读成 0.0（`-O3` 下甚至直接崩）。位模式只走普通整数寄存器与内存，
// 不会在拷贝里被弄丢。
//
// 位模式按 IEEE 754 的布局：符号位 | 指数域（11 位）| 尾数域（52 位）。

/// f64 的符号位（最高位）。作为 i64 看就是 -2^63。
///
/// 模块级常量只能是字面量，负的字面量会被当成外部符号，所以这里用
/// 减法算出来：2^62 的两倍就是 2^63。
fn f64_sign_bit() -> i64 {
    let half: i64 = 4611686018427387904;
    return (0 as i64) - half - half;
}

/// 2 的整数次幂（结果精确：二进制浮点能精确表示 2 的幂）。
///
/// 不用 `if` 分两支算——同一个浮点局部在两个分支里各改一次，编译器
/// 合并分支时会把值弄丢；这里把"翻倍还是减半"折算成一个乘数。
fn pow2(k: i64) -> f64 {
    let mut n = k;
    let mut dir: i64 = 1;
    if k < 0 {
        n = 0 - k;
        dir = -1;
    }
    // dir = 1 → 2.0；dir = -1 → 0.5
    let mul = ((dir as f64) * 0.75) + 1.25;
    let mut r = 1.0;
    let mut i: i64 = 0;
    while i < n {
        r = r * mul;
        i = i + 1;
    }
    return r;
}

/// 正无穷。
fn f64_infinity() -> f64 {
    return 1.0 / 0.0;
}

/// NaN。
fn f64_nan() -> f64 {
    return 0.0 / 0.0;
}

/// 把 f64 变成它的 IEEE 754 位模式。
///
/// 做法：取绝对值，把绝对值缩放到 [2^52, 2^60)（乘 / 除 2 的幂都是
/// 精确的），于是尾数与指数都能整除地取出来；次正规数单独处理。
///
/// 注意：浮点形参在循环里是坏的（编译器不把它落栈，循环里读到的是
/// 垃圾），所以形参先参与一次浮点运算（下面的比较），再把值复制到
/// 局部变量里用；循环条件也只看整数。
fn f64_to_bits(v: f64) -> i64 {
    // NaN
    if v != v {
        return F64_NAN_BITS;
    }
    // 正负无穷
    if v > F64_MAX {
        return F64_INF_BITS;
    }
    if v < -F64_MAX {
        return F64_INF_BITS + f64_sign_bit();
    }
    // 符号（-0.0 也要带负号：1.0 / v < 0 能把它认出来）
    let mut sgn: i64 = 1;
    if v < 0.0 {
        sgn = -1;
    } else if v == 0.0 && 1.0 / v < 0.0 {
        sgn = -1;
    }
    // 绝对值：乘一个 ±1.0，不用分支改同一个浮点局部。
    let a0 = v * (sgn as f64);
    if a0 == 0.0 {
        if sgn < 0 {
            return f64_sign_bit();
        }
        return 0;
    }

    // 正规数的指数域是 e + 1023；次正规数的指数域是 0（尾数另算）。
    //
    // 指数 e：把 a0 缩放到 [2^52, 2^60) 之后，a0 自己的指数就是
    // "缩放后 a 的指数 - 缩放量"。
    //
    // 缩放只动整数（循环条件看整数部分），浮点的比较只在循环外做——
    // 浮点的比较放在循环里，编译器处理得不对。
    let mut a = a0 + 0.0;
    let mut shift: i64 = 0;
    let mut guard: i64 = 0;
    // 太大（超过 2^63，整数部分就取不到了）就除以 2^64
    while (a as i64) == -9223372036854775807 - 1 && guard < 20 {
        a = a / 18446744073709551616.0;
        shift = shift - 64;
        guard = guard + 1;
    }
    // 太小就乘 2^8（乘 256.0 精确）
    guard = 0;
    let mut ip = a as u64;
    while ip < 4503599627370496 && guard < 1400 {
        a = a * 256.0;
        shift = shift + 8;
        ip = a as u64;
        guard = guard + 1;
    }
    // a 现在在 [2^52, 2^60)：指数就是 ip 的最高位位置
    let mut exp: i64 = 0;
    let mut p = ip;
    while p >= 2 {
        p = p / 2;
        exp = exp + 1;
    }
    let e = exp - shift;
    let mut mag: i64 = 0;
    if e < -1022 {
        // 次正规数：指数域是 0，尾数域是 a0 * 2^1074。
        // 分两步乘（2^1022 与 2^52 各自单独可表示），每一步都精确。
        mag = ((a0 * F64_POW2_1022) * F64_POW52) as i64;
    } else {
        // 正规数：尾数 = a / 2^exp 的小数部分（乘 2^52 后取整）
        let m = (((a / pow2(exp)) - 1.0) * F64_POW52) as i64;
        mag = ((e + F64_EXP_BIAS) << F64_MANT_SHIFT) | m;
    }
    if sgn < 0 {
        return mag + f64_sign_bit();
    }
    return mag;
}

/// 把 IEEE 754 的位模式还原成 f64（与 `f64_to_bits` 互逆）。
fn f64_from_bits(bits: i64) -> f64 {
    // 标志用整数而不是 bool：布尔值在分支合并时会被弄错（符号会反）。
    let mut neg: i64 = 0;
    let mut mag = bits;
    if mag < 0 {
        neg = 1;
        mag = mag - f64_sign_bit();
    }
    let exp = mag >> F64_MANT_SHIFT;
    let mant = mag & F64_MANT_MASK;
    if exp == 2047 {
        if mant == 0 {
            return f64_infinity();
        }
        return f64_nan();
    }
    let mut v: f64 = 0.0;
    if exp == 0 {
        // 次正规数：值 = 尾数 * 2^-1074
        v = (mant as f64) * pow2(0 - 1074);
    } else {
        // 正规数：值 = (1 + 尾数/2^52) * 2^(指数域 - 偏置)
        v = (1.0 + (mant as f64) / F64_POW52) * pow2(exp - F64_EXP_BIAS);
    }
    if neg != 0 {
        return -v;
    }
    return v;
}

//=============================================================================
// 精确的十进制展开（大整数）
//=============================================================================
//
// Rust 的 `{}` 输出的是「能原样读回来的最短十进制」，整数部分可以长达
// 309 位（`f64::MAX`）。用 f64 算整数部分在 |v| >= 2^64 时会溢出，所以
// 这里把 IEEE 754 的值精确展开成十进制：值 = m * 2^e。
//
//   e >= 0：值是整数，反复乘 2；
//   e <  0：值 = m * 5^(-e) / 10^(-e)，反复乘 5，小数点左移 -e 位。
//
// 大整数用 10^9 进制的小端数组，输出十进制时每组正好 9 位。

/// 往缓冲区里写一段 ASCII。
fn put_str(buf: []mut u8, pos0: usize, s: str) -> usize {
    let mut pos = pos0;
    let mut i = 0;
    while i < s.len {
        buf[pos] = s.ptr[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}

/// 写 n 个 fill。
fn put_fill(buf: []mut u8, pos0: usize, n: usize, fill: u8) -> usize {
    let mut pos = pos0;
    let mut i = 0;
    while i < n {
        buf[pos] = fill;
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}

fn bn_from_u64(limbs: []mut u32, mut m: u64) -> usize {
    let base: u64 = 1000000000;
    let mut len = 0;
    while m > 0 {
        limbs[len] = (m % base) as u32;
        m = m / base;
        len = len + 1;
    }
    if len == 0 {
        limbs[0] = 0;
        return 1;
    }
    return len;
}

fn bn_mul_small(limbs: []mut u32, len0: usize, mul: u32) -> usize {
    let base: u64 = 1000000000;
    let mut carry: u64 = 0;
    let mut len = len0;
    let mut i = 0;
    while i < len0 {
        let t = (limbs[i] as u64) * (mul as u64) + carry;
        limbs[i] = (t % base) as u32;
        carry = t / base;
        i = i + 1;
    }
    while carry > 0 {
        limbs[len] = (carry % base) as u32;
        carry = carry / base;
        len = len + 1;
    }
    return len;
}

fn put_u32_plain(buf: []mut u8, pos0: usize, n0: u32) -> usize {
    let mut n = n0;
    if n == 0 {
        buf[pos0] = b'0';
        return pos0 + 1;
    }
    let mut tmp: [u8; 10] = [0; 10];
    let mut i = 10;
    while n > 0 {
        i = i - 1;
        tmp[i] = ((n % 10) as u8) + b'0';
        n = n / 10;
    }
    let mut pos = pos0;
    while i < 10 {
        buf[pos] = tmp[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}

fn put_u32_padded9(buf: []mut u8, pos0: usize, n0: u32) -> usize {
    let mut n = n0;
    let mut tmp: [u8; 9] = [0; 9];
    let mut i = 9;
    while i > 0 {
        i = i - 1;
        tmp[i] = ((n % 10) as u8) + b'0';
        n = n / 10;
    }
    let mut pos = pos0;
    let mut k = 0;
    while k < 9 {
        buf[pos] = tmp[k];
        pos = pos + 1;
        k = k + 1;
    }
    return pos;
}

fn bn_to_decimal(limbs: []const u32, len: usize, out: []mut u8) -> usize {
    let mut pos = put_u32_plain(out, 0, limbs[len - 1]);
    let mut i = len - 1;
    while i > 0 {
        i = i - 1;
        pos = put_u32_padded9(out, pos, limbs[i]);
    }
    return pos;
}

/// 把 `m * 2^e`（精确的二进制有理数）写成十进制数字。
///
/// 返回数字个数与小数点前的位数：值 = 0.<digits> * 10^exp。
fn dyadic_to_digits(m: u64, e2: i32, out: []mut u8, exp_out: &mut i32) -> usize {
    let mut limbs: [u32; 160] = [0; 160];
    let mut len = bn_from_u64(&mut limbs[0..160], m);
    // 不把"乘 2 还是乘 5"的循环放进 if 分支里：编译器在分支合并处
    // 会丢掉循环里更新过的局部变量（`len` 变成垃圾）。先算好次数和
    // 乘数，循环只写一次。
    let mut count: i32 = e2;
    let mut mul: u32 = 2;
    let mut k: i32 = 0;
    if e2 < 0 {
        count = 0 - e2;
        mul = 5;
        k = count;
    }
    let mut t: i32 = 0;
    while t < count {
        len = bn_mul_small(&mut limbs[0..160], len, mul);
        t = t + 1;
    }
    let dlen = bn_to_decimal(&limbs[0..160], len, out);
    *exp_out = (dlen as i32) - k;
    return dlen;
}
/// 把前 `keep` 位有效数字四舍五入（半数到偶数）。
fn round_sig(
    src: []const u8,
    slen: usize,
    sexp: i32,
    keep: usize,
    out: []mut u8,
    exp_out: &mut i32,
) -> usize {
    if keep == 0 {
        // 舍入位在第一位数字之前：只有 > 5 或 "5 后面还有非零" 才进 1。
        let mut up = false;
        if src[0] > b'5' {
            up = true;
        } else if src[0] == b'5' {
            let mut i = 1;
            while i < slen {
                if src[i] != b'0' {
                    up = true;
                    break;
                }
                i = i + 1;
            }
        }
        if up {
            out[0] = b'1';
            *exp_out = sexp + 1;
            return 1;
        }
        out[0] = b'0';
        *exp_out = sexp;
        return 1;
    }
    if keep >= slen {
        let mut i = 0;
        while i < keep {
            out[i] = if i < slen { src[i] } else { b'0' };
            i = i + 1;
        }
        *exp_out = sexp;
        return keep;
    }
    let mut i = 0;
    while i < keep {
        out[i] = src[i];
        i = i + 1;
    }
    let nxt = src[keep];
    let mut up = false;
    if nxt > b'5' {
        up = true;
    } else if nxt == b'5' {
        let mut rest = false;
        let mut j = keep + 1;
        while j < slen {
            if src[j] != b'0' {
                rest = true;
                break;
            }
            j = j + 1;
        }
        if rest {
            up = true;
        } else if ((out[keep - 1] - b'0') % 2) != 0 {
            up = true;
        }
    }
    if up {
        let mut k = keep;
        let mut carry = true;
        while k > 0 && carry {
            k = k - 1;
            if out[k] == b'9' {
                out[k] = b'0';
            } else {
                out[k] = out[k] + 1;
                carry = false;
            }
        }
        if carry {
            out[0] = b'1';
            *exp_out = sexp + 1;
            return 1;
        }
    }
    *exp_out = sexp;
    return keep;
}

/// 比较两个十进制数：值 = 0.<digits> * 10^exp。返回 -1 / 0 / 1。
///
/// 最高位数字的权重是 10^(exp-1)，所以先比 exp；exp 相同再逐位比，
/// 短的一边按 0 补齐。
fn cmp_decimal(
    ad: []const u8,
    alen: usize,
    aexp: i32,
    bd: []const u8,
    blen: usize,
    bexp: i32,
) -> i32 {
    if aexp > bexp {
        return 1;
    }
    if aexp < bexp {
        return -1;
    }
    let mut n = alen;
    if blen > n {
        n = blen;
    }
    let mut i = 0;
    while i < n {
        let a = if i < alen { ad[i] } else { b'0' };
        let b = if i < blen { bd[i] } else { b'0' };
        if a > b {
            return 1;
        }
        if a < b {
            return -1;
        }
        i = i + 1;
    }
    return 0;
}

/// 把十进制数字按小数点位置写出来（Rust 的 Display 没有指数形式）。
fn put_positional(
    buf: []mut u8,
    pos0: usize,
    c: []const u8,
    clen: usize,
    cexp: i32,
) -> usize {
    let mut pos = pos0;
    if cexp <= 0 {
        buf[pos] = b'0';
        pos = pos + 1;
        buf[pos] = b'.';
        pos = pos + 1;
        pos = put_fill(buf, pos, (0 - cexp) as usize, b'0');
        let mut i = 0;
        while i < clen {
            buf[pos] = c[i];
            pos = pos + 1;
            i = i + 1;
        }
    } else if (cexp as usize) >= clen {
        let mut i = 0;
        while i < clen {
            buf[pos] = c[i];
            pos = pos + 1;
            i = i + 1;
        }
        pos = put_fill(buf, pos, (cexp as usize) - clen, b'0');
    } else {
        let mut i = 0;
        while i < (cexp as usize) {
            buf[pos] = c[i];
            pos = pos + 1;
            i = i + 1;
        }
        buf[pos] = b'.';
        pos = pos + 1;
        while i < clen {
            buf[pos] = c[i];
            pos = pos + 1;
            i = i + 1;
        }
    }
    return pos;
}

fn put_float_prec(buf: []mut u8, pos0: usize, m: u64, e2: i32, prec: usize) -> usize {
    let mut pos = pos0;
    let mut digits: [u8; 800] = [0; 800];
    let mut dexp: i32 = 0;
    let dlen = dyadic_to_digits(m, e2, &mut digits[0..800], &mut dexp);
    let keep = dexp + (prec as i32);
    if keep <= 0 {
        // 比 10^-prec 的一半还小：直接输出 0.000...
        buf[pos] = b'0';
        pos = pos + 1;
        if prec > 0 {
            buf[pos] = b'.';
            pos = pos + 1;
            pos = put_fill(buf, pos, prec, b'0');
        }
        return pos;
    }
    let mut r: [u8; 800] = [0; 800];
    let mut rexp: i32 = 0;
    let rlen = round_sig(
        &digits[0..dlen],
        dlen,
        dexp,
        keep as usize,
        &mut r[0..800],
        &mut rexp,
    );
    if rexp > 0 {
        let ilen = rexp as usize;
        let mut i = 0;
        while i < ilen {
            buf[pos] = if i < rlen { r[i] } else { b'0' };
            pos = pos + 1;
            i = i + 1;
        }
    } else {
        buf[pos] = b'0';
        pos = pos + 1;
    }
    if prec > 0 {
        buf[pos] = b'.';
        pos = pos + 1;
        let mut frac_count: usize = 0;
        if rexp <= 0 {
            frac_count = (0 - rexp) as usize;
            pos = put_fill(buf, pos, frac_count, b'0');
        } else {
            let start = rexp as usize;
            let mut i = start;
            while i < rlen {
                buf[pos] = r[i];
                pos = pos + 1;
                frac_count = frac_count + 1;
                i = i + 1;
            }
        }
        while frac_count < prec {
            buf[pos] = b'0';
            pos = pos + 1;
            frac_count = frac_count + 1;
        }
    }
    return pos;
}

fn put_float_shortest(buf: []mut u8, pos0: usize, m: u64, e2: i32) -> usize {
    let mut pos = pos0;
    let mut digits: [u8; 800] = [0; 800];
    let mut dexp: i32 = 0;
    let dlen = dyadic_to_digits(m, e2, &mut digits[0..800], &mut dexp);

    // 最短往返：从 1 位有效数字开始试，落进 (prev, next) 就停。
    let mut prev_d: [u8; 800] = [0; 800];
    let mut next_d: [u8; 800] = [0; 800];
    let mut pm: u64 = 0;
    let mut pe: i32 = 0;
    if m == 4503599627370496 && e2 > -1074 {
        // 2 的幂：下方间隔只有一半
        pm = m * 4 - 1;
        pe = e2 - 2;
    } else {
        pm = m * 2 - 1;
        pe = e2 - 1;
    }
    let nm = m * 2 + 1;
    let ne = e2 - 1;
    let mut px: i32 = 0;
    let pl = dyadic_to_digits(pm, pe, &mut prev_d[0..800], &mut px);
    let mut nx: i32 = 0;
    let nl = dyadic_to_digits(nm, ne, &mut next_d[0..800], &mut nx);
    let inclusive = (m % 2) == 0;

    let mut c: [u8; 800] = [0; 800];
    let mut n = 1;
    while n <= 17 {
        let mut re: i32 = 0;
        let rl = round_sig(
            &digits[0..dlen],
            dlen,
            dexp,
            n,
            &mut c[0..800],
            &mut re,
        );
        let mut sl = rl;
        while sl > 1 && c[sl - 1] == b'0' {
            sl = sl - 1;
        }
        let lo = cmp_decimal(&prev_d[0..pl], pl, px, &c[0..sl], sl, re);
        let hi = cmp_decimal(&c[0..sl], sl, re, &next_d[0..nl], nl, nx);
        let ok = if inclusive {
            lo <= 0 && hi <= 0
        } else {
            lo < 0 && hi < 0
        };
        if ok || n == 17 {
            return put_positional(buf, pos0, &c[0..sl], sl, re);
        }
        n = n + 1;
    }
    return pos;
}

/// 按 Rust 的 Display 规则写出一个 f64，返回写入的字节数。
pub fn write_float(fd: i32, v: f64) -> usize {
    // 只把位模式往下传：浮点形参跨函数传递会被弄丢。
    let bits = f64_to_bits(v) as u64;
    let mut buf: [u8; 1024] = [0; 1024];
    let mut pos = 0;
    let ef = (bits >> 52) & 2047;
    let frac_mask: u64 = 4503599627370495;
    let frac = bits & frac_mask;
    if ef == 2047 {
        if frac != 0 {
            let n = put_str(&mut buf[0..1024], pos, "NaN");
            zr_write(fd, &buf[0] as *const u8, n);
            return n;
        }
        if (bits >> 63) != 0 {
            buf[pos] = b'-';
            pos = pos + 1;
        }
        let n = put_str(&mut buf[0..1024], pos, "inf");
        zr_write(fd, &buf[0] as *const u8, n);
        return n;
    }
    let ef2: u64 = if ef != 0 { ef } else { 1 };
    let m = frac | (if ef != 0 { 4503599627370496 } else { 0 as u64 });
    let e2: i32 = (ef2 as i32) - 1075;
    if (bits >> 63) != 0 {
        buf[pos] = b'-';
        pos = pos + 1;
    }
    let mut end: usize = 0;
    if m == 0 {
        buf[pos] = b'0';
        end = pos + 1;
    } else {
        end = put_float_shortest(&mut buf[0..1024], pos, m, e2);
    }
    zr_write(fd, &buf[0] as *const u8, end);
    return end;
}

/// 按 Rust 的 Debug 规则写出一个 f64（整数值补 `.0`）。
fn write_float_debug(fd: i32, v: f64) -> usize {
    let bits = f64_to_bits(v) as u64;
    let ef = (bits >> 52) & 2047;
    let frac_mask: u64 = 4503599627370495;
    let frac = bits & frac_mask;
    let ef2: u64 = if ef != 0 { ef } else { 1 };
    let m = frac | (if ef != 0 { 4503599627370496 } else { 0 as u64 });
    let e2: i32 = (ef2 as i32) - 1075;
    let mut whole = false;
    if ef != 2047 {
        if frac == 0 {
            whole = true;
        } else if e2 >= 0 {
            whole = true;
        } else if (0 - e2) < 64 {
            let k = (0 - e2) as u64;
            if m % (1u64 << k) == 0 {
                whole = true;
            }
        }
    }
    let mut buf: [u8; 1024] = [0; 1024];
    let mut pos = 0;
    if ef == 2047 {
        if frac != 0 {
            let n = put_str(&mut buf[0..1024], pos, "NaN");
            zr_write(fd, &buf[0] as *const u8, n);
            return n;
        }
        if (bits >> 63) != 0 {
            buf[pos] = b'-';
            pos = pos + 1;
        }
        let n = put_str(&mut buf[0..1024], pos, "inf");
        zr_write(fd, &buf[0] as *const u8, n);
        return n;
    }
    if (bits >> 63) != 0 {
        buf[pos] = b'-';
        pos = pos + 1;
    }
    let mut end: usize = 0;
    if m == 0 {
        buf[pos] = b'0';
        end = pos + 1;
    } else {
        end = put_float_shortest(&mut buf[0..1024], pos, m, e2);
    }
    if whole {
        buf[end] = b'.';
        buf[end + 1] = b'0';
        end = end + 2;
    }
    zr_write(fd, &buf[0] as *const u8, end);
    return end;
}

//=============================================================================
// 格式化参数
//=============================================================================

/// `print_fmt` / `println_fmt` 的参数。
///
/// 做成结构体而不是枚举：参数要放进数组里传，而数组元素走的是"按元素
/// 大小逐个拷贝"的路径，枚举那套（判别式 + 变体载荷）还没走通。
///
/// 字符串按 (指针, 长度) 传——切片在 zr 里是地址表示的，直接传切片会
/// 丢长度。
///
/// 浮点用**位模式**（`float_bits`）传，不用 f64 字段：结构体按值拷贝
/// 时 f64 字段要经过内存与浮点寄存器之间的搬运，编译器在这条路径上
/// 有 bug（数组里的 f64 字段会被读成 0.0，`-O3` 下甚至直接崩）；
/// 整数位模式只走普通整数寄存器与内存，不会被弄丢。
pub struct FormatArg {
    /// 种类：0=int 1=uint 2=float 3=bool 4=str 5=char 6=hex
    pub kind: i32,
    /// 整数 / 字符的值。
    pub int_value: i64,
    /// 浮点的 IEEE 754 位模式（`kind` 为 2 时有效）。
    pub float_bits: i64,
    /// 字符串的指针。
    pub str_ptr: *const u8,
    /// 字符串的长度。
    pub str_len: usize,
}

/// 一个整数参数。
pub fn fmt_int(n: i64) -> FormatArg {
    return FormatArg { kind: 0, int_value: n, float_bits: 0, str_ptr: 0 as *const u8, str_len: 0 };
}

/// 一个无符号整数参数。
pub fn fmt_uint(n: u64) -> FormatArg {
    return FormatArg { kind: 1, int_value: n as i64, float_bits: 0, str_ptr: 0 as *const u8, str_len: 0 };
}

/// 一个浮点参数。
pub fn fmt_float(n: f64) -> FormatArg {
    // 先做一次浮点运算（乘 1.0 不改值）。
    //
    // 浮点形参只有在参与浮点运算时才会被编译器落到栈槽上；只当实参
    // 传下去的话不落槽，调用时读到的是垃圾（0.0）。
    let v = n * 1.0;
    // NaN 单独处理（位模式是固定的）。
    if v != v {
        return FormatArg { kind: 2, int_value: 0, float_bits: F64_NAN_BITS, str_ptr: 0 as *const u8, str_len: 0 };
    }
    return FormatArg { kind: 2, int_value: 0, float_bits: f64_to_bits(v), str_ptr: 0 as *const u8, str_len: 0 };
}

/// 一个布尔参数。
pub fn fmt_bool(b: bool) -> FormatArg {
    return FormatArg { kind: 3, int_value: if b { 1 } else { 0 }, float_bits: 0, str_ptr: 0 as *const u8, str_len: 0 };
}

/// 一个字符串参数。
pub fn fmt_str(s: str) -> FormatArg {
    return FormatArg { kind: 4, int_value: 0, float_bits: 0, str_ptr: s.ptr, str_len: s.len };
}

/// 一个字符参数。
pub fn fmt_char(c: char) -> FormatArg {
    return FormatArg { kind: 5, int_value: c as i64, float_bits: 0, str_ptr: 0 as *const u8, str_len: 0 };
}

/// 一个十六进制参数。
pub fn fmt_hex(n: u64) -> FormatArg {
    return FormatArg { kind: 6, int_value: n as i64, float_bits: 0, str_ptr: 0 as *const u8, str_len: 0 };
}

//=============================================================================
// 格式化输出
//=============================================================================

/// 格式串里的规格。
///
/// 用整数而不是枚举：规格只有一个、取值就那么几个，枚举反而多一层间接。
const SPEC_DISPLAY: i32 = 0;
const SPEC_DEBUG: i32 = 1;
const SPEC_HEX_LOWER: i32 = 2;
const SPEC_HEX_UPPER: i32 = 3;
const SPEC_BIN: i32 = 4;
const SPEC_OCT: i32 = 5;

const ALIGN_DEFAULT: i32 = 0;
const ALIGN_LEFT: i32 = 1;
const ALIGN_RIGHT: i32 = 2;
const ALIGN_CENTER: i32 = 3;

// flags 里打包的位（参数太多会占用寄存器，打包成一个整数更稳）。
const FLAG_PLUS: u64 = 1;
const FLAG_ALT: u64 = 2;
const FLAG_ZERO: u64 = 4;
const FLAG_NUMERIC: u64 = 8;
const FLAG_NOPAD: u64 = 16;

/// 按 Rust 的规则把格式串里的 `{}` / `{:?}` / `{:x}` 等替换成参数并输出。
///
/// 支持的规格：`[[填充]对齐][+][#][0][宽度][.精度][类型]`，
/// 对齐是 `<` `^` `>`，类型是 `?` `x` `X` `b` `o`。
/// 也支持显式的参数下标（`{0}`、`{1:`?`}`）。
pub fn print_fmt(fmt: str, args: *const FormatArg, nargs: usize) {
    let mut ai = 0;
    let mut i = 0;
    while i < fmt.len {
        let c = fmt.ptr[i];
        if c == b'{' {
            // `{{` 是字面的花括号
            if i + 1 < fmt.len && fmt.ptr[i + 1] == b'{' {
                write_byte(STDOUT_FD, b'{');
                i = i + 2;
                continue;
            }
            let mut j = i + 1;
            let mut argi = ai;
            let mut explicit = false;
            if j < fmt.len && is_digit(fmt.ptr[j]) {
                let mut idx: usize = 0;
                while j < fmt.len && is_digit(fmt.ptr[j]) {
                    idx = idx * 10 + ((fmt.ptr[j] - b'0') as usize);
                    j = j + 1;
                }
                argi = idx;
                explicit = true;
            }
            let mut fill: u8 = b' ';
            let mut align: i32 = ALIGN_DEFAULT;
            let mut plus = false;
            let mut alt = false;
            let mut zero = false;
            let mut width: usize = 0;
            let mut prec: i32 = -1;
            let mut kind: i32 = SPEC_DISPLAY;
            if j < fmt.len && fmt.ptr[j] == b':' {
                j = j + 1;
                // 填充 + 对齐（填充字符后面必须跟一个对齐符）
                if j + 1 < fmt.len && is_align(fmt.ptr[j + 1]) {
                    fill = fmt.ptr[j];
                    align = align_of(fmt.ptr[j + 1]);
                    j = j + 2;
                } else if j < fmt.len && is_align(fmt.ptr[j]) {
                    align = align_of(fmt.ptr[j]);
                    j = j + 1;
                }
                if j < fmt.len && fmt.ptr[j] == b'+' {
                    plus = true;
                    j = j + 1;
                } else if j < fmt.len && fmt.ptr[j] == b'-' {
                    j = j + 1;
                }
                if j < fmt.len && fmt.ptr[j] == b'#' {
                    alt = true;
                    j = j + 1;
                }
                if j < fmt.len && fmt.ptr[j] == b'0' {
                    zero = true;
                    j = j + 1;
                }
                while j < fmt.len && is_digit(fmt.ptr[j]) {
                    width = width * 10 + ((fmt.ptr[j] - b'0') as usize);
                    j = j + 1;
                }
                if j < fmt.len && fmt.ptr[j] == b'.' {
                    j = j + 1;
                    prec = 0;
                    while j < fmt.len && is_digit(fmt.ptr[j]) {
                        prec = prec * 10 + ((fmt.ptr[j] - b'0') as i32);
                        j = j + 1;
                    }
                }
                if j < fmt.len {
                    let t = fmt.ptr[j];
                    if t == b'?' {
                        kind = SPEC_DEBUG;
                        j = j + 1;
                    } else if t == b'x' {
                        kind = SPEC_HEX_LOWER;
                        j = j + 1;
                    } else if t == b'X' {
                        kind = SPEC_HEX_UPPER;
                        j = j + 1;
                    } else if t == b'b' {
                        kind = SPEC_BIN;
                        j = j + 1;
                    } else if t == b'o' {
                        kind = SPEC_OCT;
                        j = j + 1;
                    }
                }
            }
            if j < fmt.len && fmt.ptr[j] == b'}' {
                if argi < nargs {
                    let mut flags: u64 = 0;
                    flags = ((kind as u64) << 24) | ((align as u64) << 16) | ((fill as u64) << 8);
                    if plus { flags = flags | FLAG_PLUS; }
                    if alt { flags = flags | FLAG_ALT; }
                    if zero { flags = flags | FLAG_ZERO; }
                    write_arg(STDOUT_FD, &args[argi], flags, width, prec);
                    if !explicit {
                        ai = ai + 1;
                    }
                }
                i = j + 1;
                continue;
            }
            // 不是合法的占位符：原样输出
            write_byte(STDOUT_FD, c);
            i = i + 1;
            continue;
        }
        if c == b'}' {
            // `}}` 是字面的花括号
            if i + 1 < fmt.len && fmt.ptr[i + 1] == b'}' {
                write_byte(STDOUT_FD, b'}');
                i = i + 2;
                continue;
            }
            write_byte(STDOUT_FD, c);
            i = i + 1;
            continue;
        }
        if c == b'\\' {
            // 转义序列
            i = i + 1;
            if i < fmt.len {
                let e = fmt.ptr[i];
                if e == b'n' {
                    write_byte(STDOUT_FD, b'\n');
                } else if e == b'r' {
                    write_byte(STDOUT_FD, b'\r');
                } else if e == b't' {
                    write_byte(STDOUT_FD, b'\t');
                } else if e == b'0' {
                    write_byte(STDOUT_FD, 0);
                } else if e == b'\\' {
                    write_byte(STDOUT_FD, b'\\');
                } else if e == b'"' {
                    write_byte(STDOUT_FD, b'"');
                } else if e == b'\'' {
                    write_byte(STDOUT_FD, b'\'');
                } else {
                    // 不认识的转义：原样输出反斜杠与该字符
                    write_byte(STDOUT_FD, b'\\');
                    write_byte(STDOUT_FD, e);
                }
                i = i + 1;
            }
            continue;
        }
        write_byte(STDOUT_FD, c);
        i = i + 1;
    }
}

/// 同 `print_fmt`，但末尾补一个换行。
pub fn println_fmt(fmt: str, args: *const FormatArg, nargs: usize) {
    print_fmt(fmt, args, nargs);
    write_byte(STDOUT_FD, b'\n');
}

fn is_radix(kind: i32) -> bool {
    return kind == SPEC_HEX_LOWER || kind == SPEC_HEX_UPPER || kind == SPEC_BIN || kind == SPEC_OCT;
}

fn is_digit(c: u8) -> bool {
    return c >= b'0' && c <= b'9';
}

fn is_align(c: u8) -> bool {
    return c == b'<' || c == b'^' || c == b'>';
}

fn align_of(c: u8) -> i32 {
    if c == b'<' {
        return ALIGN_LEFT;
    }
    if c == b'^' {
        return ALIGN_CENTER;
    }
    return ALIGN_RIGHT;
}

fn put_bytes(buf: []mut u8, pos0: usize, p: *const u8, len: usize) -> usize {
    let mut pos = pos0;
    let mut i = 0;
    while i < len {
        buf[pos] = p[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}

fn put_uint_dec(buf: []mut u8, pos0: usize, mut n: u64) -> usize {
    if n == 0 {
        buf[pos0] = b'0';
        return pos0 + 1;
    }
    let mut tmp: [u8; 24] = [0; 24];
    let mut i: usize = 24;
    while n > 0 {
        i = i - 1;
        tmp[i] = ((n % 10) as u8 + b'0') as u8;
        n = n / 10;
    }
    return put_bytes(buf, pos0, &tmp[i] as *const u8, 24 - i);
}

fn put_radix(buf: []mut u8, pos0: usize, mut n: u64, base: u64, upper: bool) -> usize {
    if n == 0 {
        buf[pos0] = b'0';
        return pos0 + 1;
    }
    let mut tmp: [u8; 64] = [0; 64];
    let mut i: usize = 64;
    while n > 0 {
        i = i - 1;
        let d = (n % base) as u8;
        tmp[i] = if d < 10 {
            (d + b'0') as u8
        } else if upper {
            (d - 10 + b'A') as u8
        } else {
            (d - 10 + b'a') as u8
        };
        n = n / base;
    }
    return put_bytes(buf, pos0, &tmp[i] as *const u8, 64 - i);
}

fn put_escaped(buf: []mut u8, pos0: usize, p: *const u8, len: usize) -> usize {
    let mut pos = pos0;
    let mut i = 0;
    while i < len {
        let c = p[i];
        if c == b'"' {
            pos = put_bytes(buf, pos, "\\\"".ptr, 2);
        } else if c == b'\\' {
            pos = put_bytes(buf, pos, "\\\\".ptr, 2);
        } else if c == b'\n' {
            pos = put_bytes(buf, pos, "\\n".ptr, 2);
        } else if c == b'\t' {
            pos = put_bytes(buf, pos, "\\t".ptr, 2);
        } else if c == b'\r' {
            pos = put_bytes(buf, pos, "\\r".ptr, 2);
        } else {
            buf[pos] = c;
            pos = pos + 1;
        }
        i = i + 1;
    }
    return pos;
}

/// 把不带符号的浮点写到缓冲区（`bits` 的最高位已经是 0）。
fn put_float_bits(
    buf: []mut u8,
    pos0: usize,
    bits: u64,
    prec: i32,
    debug: bool,
) -> usize {
    let ef = (bits >> 52) & 2047;
    let frac = bits & 4503599627370495;
    if ef == 2047 {
        if frac != 0 {
            return put_str(buf, pos0, "NaN");
        }
        return put_str(buf, pos0, "inf");
    }
    let ef2: u64 = if ef != 0 { ef } else { 1 };
    let m = frac | (if ef != 0 { 4503599627370496 } else { 0 as u64 });
    let e2: i32 = (ef2 as i32) - 1075;
    if m == 0 {
        let mut pos = pos0;
        buf[pos] = b'0';
        pos = pos + 1;
        if debug && prec < 0 {
            buf[pos] = b'.';
            buf[pos + 1] = b'0';
            pos = pos + 2;
        }
        return pos;
    }
    if prec >= 0 {
        return put_float_prec(buf, pos0, m, e2, prec as usize);
    }
    let mut end = put_float_shortest(buf, pos0, m, e2);
    if debug {
        let mut whole = false;
        if e2 >= 0 {
            whole = true;
        } else if (0 - e2) < 64 {
            let k = (0 - e2) as u64;
            if m % (1u64 << k) == 0 {
                whole = true;
            }
        }
        if whole {
            buf[end] = b'.';
            buf[end + 1] = b'0';
            end = end + 2;
        }
    }
    return end;
}

fn write_fill(fd: i32, n: usize, fill: u8) {
    let mut i = 0;
    while i < n {
        write_byte(fd, fill);
        i = i + 1;
    }
}

/// 写出已经格式化好的内容，并按规格补填充/对齐/前缀。
///
/// `pfx` 的低 16 位是前缀的两个字节，bit 16..24 是前缀长度；
/// flags 里额外带了 FLAG_NUMERIC / FLAG_NOPAD（由参数类型决定）。
fn emit_arg(
    fd: i32,
    body: []const u8,
    blen: usize,
    sign: u8,
    pfx: u64,
    flags: u64,
    width: usize,
) {
    let align = ((flags >> 16) & 255) as i32;
    let fill = ((flags >> 8) & 255) as u8;
    let zero = (flags & FLAG_ZERO) != 0;
    let numeric = (flags & FLAG_NUMERIC) != 0;
    let no_pad = (flags & FLAG_NOPAD) != 0;
    let plen = ((pfx >> 16) & 255) as usize;
    let p0 = (pfx & 255) as u8;
    let p1 = ((pfx >> 8) & 255) as u8;
    let mut used = blen + plen;
    if sign != 0 {
        used = used + 1;
    }
    if no_pad || width <= used {
        if sign != 0 {
            write_byte(fd, sign);
        }
        if plen > 0 {
            write_byte(fd, p0);
            if plen > 1 {
                write_byte(fd, p1);
            }
        }
        zr_write(fd, &body[0] as *const u8, blen);
        return;
    }
    let pad = width - used;
    // 只有数字的 `0` 标志才用 0 填充；字符串/字符/布尔都忽略它。
    let use_zero = zero && numeric;
    if use_zero {
        if sign != 0 {
            write_byte(fd, sign);
        }
        if plen > 0 {
            write_byte(fd, p0);
            if plen > 1 {
                write_byte(fd, p1);
            }
        }
        write_fill(fd, pad, b'0');
        zr_write(fd, &body[0] as *const u8, blen);
        return;
    }
    let eff_align: i32 = if align == ALIGN_DEFAULT {
        if numeric { ALIGN_RIGHT } else { ALIGN_LEFT }
    } else {
        align
    };
    if eff_align == ALIGN_LEFT {
        if sign != 0 {
            write_byte(fd, sign);
        }
        if plen > 0 {
            write_byte(fd, p0);
            if plen > 1 {
                write_byte(fd, p1);
            }
        }
        zr_write(fd, &body[0] as *const u8, blen);
        write_fill(fd, pad, fill);
    } else if eff_align == ALIGN_CENTER {
        let left = pad / 2;
        write_fill(fd, left, fill);
        if sign != 0 {
            write_byte(fd, sign);
        }
        if plen > 0 {
            write_byte(fd, p0);
            if plen > 1 {
                write_byte(fd, p1);
            }
        }
        zr_write(fd, &body[0] as *const u8, blen);
        write_fill(fd, pad - left, fill);
    } else {
        write_fill(fd, pad, fill);
        if sign != 0 {
            write_byte(fd, sign);
        }
        if plen > 0 {
            write_byte(fd, p0);
            if plen > 1 {
                write_byte(fd, p1);
            }
        }
        zr_write(fd, &body[0] as *const u8, blen);
    }
}

/// 按规格写出一个参数。
fn write_arg(fd: i32, arg: &FormatArg, flags0: u64, width: usize, prec: i32) {
    let kind = ((flags0 >> 24) & 255) as i32;
    let plus = (flags0 & FLAG_PLUS) != 0;
    let alt = (flags0 & FLAG_ALT) != 0;
    let mut flags = flags0;

    let mut body: [u8; 1024] = [0; 1024];

    if arg.kind == 0 {
        // 有符号整数
        let v: i64 = arg.int_value;
        let mut sign: u8 = 0;
        let mut pfx: u64 = 0;
        let mut blen: usize = 0;
        let mut numeric = true;
        if is_radix(kind) {
            let mut base: u64 = 16;
            let upper = kind == SPEC_HEX_UPPER;
            if kind == SPEC_BIN {
                base = 2;
            }
            if kind == SPEC_OCT {
                base = 8;
            }
            if alt {
                if base == 16 {
                    // Rust 的前缀恒为小写 `0x`，即使格式是 `{:#X}`
                    // （`format!("{:#X}", 255)` == "0xFF"）。早先这里跟着
                    // `X` 一起大写，输出 "0XFF"，与 Rust 不一致。
                    pfx = prefix_of(b'x');
                } else if base == 2 {
                    pfx = prefix_of(b'b');
                } else {
                    pfx = prefix_of(b'o');
                }
            }
            if plus {
                sign = b'+';
            }
            blen = put_radix(&mut body[0..1024], 0, v as u64, base, upper);
        } else {
            if v < 0 {
                sign = b'-';
                blen = put_uint_dec(&mut body[0..1024], 0, (0 - v) as u64);
            } else {
                if plus {
                    sign = b'+';
                }
                blen = put_uint_dec(&mut body[0..1024], 0, v as u64);
            }
        }
        if numeric { flags = flags | FLAG_NUMERIC; }
        emit_arg(fd, &body[0..blen], blen, sign, pfx, flags, width);
        return;
    }
    if arg.kind == 1 || arg.kind == 6 {
        // 无符号整数；kind 6 是 fmt_hex 的默认十六进制。
        let mut base: u64 = 10;
        let mut upper = false;
        if arg.kind == 6 {
            base = 16;
            upper = kind == SPEC_HEX_UPPER;
        } else if is_radix(kind) {
            base = 16;
            if kind == SPEC_HEX_UPPER {
                upper = true;
            } else if kind == SPEC_BIN {
                base = 2;
            } else if kind == SPEC_OCT {
                base = 8;
            }
        }
        let mut pfx: u64 = 0;
        if alt {
            if base == 16 {
                pfx = prefix_of(b'x');
            } else if base == 2 {
                pfx = prefix_of(b'b');
            } else if base == 8 {
                pfx = prefix_of(b'o');
            }
        }
        let sign: u8 = if plus { b'+' } else { 0 };
        let mut blen: usize = 0;
        if base == 10 {
            blen = put_uint_dec(&mut body[0..1024], 0, arg.int_value as u64);
        } else {
            blen = put_radix(&mut body[0..1024], 0, arg.int_value as u64, base, upper);
        }
        flags = flags | FLAG_NUMERIC;
        emit_arg(fd, &body[0..blen], blen, sign, pfx, flags, width);
        return;
    }
    if arg.kind == 2 {
        // 浮点：只把位模式传进 put_float_bits，避免浮点形参的 ABI 问题。
        let bits = arg.float_bits as u64;
        let ef = (bits >> 52) & 2047;
        let frac = bits & 4503599627370495;
        let nan = ef == 2047 && frac != 0;
        let mut sign: u8 = 0;
        if (bits >> 63) != 0 && !nan {
            sign = b'-';
        } else if plus {
            sign = b'+';
        }
        let blen = put_float_bits(
            &mut body[0..1024],
            0,
            bits & 9223372036854775807,
            prec,
            kind == SPEC_DEBUG,
        );
        flags = flags | FLAG_NUMERIC;
        emit_arg(fd, &body[0..blen], blen, sign, 0, flags, width);
        return;
    }
    if arg.kind == 3 {
        // 布尔
        let blen = if arg.int_value != 0 {
            put_str(&mut body[0..1024], 0, "true")
        } else {
            put_str(&mut body[0..1024], 0, "false")
        };
        emit_arg(fd, &body[0..blen], blen, 0, 0, flags, width);
        return;
    }
    if arg.kind == 4 {
        // 字符串
        let mut slen = arg.str_len;
        if prec >= 0 && (prec as usize) < slen {
            slen = prec as usize;
        }
        if kind == SPEC_DEBUG {
            // Rust 的 str Debug 不吃宽度/填充/对齐，只截断。
            let mut pos = 0;
            body[pos] = b'"';
            pos = pos + 1;
            pos = put_escaped(&mut body[0..1024], pos, arg.str_ptr, slen);
            body[pos] = b'"';
            pos = pos + 1;
            flags = flags | FLAG_NOPAD;
            emit_arg(fd, &body[0..pos], pos, 0, 0, flags, width);
        } else {
            let blen = put_bytes(&mut body[0..1024], 0, arg.str_ptr, slen);
            emit_arg(fd, &body[0..blen], blen, 0, 0, flags, width);
        }
        return;
    }
    if arg.kind == 5 {
        // 字符
        let c = arg.int_value as u8;
        let cp: *const u8 = &c as *const u8;
        if kind == SPEC_DEBUG {
            body[0] = b'\'';
            let pos = put_escaped(&mut body[0..1024], 1, cp, 1);
            body[pos] = b'\'';
            flags = flags | FLAG_NOPAD;
            emit_arg(fd, &body[0..(pos + 1)], pos + 1, 0, 0, flags, width);
        } else {
            body[0] = c;
            emit_arg(fd, &body[0..1], 1, 0, 0, flags, width);
        }
        return;
    }
    // 未知 kind：尽力按整数输出
    let blen = put_uint_dec(&mut body[0..1024], 0, arg.int_value as u64);
    flags = flags | FLAG_NUMERIC;
    emit_arg(fd, &body[0..blen], blen, 0, 0, flags, width);
}

fn prefix_of(c: u8) -> u64 {
    return (2u64 << 16) | ((c as u64) << 8) | (b'0' as u64);
}

//=============================================================================
// 简单打印
//=============================================================================

/// 打印一段字符串，不换行。
pub fn print(s: str) {
    zr_write(STDOUT_FD, s.ptr, s.len);
}

/// 打印一段字符串并换行。
pub fn println(s: str) {
    zr_write(STDOUT_FD, s.ptr, s.len);
    write_byte(STDOUT_FD, b'\n');
}

/// 打印一个字符，不换行。
pub fn print_char(c: char) {
    write_char(STDOUT_FD, c);
}

/// 打印一个字符并换行。
pub fn println_char(c: char) {
    write_char(STDOUT_FD, c);
    write_byte(STDOUT_FD, b'\n');
}

/// 打印一个十进制整数，不换行。
pub fn print_int(n: i64) {
    write_int(STDOUT_FD, n);
}

/// 打印一个十进制整数并换行。
pub fn println_int(n: i64) {
    write_int(STDOUT_FD, n);
    write_byte(STDOUT_FD, b'\n');
}

/// 打印一个无符号整数并换行。
pub fn println_uint(n: u64) {
    write_uint(STDOUT_FD, n);
    write_byte(STDOUT_FD, b'\n');
}

/// 打印一个浮点数并换行（Rust 的 Display 规则）。
pub fn println_float(n: f64) {
    write_float(STDOUT_FD, n);
    write_byte(STDOUT_FD, b'\n');
}

/// 打印一个布尔值。
pub fn print_bool(b: bool) {
    if b { print("true"); } else { print("false"); }
}

/// 打印一个十六进制整数。
pub fn print_hex_int(n: i64) {
    write_hex(STDOUT_FD, n as u64, false);
}

/// 向标准错误打印并换行。
pub fn eprintln(s: str) {
    zr_write(STDERR_FD, s.ptr, s.len);
    write_byte(STDERR_FD, b'\n');
}

/// 向标准错误打印（无换行）。
pub fn eprint(s: str) {
    zr_write(STDERR_FD, s.ptr, s.len);
}

//=============================================================================
// 输入
//=============================================================================

/// 从标准输入读一段字节，返回读到的字节数（0 表示 EOF）。
///
/// 读到 EOF 或者出错时返回 0。
pub fn read_bytes(buf: *mut u8, cap: usize) -> usize {
    if cap == 0 {
        return 0;
    }
    let n = zr_read(STDIN_FD, buf, cap);
    if n <= 0 {
        return 0;
    }
    return n as usize;
}

/// 从标准输入读一行（去掉行尾的 `\r\n` 或 `\n`），返回读到的字节数。
///
/// 缓冲区不够时截断（剩下的部分留在输入里）。
pub fn read_line(buf: *mut u8, cap: usize) -> usize {
    let mut n = 0;
    let mut one: [u8; 1] = [0; 1];
    while n < cap {
        let got = zr_read(STDIN_FD, &one[0] as *const u8 as *mut u8, 1);
        if got <= 0 {
            break;
        }
        if one[0] == b'\n' {
            break;
        }
        buf[n] = one[0];
        n = n + 1;
    }
    // 去掉行尾的 `\r`
    if n > 0 && buf[n - 1] == b'\r' {
        n = n - 1;
    }
    return n;
}

/// 从标准输入读一行，丢掉换行符，**返回长度**。
///
/// 与 `read_line` 相同，只是名字更贴近 Rust 的 `read_line`。
pub fn stdin_read_line(buf: *mut u8, cap: usize) -> usize {
    return read_line(buf, cap);
}

//=============================================================================
// 文件
//=============================================================================

/// 打开一个文件，返回文件描述符；出错时返回 -1。
///
/// 路径以 NUL 结尾（Rust 的 `CString` 惯例）。`mode`：
/// 0 = 只读，1 = 写（存在则截断），2 = 追加。
pub fn file_open(path: str, mode: i32) -> i32 {
    // 运行时要求 NUL 结尾：临时拼一份。
    let mut buf: [u8; 1024] = [0; 1024];
    if path.len >= 1024 {
        return -1;
    }
    let mut i = 0;
    while i < path.len {
        buf[i] = path.ptr[i];
        i = i + 1;
    }
    buf[path.len] = 0;
    let fd = zr_open(&buf[0] as *const u8, mode);
    if fd < 0 {
        return -1;
    }
    return fd as i32;
}

/// 读文件。返回读到的字节数，0 表示 EOF，出错返回 -1。
pub fn file_read(fd: i32, buf: *mut u8, cap: usize) -> isize {
    return zr_read(fd, buf, cap);
}

/// 写文件。返回写入的字节数，出错返回 -1。
pub fn file_write(fd: i32, bytes: str) -> isize {
    return zr_write(fd, bytes.ptr, bytes.len);
}

/// 关闭文件。成功返回 true。
pub fn file_close(fd: i32) -> bool {
    if fd < 0 {
        return false;
    }
    return zr_close(fd) == 0;
}

/// 读整个文件的内容，返回读到的字节数。
///
/// 内容写进 `buf`；文件比 `buf` 大时只读前 `cap` 字节。
pub fn file_read_all(fd: i32, buf: *mut u8, cap: usize) -> usize {
    let mut total = 0;
    while total < cap {
        let n = zr_read(fd, &buf[total] as *const u8 as *mut u8, cap - total);
        if n <= 0 {
            break;
        }
        total = total + (n as usize);
    }
    return total;
}

/// 移动文件位置。`whence`：`SEEK_SET`（起点）/ `SEEK_CUR`（当前）/
/// `SEEK_END`（末尾）。
///
/// `offset` 是字节数，可以为负（`SEEK_CUR` / `SEEK_END` 时表示往回退）。
/// 返回移动后的位置，出错返回 -1。
pub fn file_seek(fd: i32, offset: i64, whence: i32) -> i64 {
    return zr_seek(fd, offset, whence);
}

/// 取文件的大小（字节）。出错返回 -1。
///
/// 对终端这类没有大小的设备返回 -1。
pub fn file_size(fd: i32) -> i64 {
    return zr_fstat_size(fd);
}

/// 文件描述符是不是终端。是终端返回 true。
pub fn file_is_terminal(fd: i32) -> bool {
    return zr_isatty(fd) != 0;
}

/// 把一段字节全部写完，返回写入的总字节数。
///
/// 写了一半出错时返回已经写进去的字节数（一个字节都没写成就是 0）。
pub fn file_write_all(fd: i32, bytes: str) -> usize {
    let mut total: usize = 0;
    while total < bytes.len {
        let n = zr_write(fd, bytes.ptr + total, bytes.len - total);
        if n <= 0 {
            break;
        }
        total = total + (n as usize);
    }
    return total;
}

/// 以追加方式打开文件，返回文件描述符；出错返回 -1。
///
/// 相当于 `file_open(path, 2)`：文件不存在则创建，存在则接着写。
pub fn file_append_open(path: str) -> i32 {
    return file_open(path, 2);
}

/// 打开文件时的模式。
pub const FILE_READ: i32 = 0;
/// 打开文件时的模式：写（存在则截断）。
pub const FILE_WRITE: i32 = 1;
/// 打开文件时的模式：追加。
pub const FILE_APPEND: i32 = 2;

/// `file_seek` 的基准点：文件开头。
pub const SEEK_SET: i32 = 0;
/// `file_seek` 的基准点：当前位置。
pub const SEEK_CUR: i32 = 1;
/// `file_seek` 的基准点：文件末尾。
pub const SEEK_END: i32 = 2;

//=============================================================================
// 文件对象
//=============================================================================

/// 一个已经打开的文件。
///
/// 只是"文件描述符 + 一点便利方法"：不做缓冲，也不负责在析构时关闭。
/// 用 `close` 显式关闭。
pub struct File {
    /// 文件描述符；打开失败时是 -1。
    pub fd: i32,
}

impl File {
    /// 打开文件。`mode`：`FILE_READ` / `FILE_WRITE` / `FILE_APPEND`。
    ///
    /// 打开失败时 `fd` 是 -1，用 `is_ok` 判断。
    pub fn open(path: str, mode: i32) -> File {
        return File { fd: file_open(path, mode) };
    }

    /// 以追加方式打开文件（不存在则创建）。
    pub fn open_append(path: str) -> File {
        return File { fd: file_append_open(path) };
    }

    /// 打开成功了吗。
    pub fn is_ok(&self) -> bool {
        return self.fd >= 0;
    }

    /// 读一段字节，返回读到的字节数（0 表示 EOF，出错返回 -1）。
    pub fn read(&self, buf: *mut u8, cap: usize) -> isize {
        return file_read(self.fd, buf, cap);
    }

    /// 写一段字节，返回写入的字节数（出错返回 -1）。
    pub fn write(&self, bytes: str) -> isize {
        return file_write(self.fd, bytes);
    }

    /// 把一段字节全部写完，返回写入的总字节数。
    pub fn write_all(&self, bytes: str) -> usize {
        return file_write_all(self.fd, bytes);
    }

    /// 关闭文件。成功返回 true。
    pub fn close(&self) -> bool {
        return file_close(self.fd);
    }

    /// 移动文件位置。`whence`：`SEEK_SET` / `SEEK_CUR` / `SEEK_END`。
    ///
    /// 返回移动后的位置，出错返回 -1。
    pub fn seek(&self, offset: i64, whence: i32) -> i64 {
        return file_seek(self.fd, offset, whence);
    }

    /// 文件的大小（字节），出错返回 -1。
    pub fn size(&self) -> i64 {
        return file_size(self.fd);
    }

    /// 是不是终端。
    pub fn is_terminal(&self) -> bool {
        return file_is_terminal(self.fd);
    }
}
