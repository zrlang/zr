//=============================================================================
// std/env.zr — 环境变量
//
// 初值来自进程入口的 envp（由运行时 `zr_args_init` 记下，见 std/cli.zr）。
// 读取直接扫描这份只读数据；写入进入本模块自己的**覆盖表**，不修改父进程
// 的环境，也不影响已经启动的子进程。
//
//   env::var(key)            -> Option<String>
//   env::var_or(key, d)      -> String
//   env::has_var(key)        -> bool
//   env::set_var(key, value) -> bool
//   env::remove_var(key)     -> bool
//
// 覆盖表用一个堆上的 `*const u8` 数组保存，每项是 C 字符串：
//   "KEY=VALUE" 表示设置，只有 "KEY"（没有 '='）表示删除（墓碑）。
// 查找**从后往前**扫覆盖表，因此后写优先；遇到墓碑立即视为未设置。
//=============================================================================

use core::{Option, zr_alloc, zr_realloc};
use string::String;

extern "C" {
    fn zr_env_count() -> usize;
    fn zr_env_entry(i: usize) -> *const u8;
}

/// 覆盖表（堆上的 C 字符串指针数组）。
static mut ENV_OVERRIDES: *mut *const u8 = 0 as *mut *const u8;
static mut ENV_OVERRIDE_COUNT: usize = 0;
static mut ENV_OVERRIDE_CAP: usize = 0;

const ENV_MAX_KEY: usize = 256;
const ENV_MAX_VALUE: usize = 1024;

//----- 小工具 ----------------------------------------------------------------

/// 把 `s` 复制进 `buf` 并补 NUL；放不下返回 false。
fn env_to_cstr(s: str, buf: *mut u8, cap: usize) -> bool {
    if s.len >= cap {
        return false;
    }
    let mut i = 0;
    while i < s.len {
        buf[i] = s.ptr[i];
        i = i + 1;
    }
    buf[s.len] = 0;
    return true;
}

/// 判断 `entry` 与 `key`（长度 `key_len`）的关系：
///   1 = entry 是 "key=..."；2 = entry 恰好是 "key"（墓碑）；0 = 不匹配。
fn env_key_state(entry: *const u8, key: *const u8, key_len: usize) -> i32 {
    if entry == 0 as *const u8 {
        return 0;
    }
    let mut i = 0;
    while i < key_len {
        if entry[i] != key[i] {
            return 0;
        }
        i = i + 1;
    }
    let c = entry[key_len];
    if c == 61 {
        return 1;
    }
    if c == 0 {
        return 2;
    }
    return 0;
}

/// 覆盖表里与 `key` 有关的最后一项：返回 0 = 没有、1 = 设置、2 = 墓碑。
fn env_override_state(key: *const u8, key_len: usize) -> i32 {
    let count = ENV_OVERRIDE_COUNT;
    let arr = ENV_OVERRIDES;
    if count == 0 || arr == 0 as *mut *const u8 {
        return 0;
    }
    let mut i = count;
    while i > 0 {
        i = i - 1;
        let state = env_key_state(arr[i], key, key_len);
        if state != 0 {
            return state;
        }
    }
    return 0;
}

/// 覆盖表里与 `key` 有关的最后一项的值指针（调用方保证 state == 1）。
fn env_override_value(key: *const u8, key_len: usize) -> *const u8 {
    let count = ENV_OVERRIDE_COUNT;
    let arr = ENV_OVERRIDES;
    let mut i = count;
    while i > 0 {
        i = i - 1;
        if env_key_state(arr[i], key, key_len) == 1 {
            return (arr[i] as usize + key_len + 1) as *const u8;
        }
    }
    return 0 as *const u8;
}

/// 在入口 envp 里找 "key=..."，返回值的指针；没有返回 null。
fn env_initial_value(key: *const u8, key_len: usize) -> *const u8 {
    let n = zr_env_count();
    let mut i: usize = 0;
    while i < n {
        let entry = zr_env_entry(i);
        if env_key_state(entry, key, key_len) == 1 {
            return (entry as usize + key_len + 1) as *const u8;
        }
        i = i + 1;
    }
    return 0 as *const u8;
}

/// 保证覆盖表还能再放一项。
fn env_reserve_override() {
    if ENV_OVERRIDE_COUNT < ENV_OVERRIDE_CAP {
        return;
    }
    let mut new_cap = if ENV_OVERRIDE_CAP == 0 { 8 } else { ENV_OVERRIDE_CAP * 2 };
    if new_cap > 4096 {
        new_cap = 4096;
    }
    let old_size = ENV_OVERRIDE_CAP * 8;
    let new_size = new_cap * 8;
    let p = zr_realloc(ENV_OVERRIDES as *mut void, old_size, new_size, 8) as *mut *const u8;
    ENV_OVERRIDES = p;
    ENV_OVERRIDE_CAP = new_cap;
}

/// 把一项 C 字符串挂进覆盖表。
fn env_push_override(p: *const u8) {
    env_reserve_override();
    let arr = ENV_OVERRIDES;
    arr[ENV_OVERRIDE_COUNT] = p;
    ENV_OVERRIDE_COUNT = ENV_OVERRIDE_COUNT + 1;
}

/// key 是否合法（非空、不含 '='、不含 NUL）。
fn env_key_ok(key: str) -> bool {
    if key.len == 0 || key.len >= ENV_MAX_KEY {
        return false;
    }
    let mut i = 0;
    while i < key.len {
        if key.ptr[i] == 61 || key.ptr[i] == 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

//----- 公开 API --------------------------------------------------------------

/// 读取环境变量；不存在（或被 `remove_var` 删除）返回 None。
pub fn var(key: str) -> Option<String> {
    if !env_key_ok(key) {
        return Option::None;
    }
    let state = env_override_state(key.ptr, key.len);
    if state == 2 {
        return Option::None;
    }
    if state == 1 {
        let p = env_override_value(key.ptr, key.len);
        if p == 0 as *const u8 {
            return Option::None;
        }
        return Option::Some(String::from_cstr(p));
    }
    let p = env_initial_value(key.ptr, key.len);
    if p == 0 as *const u8 {
        return Option::None;
    }
    return Option::Some(String::from_cstr(p));
}

/// 读取环境变量；不存在时返回 `default`。
pub fn var_or(key: str, default: str) -> String {
    match var(key) {
        Option::Some(v) => {
            return v;
        }
        Option::None => {
            return String::from_bytes(default);
        }
    }
}

/// 环境变量是否存在。
pub fn has_var(key: str) -> bool {
    match var(key) {
        Option::Some(_) => {
            return true;
        }
        Option::None => {
            return false;
        }
    }
}

/// 设置环境变量（只影响本进程的覆盖表）。key 为空或含 '=' 时返回 false。
pub fn set_var(key: str, value: str) -> bool {
    if !env_key_ok(key) || value.len >= ENV_MAX_VALUE {
        return false;
    }
    let mut i = 0;
    while i < value.len {
        if value.ptr[i] == 0 {
            return false;
        }
        i = i + 1;
    }
    let total = key.len + 1 + value.len + 1;
    let buf = zr_alloc(total, 1) as *mut u8;
    let mut k = 0;
    while k < key.len {
        buf[k] = key.ptr[k];
        k = k + 1;
    }
    buf[key.len] = 61; // '='
    let mut v = 0;
    while v < value.len {
        buf[key.len + 1 + v] = value.ptr[v];
        v = v + 1;
    }
    buf[key.len + 1 + value.len] = 0;
    env_push_override(buf as *const u8);
    return true;
}

/// 删除环境变量（写一条墓碑项，遮蔽入口 envp 里的旧值）。
pub fn remove_var(key: str) -> bool {
    if !env_key_ok(key) {
        return false;
    }
    let buf = zr_alloc(key.len + 1, 1) as *mut u8;
    let mut i = 0;
    while i < key.len {
        buf[i] = key.ptr[i];
        i = i + 1;
    }
    buf[key.len] = 0;
    env_push_override(buf as *const u8);
    return true;
}
