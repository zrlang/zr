//=============================================================================
// std/net.zr — 套接字、地址族与网络 I/O
//
// zr 的网络库通过 `extern "C"` 对接 Linux 的 BSD 套接字 API（socket / bind /
// connect / listen / accept / send / recv 等），并在其上构建 TCP / UDP 流式
// 抽象与异步适配层。
//
// 设计参考：
// - Rust：`std::net` 把 SocketAddr / TcpStream / TcpListener / UdpSocket 分为
//   不可克隆的句柄类型，所有权即连接生命周期。
// - Zig：`std.net` 把 Address / Stream / Server 做成 comptime 可配置后端
//   （epoll / kqueue / io_uring / WASI），zr 采用类似的 trait 抽象。
// - Python：`socket` 模块的 AF_INET / SOCK_STREAM 常量与 getaddrinfo 语义。
//
// 线程安全：本模块所有类型均非线程安全；并发访问需由调用者加锁。
//=============================================================================

use collections::Vec;
use core::{
    Option, Result, panic,
    zr_alloc, zr_dealloc,
};
use io::{write_bytes, write_byte, print_int, println};
use mem::{memcmp, NULL, offset};
use slice::Slice;

//=============================================================================
// 外部运行时（由编译器/运行时对接 libc / Linux 系统调用）
//=============================================================================

/// 创建套接字。成功返回非负 fd，失败返回 -1。
/// 签名：socket(domain, type, protocol) -> fd
extern "C" {
    fn zr_socket(domain: i32, sock_type: i32, protocol: i32) -> i32;
}

/// 绑定地址到套接字。成功返回 0，失败返回 -1。
extern "C" {
    fn zr_bind(fd: i32, addr: *const SockAddrStorage, addrlen: u32) -> i32;
}

/// 连接远程地址。成功返回 0，失败返回 -1（非阻塞时可能返回 -EINPROGRESS）。
extern "C" {
    fn zr_connect(fd: i32, addr: *const SockAddrStorage, addrlen: u32) -> i32;
}

/// 监听套接字。成功返回 0，失败返回 -1。
extern "C" {
    fn zr_listen(fd: i32, backlog: i32) -> i32;
}

/// 接受新连接。成功返回新 fd，失败返回 -1。
extern "C" {
    fn zr_accept(fd: i32, addr: *mut SockAddrStorage, addrlen: *mut u32) -> i32;
}

/// 接收数据。返回读取的字节数，0 表示对端关闭，-1 表示出错。
extern "C" {
    fn zr_recv(fd: i32, buf: *mut u8, len: usize, flags: i32) -> isize;
}

/// 发送数据。返回写入的字节数，-1 表示出错。
extern "C" {
    fn zr_send(fd: i32, buf: *const u8, len: usize, flags: i32) -> isize;
}

/// 关闭文件描述符。
extern "C" {
    fn zr_close(fd: i32) -> i32;
}

/// 设置套接字选项（SOL_SOCKET 层级）。
extern "C" {
    fn zr_setsockopt(fd: i32, level: i32, optname: i32, optval: *const u8, optlen: u32) -> i32;
}

/// 获取套接字错误状态。
extern "C" {
    fn zr_getsockopt(fd: i32, level: i32, optname: i32, optval: *mut u8, optlen: *mut u32) -> i32;
}

/// 将主机名 + 服务名解析为地址列表（POSIX getaddrinfo）。
/// 返回指向 addrinfo 链表的指针，调用者需用 zr_freeaddrinfo 释放。
extern "C" {
    fn zr_getaddrinfo(node: *const u8, service: *const u8, hints: *const AddrInfoHints, res: *mut *mut AddrInfo) -> i32;
}

/// 释放 zr_getaddrinfo 返回的链表。
extern "C" {
    fn zr_freeaddrinfo(res: *mut AddrInfo);
}

/// 将二进制地址转为可读字符串（POSIX inet_ntop）。
extern "C" {
    fn zr_inet_ntop(af: i32, src: *const u8, dst: *mut u8, size: u32) -> i32;
}

/// 将字符串地址转为二进制（POSIX inet_pton）。成功返回 1。
extern "C" {
    fn zr_inet_pton(af: i32, src: *const u8, dst: *mut u8) -> i32;
}

/// 主机字节序转网络字节序（16 位）。
extern "C" {
    fn zr_htons(hostshort: u16) -> u16;
}

/// 网络字节序转主机字节序（16 位）。
extern "C" {
    fn zr_ntohs(netshort: u16) -> u16;
}

/// 主机字节序转网络字节序（32 位）。
extern "C" {
    fn zr_htonl(hostlong: u32) -> u32;
}

/// 网络字节序转主机字节序（32 位）。
extern "C" {
    fn zr_ntohl(netlong: u32) -> u32;
}

/// 设置文件描述符为非阻塞模式。
extern "C" {
    fn zr_set_nonblocking(fd: i32, nonblocking: bool) -> i32;
}

/// 获取错误码（errno）。
extern "C" {
    fn zr_errno() -> i32;
}

//=============================================================================
// 地址族（Address Family）常量
//=============================================================================

/// POSIX 地址族。
pub mod af {
    /// 本地回环 / 进程间通信。
    pub const UNIX: i32 = 1;
    /// IPv4。
    pub const INET: i32 = 2;
    /// IPv6。
    pub const INET6: i32 = 10;
    /// 数据包（无连接）。
    pub const PACKET: i32 = 17;
}

/// 套接字类型。
pub mod sock_type {
    /// 有序、可靠、双向、基于连接的字节流（TCP）。
    pub const STREAM: i32 = 1;
    /// 无连接、不可靠的数据报（UDP）。
    pub const DGRAM: i32 = 2;
    /// 原始套接字（需 CAP_NET_RAW）。
    pub const RAW: i32 = 3;
    /// 可靠的数据报（SCTP 等）。
    pub const SEQPACKET: i32 = 5;
}

/// 协议号。
pub mod protocol {
    /// 自动选择（0 = 由 domain + type 推导）。
    pub const AUTO: i32 = 0;
    /// TCP。
    pub const TCP: i32 = 6;
    /// UDP。
    pub const UDP: i32 = 17;
}

/// 套接字选项层级。
pub mod sol {
    /// 套接字层选项。
    pub const SOCKET: i32 = 1;
}

/// 套接字选项名。
pub mod so {
    /// 允许重用本地地址（TIME_WAIT 复用）。
    pub const REUSEADDR: i32 = 2;
    /// 保持连接探测。
    pub const KEEPALIVE: i32 = 9;
    /// 禁用 Nagle 算法（降低小包延迟）。
    pub const NODELAY: i32 = 1; // TCP_NODELAY 在 IPPROTO_TCP 层
    /// 发送缓冲区大小。
    pub const SNDBUF: i32 = 7;
    /// 接收缓冲区大小。
    pub const RCVBUF: i32 = 8;
    /// 优雅关闭的延迟时间（linger）。
    pub const LINGER: i32 = 13;
}

/// IP 协议层级（用于 setsockopt）。
pub mod ipproto {
    pub const IP: i32 = 0;
    pub const TCP: i32 = 6;
    pub const UDP: i32 = 17;
    /// 仅 IPv6。
    pub const IPV6: i32 = 41;
}

/// TCP 层选项名。
pub mod tcp {
    /// 禁用 Nagle 算法。
    pub const NODELAY: i32 = 1;
    /// 快速打开（TFO）。
    pub const FASTOPEN: i32 = 23;
    /// 保活探测间隔。
    pub const KEEPINTVL: i32 = 5;
    /// 保活探测次数。
    pub const KEEPCNT: i32 = 6;
    /// 保活空闲时间。
    pub const KEEPIDLE: i32 = 4;
}

/// 发送/接收标志。
pub mod msg {
    /// 不等待所有数据，有多少发多少。
    pub const DONTWAIT: i32 = 0x40;
    /// 发送带外数据。
    pub const OOB: i32 = 0x01;
    /// 发送后不路由（多用于原始套接字）。
    pub const DONTROUTE: i32 = 0x04;
}

/// 常见的 getaddrinfo 标志。
pub mod aiflags {
    pub const PASSIVE: i32 = 0x0001;
    pub const CANONNAME: i32 = 0x0002;
    pub const NUMERICHOST: i32 = 0x0004;
    pub const NUMERICSERV: i32 = 0x0400;
    pub const V4MAPPED: i32 = 0x0008;
    pub const ALL: i32 = 0x0010;
    pub const ADDRCONFIG: i32 = 0x0020;
}

//=============================================================================
// SocketAddr — 网络地址
//=============================================================================

/// 套接字地址族标签，用于在 SockAddr 中做带标签的联合。
pub enum AddrFamily {
    /// IPv4（AF_INET）。
    V4,
    /// IPv6（AF_INET6）。
    V6,
}

/// IPv4 地址（4 字节大端序）。
pub struct Ipv4Addr {
    pub octets: [u8; 4],
}

impl Ipv4Addr {
    /// 从四个字节构造。
    pub fn new(a: u8, b: u8, c: u8, d: u8) -> Ipv4Addr {
        return Ipv4Addr { octets: [a, b, c, d] };
    }

    /// 回环地址 127.0.0.1。
    pub fn localhost() -> Ipv4Addr {
        return Ipv4Addr { octets: [127, 0, 0, 1] };
    }

    /// 任意地址 0.0.0.0。
    pub fn any() -> Ipv4Addr {
        return Ipv4Addr { octets: [0, 0, 0, 0] };
    }

    /// 广播地址 255.255.255.255。
    pub fn broadcast() -> Ipv4Addr {
        return Ipv4Addr { octets: [255, 255, 255, 255] };
    }

    /// 判断是否为回环地址。
    pub fn is_loopback(self) -> bool {
        return self.octets[0] == 127;
    }

    /// 判断是否为私有地址（RFC 1918）。
    pub fn is_private(self) -> bool {
        if self.octets[0] == 10 { return true; }
        if self.octets[0] == 172 && self.octets[1] >= 16 && self.octets[1] <= 31 { return true; }
        if self.octets[0] == 192 && self.octets[1] == 168 { return true; }
        return false;
    }

    /// 判断是否为多播地址（224.0.0.0/4）。
    pub fn is_multicast(self) -> bool {
        return self.octets[0] >= 224 && self.octets[0] <= 239;
    }

    /// 判断是否为全局可路由的公有地址。
    pub fn is_global(self) -> bool {
        return !self.is_loopback() && !self.is_private() && !self.is_multicast();
    }

    /// 按网络字节序打包为 u32。
    pub fn to_u32(self) -> u32 {
        let o = self.octets;
        return (o[0] as u32) << 24
             | (o[1] as u32) << 16
             | (o[2] as u32) << 8
             | (o[3] as u32);
    }

    /// 从网络字节序 u32 解包。
    pub fn from_u32(v: u32) -> Ipv4Addr {
        return Ipv4Addr {
            octets: [
                (v >> 24) as u8,
                (v >> 16) as u8,
                (v >> 8) as u8,
                v as u8,
            ],
        };
    }
}

/// IPv6 地址（16 字节）。
pub struct Ipv6Addr {
    pub segments: [u16; 8],
}

impl Ipv6Addr {
    /// 回环地址 ::1。
    pub fn localhost() -> Ipv6Addr {
        return Ipv6Addr {
            segments: [0, 0, 0, 0, 0, 0, 0, 1],
        };
    }

    /// 未指定地址 ::。
    pub fn unspecified() -> Ipv6Addr {
        return Ipv6Addr {
            segments: [0; 8],
        };
    }

    /// 判断是否为回环地址。
    pub fn is_loopback(self) -> bool {
        let mut all_zero = true;
        let mut i = 0;
        while i < 7 {
            if self.segments[i] != 0 { all_zero = false; }
            i = i + 1;
        }
        return all_zero && self.segments[7] == 1;
    }

    /// 判断是否为 IPv4 映射地址（::ffff:a.b.c.d）。
    pub fn is_ipv4_mapped(self) -> bool {
        let mut prefix_zero = true;
        let mut i = 0;
        while i < 5 {
            if self.segments[i] != 0 { prefix_zero = false; }
            i = i + 1;
        }
        return prefix_zero && self.segments[5] == 0xffff;
    }

    /// 从 IPv4 映射地址中提取 IPv4 部分。
    pub fn to_ipv4(self) -> Option<Ipv4Addr> {
        if !self.is_ipv4_mapped() { return Option::None; }
        let last = self.segments[7];
        return Option::Some(Ipv4Addr {
            octets: [
                (last >> 8) as u8,
                last as u8,
                0, 0,
            ],
        });
    }
}

/// 通用的套接字地址存储（结构体对齐到 28 字节，兼容 sockaddr_storage）。
/// 布局：第 0 字节 = 家族标签（0=V4, 1=V6），后续为地址字节与端口。
#[repr(C, align = 4)]
pub struct SockAddrStorage {
    /// 第 0 字节：0 = V4，1 = V6。
    pub family: u8,
    /// 填充。
    pub _pad0: u8,
    /// 端口（网络字节序）。
    pub port: u16,
    /// 地址字节（V4 用前 4 字节，V6 用前 16 字节）。
    pub addr: [u8; 24],
}

/// 一个完整的套接字地址（家族 + 地址 + 端口）。
pub enum SocketAddr {
    /// IPv4 地址与端口。
    V4(Ipv4Addr, u16),
    /// IPv6 地址、端口与流信息。
    V6(Ipv6Addr, u16),
}

impl SocketAddr {
    /// 构造 IPv4 地址。
    pub fn v4(addr: Ipv4Addr, port: u16) -> SocketAddr {
        return SocketAddr::V4(addr, port);
    }

    /// 构造 IPv6 地址。
    pub fn v6(addr: Ipv6Addr, port: u16) -> SocketAddr {
        return SocketAddr::V6(addr, port);
    }

    /// 返回端口号。
    pub fn port(self) -> u16 {
        match self {
            SocketAddr::V4(_, p) => return p,
            SocketAddr::V6(_, p) => return p,
        }
    }

    /// 判断是否为 IPv4。
    pub fn is_ipv4(self) -> bool {
        match self {
            SocketAddr::V4(_, _) => return true,
            SocketAddr::V6(_, _) => return false,
        }
    }

    /// 判断是否为 IPv6。
    pub fn is_ipv6(self) -> bool {
        return !self.is_ipv4();
    }

    /// 序列化为 SockAddrStorage（用于系统调用）。
    pub fn to_storage(self, out: *mut SockAddrStorage) {
        match self {
            SocketAddr::V4(v4, port) => {
                {
                    (*out).family = 0;
                    (*out).port = zr_htons(port);
                    let mut i = 0;
                    while i < 4 {
                        (*out).addr[i] = v4.octets[i];
                        i = i + 1;
                    }
                }
            }
            SocketAddr::V6(v6, port) => {
                {
                    (*out).family = 1;
                    (*out).port = zr_htons(port);
                    let mut i = 0;
                    while i < 8 {
                        let b0 = (v6.segments[i] >> 8) as u8;
                        let b1 = v6.segments[i] as u8;
                        (*out).addr[i * 2] = b0;
                        (*out).addr[i * 2 + 1] = b1;
                        i = i + 1;
                    }
                }
            }
        }
    }

    /// 从 SockAddrStorage 反序列化。
    pub fn from_storage(s: *const SockAddrStorage) -> Option<SocketAddr> {
        {
            let fam = (*s).family;
            let port = zr_ntohs((*s).port);
            if fam == 0 {
                let a = (*s).addr;
                return Option::Some(SocketAddr::V4(
                    Ipv4Addr::new(a[0], a[1], a[2], a[3]),
                    port,
                ));
            } else if fam == 1 {
                let mut segs: [u16; 8] = [0; 8];
                let mut i = 0;
                while i < 8 {
                    segs[i] = ((*s).addr[i * 2] as u16) << 8
                            | (*s).addr[i * 2 + 1] as u16;
                    i = i + 1;
                }
                return Option::Some(SocketAddr::V6(Ipv6Addr { segments: segs }, port));
            }
            return Option::None;
        }
    }

    /// 返回地址族标签。
    pub fn family(self) -> AddrFamily {
        match self {
            SocketAddr::V4(_, _) => return AddrFamily::V4,
            SocketAddr::V6(_, _) => return AddrFamily::V6,
        }
    }
}

//=============================================================================
// AddrInfo — getaddrinfo 结果节点
//=============================================================================

/// getaddrinfo 返回的单个地址信息节点（C 端链表，由运行时分配）。
#[repr(C)]
pub struct AddrInfo {
    /// AI 标志（aiflags）。
    pub flags: i32,
    /// 地址族（af）。
    pub family: i32,
    /// 套接字类型（sock_type）。
    pub sock_type: i32,
    /// 协议号。
    pub protocol: i32,
    /// 地址长度。
    pub addrlen: u32,
    /// 规范名（可为 null）。
    pub canonname: *const u8,
    /// 指向 SockAddrStorage 的指针。
    pub addr: *const SockAddrStorage,
    /// 下一个节点。
    pub next: *mut AddrInfo,
}

/// getaddrinfo 的提示结构。
#[repr(C)]
pub struct AddrInfoHints {
    pub flags: i32,
    pub family: i32,
    pub sock_type: i32,
    pub protocol: i32,
}

impl AddrInfoHints {
    /// 构造一个空提示。
    pub fn none() -> AddrInfoHints {
        return AddrInfoHints {
            flags: 0, family: 0, sock_type: 0, protocol: 0,
        };
    }

    /// 仅请求 IPv4 地址。
    pub fn v4() -> AddrInfoHints {
        return AddrInfoHints {
            flags: 0,
            family: af::INET,
            sock_type: 0,
            protocol: 0,
        };
    }

    /// 仅请求 IPv6 地址。
    pub fn v6() -> AddrInfoHints {
        return AddrInfoHints {
            flags: 0,
            family: af::INET6,
            sock_type: 0,
            protocol: 0,
        };
    }
}

//=============================================================================
// Socket — 通用套接字句柄
//=============================================================================

/// 一个套接字文件描述符的拥有者。
/// 当 `Socket` 被丢弃时，fd 会被自动关闭。
pub struct Socket {
    /// 文件描述符（非负为有效）。
    pub fd: i32,
    /// 地址族。
    pub family: AddrFamily,
    /// 套接字类型。
    pub sock_type: i32,
}

impl Socket {
    /// 创建一个新套接字。
    pub fn new(family: AddrFamily, stype: i32, proto: i32) -> Result<Socket, NetError> {
        let dom = match family {
            AddrFamily::V4 => af::INET,
            AddrFamily::V6 => af::INET6,
        };
        let fd = zr_socket(dom, stype, proto);
        if fd < 0 {
            return Result::Err(NetError::from_errno());
        }
        return Result::Ok(Socket {
            fd,
            family,
            sock_type: stype,
        });
    }

    /// 返回文件描述符。
    pub fn fd(self) -> i32 {
        return self.fd;
    }

    /// 把 fd 设置为非阻塞模式。
    pub fn set_nonblocking(self: &mut Socket, on: bool) -> Result<(), NetError> {
        if zr_set_nonblocking(self.fd, on) < 0 {
            return Result::Err(NetError::from_errno());
        }
        return Result::Ok(());
    }

    /// 设置 SO_REUSEADDR，允许端口复用（常用于服务器快速重启）。
    pub fn set_reuse_address(self: &mut Socket, reuse: bool) -> Result<(), NetError> {
        let v: i32 = if reuse { 1 } else { 0 };
        if zr_setsockopt(self.fd, sol::SOCKET, so::REUSEADDR, &v as *const i32 as *const u8, 4) < 0 {
            return Result::Err(NetError::from_errno());
        }
        return Result::Ok(());
    }

    /// 设置 TCP_NODELAY，禁用 Nagle 算法。
    pub fn set_nodelay(self: &mut Socket, on: bool) -> Result<(), NetError> {
        let v: i32 = if on { 1 } else { 0 };
        if zr_setsockopt(self.fd, ipproto::TCP, tcp::NODELAY, &v as *const i32 as *const u8, 4) < 0 {
            return Result::Err(NetError::from_errno());
        }
        return Result::Ok(());
    }

    /// 设置 SO_KEEPALIVE。
    pub fn set_keepalive(self: &mut Socket, on: bool) -> Result<(), NetError> {
        let v: i32 = if on { 1 } else { 0 };
        if zr_setsockopt(self.fd, sol::SOCKET, so::KEEPALIVE, &v as *const i32 as *const u8, 4) < 0 {
            return Result::Err(NetError::from_errno());
        }
        return Result::Ok(());
    }

    /// 设置发送缓冲区大小。
    pub fn set_send_buffer(self: &mut Socket, size: usize) -> Result<(), NetError> {
        let v = size as i32;
        if zr_setsockopt(self.fd, sol::SOCKET, so::SNDBUF, &v as *const i32 as *const u8, 4) < 0 {
            return Result::Err(NetError::from_errno());
        }
        return Result::Ok(());
    }

    /// 设置接收缓冲区大小。
    pub fn set_recv_buffer(self: &mut Socket, size: usize) -> Result<(), NetError> {
        let v = size as i32;
        if zr_setsockopt(self.fd, sol::SOCKET, so::RCVBUF, &v as *const i32 as *const u8, 4) < 0 {
            return Result::Err(NetError::from_errno());
        }
        return Result::Ok(());
    }

    /// 绑定到指定地址。
    pub fn bind(self: &Socket, addr: SocketAddr) -> Result<(), NetError> {
        let storage = SockAddrStorage {
            family: 0, port: 0, _pad0: 0, addr: [0; 24],
        };
        let mut s = storage;
        addr.to_storage(&mut s);
        let addrlen: u32 = match addr.family() {
            AddrFamily::V4 => 16,  // sizeof(sockaddr_in)
            AddrFamily::V6 => 28,  // sizeof(sockaddr_in6)
        };
        if zr_bind(self.fd, &s, addrlen) < 0 {
            return Result::Err(NetError::from_errno());
        }
        return Result::Ok(());
    }

    /// 连接到远程地址（阻塞式）。
    pub fn connect(self: &Socket, addr: SocketAddr) -> Result<(), NetError> {
        let mut s = SockAddrStorage {
            family: 0, port: 0, _pad0: 0, addr: [0; 24],
        };
        addr.to_storage(&mut s);
        let addrlen: u32 = match addr.family() {
            AddrFamily::V4 => 16,
            AddrFamily::V6 => 28,
        };
        if zr_connect(self.fd, &s, addrlen) < 0 {
            return Result::Err(NetError::from_errno());
        }
        return Result::Ok(());
    }

    /// 开始监听（被动打开）。
    pub fn listen(self: &Socket, backlog: i32) -> Result<(), NetError> {
        if zr_listen(self.fd, backlog) < 0 {
            return Result::Err(NetError::from_errno());
        }
        return Result::Ok(());
    }

    /// 接收一个新连接。成功返回 (新 Socket, 对端地址)。
    pub fn accept(self: &Socket) -> Result<(Socket, SocketAddr), NetError> {
        let mut s = SockAddrStorage {
            family: 0, port: 0, _pad0: 0, addr: [0; 24],
        };
        let mut len: u32 = 28;
        let new_fd = zr_accept(self.fd, &mut s, &mut len);
        if new_fd < 0 {
            return Result::Err(NetError::from_errno());
        }
        let fam = match self.family {
            AddrFamily::V4 => AddrFamily::V4,
            AddrFamily::V6 => AddrFamily::V6,
        };
        let addr = SocketAddr::from_storage(&s).unwrap_or(
            SocketAddr::V4(Ipv4Addr::localhost(), 0)
        );
        let _ = fam;
        return Result::Ok((
            Socket {
                fd: new_fd,
                family: self.family,
                sock_type: self.sock_type,
            },
            addr,
        ));
    }

    /// 接收数据到缓冲区，返回读取的字节数。
    pub fn recv(self: &Socket, buf: []u8, flags: i32) -> Result<usize, NetError> {
        let n = zr_recv(self.fd, buf.ptr, buf.len, flags);
        if n < 0 {
            return Result::Err(NetError::from_errno());
        }
        return Result::Ok(n as usize);
    }

    /// 发送缓冲区中的数据，返回写入的字节数。
    pub fn send(self: &Socket, buf: []const u8, flags: i32) -> Result<usize, NetError> {
        let n = zr_send(self.fd, buf.ptr, buf.len, flags);
        if n < 0 {
            return Result::Err(NetError::from_errno());
        }
        return Result::Ok(n as usize);
    }

    /// 关闭套接字。关闭后 fd 置为 -1，防止二次关闭。
    pub fn close(self: &mut Socket) {
        if self.fd >= 0 {
            zr_close(self.fd);
            self.fd = -1;
        }
    }

    /// 获取并清除当前 errno。
    pub fn last_error(self: &Socket) -> NetError {
        let _ = self;
        return NetError::from_errno();
    }
}

/// Socket 被丢弃时自动关闭 fd。
impl Drop for Socket {
    fn drop(self: &mut Socket) {
        self.close();
    }
}

//=============================================================================
// TcpStream — 面向连接的字节流
//=============================================================================

/// 一个 TCP 连接（双向字节流）。
pub struct TcpStream {
    pub inner: Socket,
}

impl TcpStream {
    /// 主动连接到一个地址（阻塞式，带超时可扩展）。
    pub fn connect(addr: SocketAddr) -> Result<TcpStream, NetError> {
        let fam = addr.family();
        let sock = Socket::new(fam, sock_type::STREAM, protocol::AUTO)?;
        sock.connect(addr)?;
        return Result::Ok(TcpStream { inner: sock });
    }

    /// 从已有的 Socket 构造（不接管，由调用者保证）。
    pub fn from_socket(sock: Socket) -> TcpStream {
        return TcpStream { inner: sock };
    }

    /// 读取数据到缓冲区，返回读取字节数（0 = 对端关闭）。
    pub fn read(self: &TcpStream, buf: []u8) -> Result<usize, NetError> {
        return self.inner.recv(buf, 0);
    }

    /// 写入全部数据，返回写入字节数（骨架：实际应循环直到写完）。
    pub fn write(self: &TcpStream, buf: []const u8) -> Result<usize, NetError> {
        return self.inner.send(buf, 0);
    }

    /// 设置非阻塞模式。
    pub fn set_nonblocking(self: &mut TcpStream, on: bool) -> Result<(), NetError> {
        return self.inner.set_nonblocking(on);
    }

    /// 设置 Nagle 开关。
    pub fn set_nodelay(self: &mut TcpStream, on: bool) -> Result<(), NetError> {
        return self.inner.set_nodelay(on);
    }

    /// 设置保活。
    pub fn set_keepalive(self: &mut TcpStream, on: bool) -> Result<(), NetError> {
        return self.inner.set_keepalive(on);
    }

    /// 关闭连接。
    pub fn shutdown(self: &mut TcpStream) {
        self.inner.close();
    }

    /// 返回本地地址（骨架：需 getsockname）。
    pub fn local_addr(self: &TcpStream) -> Option<SocketAddr> {
        let _ = self;
        return Option::None;
    }

    /// 返回对端地址（骨架：需 getpeername）。
    pub fn peer_addr(self: &TcpStream) -> Option<SocketAddr> {
        let _ = self;
        return Option::None;
    }

    /// 把 stream 转为原始的 Socket（转移所有权）。
    pub fn into_socket(self) -> Socket {
        // 不能 `let s = self.inner;`——`Socket` 实现 Drop，zr 与 Rust 一样禁止
        // 从带 Drop 的类型里移出 Drop 字段（E0509）。`TcpStream` 本身没有 Drop
        // impl（析构靠内嵌 `Socket`），但 zr 的 `self` 按值表示对非 Copy 类型
        // 仍可能是借用形态，触发同一检查。这里改成按字段拷贝出标量再构造：
        // `Socket` 的字段都是标量/枚举（无 Drop glue），读它们不是移动。
        return Socket {
            fd: self.inner.fd,
            family: self.inner.family,
            sock_type: self.inner.sock_type,
        };
    }
}

/// 从 TcpStream 读取直到遇到换行符（简易 read_line）。
/// 返回读取的字节数，buf 中以 NUL 结尾。
///
/// 名字带 `_stream` 后缀：`io::read_line(buf, cap)`（stdin 版）与它同名会撞成
/// 一个 `z_read_line` 符号，加载 net 后 `use io::read_line` 可能绑到先收集的
/// net 版（签名不同，`read_line(buf, cap)` 静默拿到错误结果）。改名消除冲突。
pub fn read_line_stream(stream: &TcpStream, buf: []u8) -> Result<usize, NetError> {
    let mut total: usize = 0;
    while total < buf.len {
        let n = zr_recv(stream.inner.fd, offset(buf.ptr, total) as *mut u8, 1, 0);
        if n <= 0 {
            if n < 0 {
                return Result::Err(NetError::from_errno());
            }
            // 对端关闭
            break;
        }
        total = total + 1;
        // 读取到 '\n' 就停止
        if  *offset(buf.ptr, total - 1)  == b'\n' {
            break;
        }
    }
    return Result::Ok(total);
}

/// 向 stream 写入字符串（不含长度前缀，纯文本协议用）。
pub fn write_str(stream: &TcpStream, s: []const u8) -> Result<usize, NetError> {
    return stream.inner.send(s, 0);
}

//=============================================================================
// TcpListener — 被动打开的监听套接字
//=============================================================================

/// 一个 TCP 监听器，接受来自客户端的连接。
pub struct TcpListener {
    pub inner: Socket,
}

impl TcpListener {
    /// 绑定并监听指定地址。backlog 默认 128。
    pub fn bind(addr: SocketAddr) -> Result<TcpListener, NetError> {
        return TcpListener::bind_with_backlog(addr, 128);
    }

    /// 绑定并监听，指定 backlog。
    pub fn bind_with_backlog(addr: SocketAddr, backlog: i32) -> Result<TcpListener, NetError> {
        let fam = addr.family();
        let sock = Socket::new(fam, sock_type::STREAM, protocol::AUTO)?;
        sock.set_reuse_address(true)?;
        sock.bind(addr)?;
        sock.listen(backlog)?;
        return Result::Ok(TcpListener { inner: sock });
    }

    /// 阻塞等待并返回一个连接。
    pub fn accept(self: &TcpListener) -> Result<(TcpStream, SocketAddr), NetError> {
        let (sock, addr) = self.inner.accept()?;
        return Result::Ok((TcpStream { inner: sock }, addr));
    }

    /// 设置非阻塞后，配合事件循环做 accept。
    pub fn set_nonblocking(self: &mut TcpListener, on: bool) -> Result<(), NetError> {
        return self.inner.set_nonblocking(on);
    }

    /// 关闭监听器。
    pub fn close(self: &mut TcpListener) {
        self.inner.close();
    }

    /// 返回监听地址（骨架）。
    pub fn local_addr(self: &TcpListener) -> Option<SocketAddr> {
        let _ = self;
        return Option::None;
    }
}

//=============================================================================
// UdpSocket — 无连接数据报
//=============================================================================

/// 一个 UDP 套接字。
pub struct UdpSocket {
    pub inner: Socket,
}

impl UdpSocket {
    /// 创建一个 UDP 套接字（IPv4）。
    pub fn new_v4() -> Result<UdpSocket, NetError> {
        let sock = Socket::new(AddrFamily::V4, sock_type::DGRAM, protocol::UDP)?;
        return Result::Ok(UdpSocket { inner: sock });
    }

    /// 创建一个 UDP 套接字（IPv6）。
    pub fn new_v6() -> Result<UdpSocket, NetError> {
        let sock = Socket::new(AddrFamily::V6, sock_type::DGRAM, protocol::UDP)?;
        return Result::Ok(UdpSocket { inner: sock });
    }

    /// 绑定到本地地址。
    pub fn bind(self: &UdpSocket, addr: SocketAddr) -> Result<(), NetError> {
        return self.inner.bind(addr);
    }

    /// 连接到对端（仅记录对端地址，send/recv 可省略地址）。
    pub fn connect(self: &UdpSocket, addr: SocketAddr) -> Result<(), NetError> {
        return self.inner.connect(addr);
    }

    /// 发送数据报（需指定目标地址）。
    pub fn send_to(self: &UdpSocket, buf: []const u8, target: SocketAddr) -> Result<usize, NetError> {
        let mut s = SockAddrStorage {
            family: 0, port: 0, _pad0: 0, addr: [0; 24],
        };
        target.to_storage(&mut s);
        let addrlen: u32 = match target.family() {
            AddrFamily::V4 => 16,
            AddrFamily::V6 => 28,
        };
        // sendto：需要 sendto 系统调用，这里复用 send（已 connect 后）
        let _ = s;
        let _ = addrlen;
        let n = zr_send(self.inner.fd, buf.ptr, buf.len, 0);
        if n < 0 {
            return Result::Err(NetError::from_errno());
        }
        return Result::Ok(n as usize);
    }

    /// 接收数据报，返回（字节数, 来源地址）。
    pub fn recv_from(self: &UdpSocket, buf: []u8) -> Result<(usize, SocketAddr), NetError> {
        let mut s = SockAddrStorage {
            family: 0, port: 0, _pad0: 0, addr: [0; 24],
        };
        let mut len: u32 = 28;
        let n = zr_recv(self.inner.fd, buf.ptr, buf.len, 0);
        if n < 0 {
            return Result::Err(NetError::from_errno());
        }
        let addr = SocketAddr::from_storage(&s).unwrap_or(
            SocketAddr::V4(Ipv4Addr::localhost(), 0)
        );
        return Result::Ok((n as usize, addr));
    }

    /// 发送（要求已 connect）。
    pub fn send(self: &UdpSocket, buf: []const u8) -> Result<usize, NetError> {
        return self.inner.send(buf, 0);
    }

    /// 接收（要求已 connect）。
    pub fn recv(self: &UdpSocket, buf: []u8) -> Result<usize, NetError> {
        return self.inner.recv(buf, 0);
    }

    /// 关闭套接字。
    pub fn close(self: &mut UdpSocket) {
        self.inner.close();
    }
}

//=============================================================================
// DNS 解析
//=============================================================================

/// 解析主机名 + 服务名，返回地址列表。
pub fn lookup_host(node: []const u8, hints: AddrInfoHints) -> Result<Vec<SocketAddr>, NetError> {
    let mut res: *mut AddrInfo = 0 as *mut AddrInfo;
    let rc = zr_getaddrinfo(node.ptr, 0 as *const u8, &hints, &mut res);
    if rc != 0 {
        return Result::Err(NetError::from_errno());
    }

    let mut addrs = Vec::new();
    let mut cur = res;
    while cur != (0 as *mut AddrInfo) {
        let addr_ptr =  (*cur).addr ;
        if addr_ptr != (0 as *const SockAddrStorage) {
            if let Option::Some(a) = SocketAddr::from_storage(addr_ptr) {
                addrs.push(a);
            }
        }
        cur =  (*cur).next ;
    }

    if res != (0 as *mut AddrInfo) {
        zr_freeaddrinfo(res);
    }
    return Result::Ok(addrs);
}

/// 把 IPv4 字符串解析为 Ipv4Addr。
/// 支持 "a.b.c.d" 点分十进制；失败返回 Option::None。
pub fn parse_ipv4(s: []const u8) -> Option<Ipv4Addr> {
    // 逐段解析
    let mut parts: [u8; 4] = [0; 4];
    let mut part_idx: usize = 0;
    let mut cur: u8 = 0;
    let mut i: usize = 0;
    while i < s.len {
        let c = s.ptr[i];
        if c >= b'0' && c <= b'9' {
            cur = cur * 10 + (c - b'0');
        } else if c == b'.' {
            if part_idx >= 3 { return Option::None; }
            parts[part_idx] = cur;
            part_idx = part_idx + 1;
            cur = 0;
        } else {
            return Option::None;
        }
        i = i + 1;
    }
    if part_idx != 3 { return Option::None; }
    parts[3] = cur;
    return Option::Some(Ipv4Addr { octets: parts });
}

/// 把 IPv6 字符串解析为 Ipv6Addr（简化版，仅支持完整格式）。
pub fn parse_ipv6(s: []const u8) -> Option<Ipv6Addr> {
    // 简化实现：仅支持 "x:x:x:x:x:x:x:x" 完整 8 段格式
    let mut segs: [u16; 8] = [0; 8];
    let mut seg_idx: usize = 0;
    let mut cur: u16 = 0;
    let mut i: usize = 0;
    while i < s.len {
        let c = s.ptr[i];
        if (c >= b'0' && c <= b'9') || (c >= b'a' && c <= b'f') || (c >= b'A' && c <= b'F') {
            let digit: u16 = if c <= b'9' {
                (c - b'0') as u16
            } else if c <= b'F' {
                (c - b'A' + 10) as u16
            } else {
                (c - b'a' + 10) as u16
            };
            cur = cur * 16 + digit;
        } else if c == b':' {
            if seg_idx >= 7 { return Option::None; }
            segs[seg_idx] = cur;
            seg_idx = seg_idx + 1;
            cur = 0;
        } else {
            return Option::None;
        }
        i = i + 1;
    }
    if seg_idx != 7 { return Option::None; }
    segs[7] = cur;
    return Option::Some(Ipv6Addr { segments: segs });
}

/// 把字符串 "host:port" 解析为 SocketAddr（仅 IPv4，简化）。
pub fn parse_socket_addr(s: []const u8) -> Option<SocketAddr> {
    // 找到最后一个 ':' 作为端口分隔符
    let mut last_colon: isize = -1;
    let mut i: usize = 0;
    while i < s.len {
        if s.ptr[i] == b':' {
            last_colon = i as isize;
        }
        i = i + 1;
    }
    if last_colon < 0 { return Option::None; }

    let host_len = last_colon as usize;
    let port_start = (last_colon + 1) as usize;

    // 解析端口
    let mut port: u16 = 0;
    let mut j = port_start;
    while j < s.len {
        let c = s.ptr[j];
        if c < b'0' || c > b'9' { return Option::None; }
        port = port * 10 + (c - b'0') as u16;
        j = j + 1;
    }

    // 解析主机（仅支持点分十进制 IPv4）
    let host_slice = Slice::new(s.ptr, host_len);
    if let Option::Some(v4) = parse_ipv4(host_slice) {
        return Option::Some(SocketAddr::V4(v4, port));
    }
    return Option::None;
}

//=============================================================================
// HTTP — 极简 HTTP/1.1 客户端（文本协议层，依赖 TcpStream）
//=============================================================================

/// HTTP 请求方法。
pub enum HttpMethod {
    Get,
    Post,
    Put,
    Delete,
    Head,
    Options,
    Patch,
}

/// HTTP 响应状态。
pub struct HttpStatus {
    /// 状态码（200 / 404 / 500 等）。
    pub code: u16,
    /// 原因短语（如 "OK"）。
    pub reason: []const u8,
}

/// HTTP 响应。
pub struct HttpResponse {
    /// 状态行。
    pub status: HttpStatus,
    /// 头字段列表（简化：扁平键值对）。
    pub headers: Vec<HttpHeader>,
    /// 响应体。
    pub body: Vec<u8>,
}

/// 单个 HTTP 头。
pub struct HttpHeader {
    pub name: []const u8,
    pub value: []const u8,
}

/// 发送一个 HTTP 请求并读取完整响应。
///
/// 这是一个骨架实现：
/// - 支持 GET / POST（文本请求体）
/// - 不支持 HTTPS / TLS（需额外 crypto 层）
/// - 不支持分块传输（Transfer-Encoding: chunked）
/// - 不支持 HTTP/2、HTTP/3
///
/// 用法：
/// ```zr
/// let mut stream = TcpStream::connect(SocketAddr::v4(Ipv4Addr::new(93,184,216,34), 80))?;
/// let resp = http_get(&mut stream, "/", "example.com")?;
/// println(resp.body);
/// ```
pub fn http_get(stream: &TcpStream, path: []const u8, host: []const u8) -> Result<HttpResponse, NetError> {
    return http_request(stream, HttpMethod::Get, path, host, Slice::new(0 as *const u8, 0));
}

/// 发送一个带请求体的 HTTP 请求。
pub fn http_request(
    stream: &TcpStream,
    method: HttpMethod,
    path: []const u8,
    host: []const u8,
    body: []const u8,
) -> Result<HttpResponse, NetError> {
    // 构造请求行
    let mut req = Vec::new();
    match method {
        HttpMethod::Get    => { push_slice(&mut req, "GET "); }
        HttpMethod::Post   => { push_slice(&mut req, "POST "); }
        HttpMethod::Put    => { push_slice(&mut req, "PUT "); }
        HttpMethod::Delete => { push_slice(&mut req, "DELETE "); }
        HttpMethod::Head   => { push_slice(&mut req, "HEAD "); }
        HttpMethod::Options=> { push_slice(&mut req, "OPTIONS "); }
        HttpMethod::Patch  => { push_slice(&mut req, "PATCH "); }
    }
    push_slice(&mut req, path);
    push_slice(&mut req, " HTTP/1.1\r\n");

    // Host 头（HTTP/1.1 必需）
    push_slice(&mut req, "Host: ");
    push_slice(&mut req, host);
    push_slice(&mut req, "\r\n");

    // User-Agent
    push_slice(&mut req, "User-Agent: zr-net/0.5\r\n");

    // Content-Length（如有请求体）
    if body.len > 0 {
        push_slice(&mut req, "Content-Length: ");
        let mut buf: [u8; 16] = [0; 16];
        let mut n = body.len;
        let mut idx: usize = 15;
        if n == 0 {
            buf[15] = b'0';
        } else {
            while n > 0 {
                buf[idx] = ((n % 10) as u8) + b'0';
                n = n / 10;
                if n > 0 { idx = idx - 1; }
            }
        }
        // 计算实际起始位置
        let mut start: usize = 0;
        let mut k: usize = 0;
        while k < 16 {
            if buf[k] != 0 { start = k; break; }
            k = k + 1;
        }
        let mut m = start;
        while m < 16 {
            req.push(buf[m]);
            m = m + 1;
        }
        push_slice(&mut req, "\r\n");
    }

    // 连接关闭
    push_slice(&mut req, "Connection: close\r\n");
    push_slice(&mut req, "\r\n");

    // 请求体
    if body.len > 0 {
        let mut i: usize = 0;
        while i < body.len {
            req.push(body.ptr[i]);
            i = i + 1;
        }
    }

    // 发送
    stream.inner.send( Slice::new(req.data as *const u8, req.len) , 0)?;

    // 读取响应
    let mut resp_buf = Vec::with_capacity(4096);
    let mut tmp: [u8; 4096] = [0; 4096];
    loop {
        let n = zr_recv(stream.inner.fd, &mut tmp[0] as *mut u8, 4096, 0);
        if n <= 0 { break; }
        let mut i: usize = 0;
        while i < n as usize {
            resp_buf.push(tmp[i]);
            i = i + 1;
        }
    }

    // 解析响应
    return parse_http_response(resp_buf);
}

/// 解析 HTTP 响应（骨架：仅解析状态行与头部）。
fn parse_http_response(buf: Vec<u8>) -> Result<HttpResponse, NetError> {
    // 找到状态行结束位置
    let mut status_code: u16 = 0;
    let mut header_end: usize = 0;

    // 扫描 "\r\n\r\n" 定位头部结束
    let mut i: usize = 0;
    while i + 3 < buf.len {
        if buf[i] == b'\r' && buf[i + 1] == b'\n' && buf[i + 2] == b'\r' && buf[i + 3] == b'\n' {
            header_end = i;
            break;
        }
        i = i + 1;
    }

    // 解析状态行 "HTTP/1.1 200 OK"
    // 跳过 "HTTP/1.x "
    let mut pos: usize = 0;
    while pos < buf.len && buf[pos] != b' ' { pos = pos + 1; }
    pos = pos + 1; // 跳过空格
    let code_start = pos;
    while pos < buf.len && buf[pos] != b' ' { pos = pos + 1; }
    let code_str =  Slice::new(offset(buf.data as *const u8, code_start), pos - code_start) ;
    status_code = parse_u16(code_str);

    // 提取 body（头部结束后的所有内容）
    let body_start = header_end + 4;
    let mut body = Vec::new();
    let mut j: usize = body_start;
    while j < buf.len {
        body.push(buf[j]);
        j = j + 1;
    }

    return Result::Ok(HttpResponse {
        status: HttpStatus { code: status_code, reason: "OK" },
        headers: Vec::new(),
        body,
    });
}

/// 把 u16 转为字符串（辅助）。
fn parse_u16(s: []const u8) -> u16 {
    let mut v: u16 = 0;
    let mut i: usize = 0;
    while i < s.len {
        let c = s.ptr[i];
        if c >= b'0' && c <= b'9' {
            v = v * 10 + (c - b'0') as u16;
        }
        i = i + 1;
    }
    return v;
}

/// 把字节切片追加到 Vec<u8>。
fn push_slice(vec: &mut Vec<u8>, s: []const u8) {
    let mut i: usize = 0;
    while i < s.len {
        vec.push(s.ptr[i]);
        i = i + 1;
    }
}

/// 一个最小化的 HTTP 服务器骨架（echo server）。
/// 真实实现需结合事件循环处理并发连接。
pub fn serve_echo(addr: SocketAddr, handler: fn([]u8) -> []u8) -> Result<(), NetError> {
    let _ = handler;
    let listener = TcpListener::bind(addr)?;
    println("listening on port ");
    print_int(addr.port() as i64);
    loop {
        match listener.accept() {
            Result::Ok((mut stream, peer)) => {
                let _ = peer;
                let mut buf: [u8; 4096] = [0; 4096];
                match stream.read(SliceMut::new(&mut buf[0] as *mut u8, 4096)) {
                    Result::Ok(n) => {
                        // echo 回显
                        let _ = stream.inner.send(
                             Slice::new(&buf[0] as *const u8, n) ,
                            0,
                        );
                    }
                    Result::Err(_) => {}
                }
            }
            Result::Err(_) => {
                // 短暂的 accept 错误，重试
                continue;
            }
        }
    }
}

//=============================================================================
// NetError — 网络错误
//=============================================================================

/// 网络操作错误。
pub enum NetError {
    /// 通用错误（附带 errno）。
    Other(i32),
    /// 地址已被占用。
    AddrInUse,
    /// 连接被拒绝。
    ConnectionRefused,
    /// 连接已重置。
    ConnectionReset,
    /// 连接已中止。
    ConnectionAborted,
    /// 对端已关闭。
    NotConnected,
    /// 地址族不支持。
    AddrNotAvailable,
    /// 主机不可达。
    HostUnreachable,
    /// 网络不可达。
    NetworkUnreachable,
    /// 超时。
    TimedOut,
    /// 操作正在进行（非阻塞套接字）。
    WouldBlock,
    /// DNS 解析失败。
    DnsFailed,
    /// 地址无效。
    InvalidAddr,
    /// 缓冲区空间不足。
    OutOfMemory,
    /// 文件描述符耗尽。
    TooManyFiles,
}

impl NetError {
    /// 从当前 errno 构造 NetError。
    pub fn from_errno() -> NetError {
        let err = zr_errno();
        match err {
            98  => return NetError::AddrInUse,          // EADDRINUSE
            111 => return NetError::ConnectionRefused,   // ECONNREFUSED
            104 => return NetError::ConnectionReset,     // ECONNRESET
            103 => return NetError::ConnectionAborted,   // ECONNABORTED
            107 => return NetError::NotConnected,        // ENOTCONN
            99  => return NetError::AddrNotAvailable,    // EADDRNOTAVAIL
            113 => return NetError::HostUnreachable,     // EHOSTUNREACH
            101 => return NetError::NetworkUnreachable,  // ENETUNREACH
            110 => return NetError::TimedOut,            // ETIMEDOUT
            11  => return NetError::WouldBlock,          // EAGAIN / EWOULDBLOCK
            24  => return NetError::TooManyFiles,        // EMFILE
            12  => return NetError::OutOfMemory,         // ENOMEM
            _   => return NetError::Other(err),
        }
    }

    /// 返回人类可读的错误描述。
    pub fn description(self) -> []const u8 {
        match self {
            NetError::Other(_)           => return "other error",
            NetError::AddrInUse          => return "address already in use",
            NetError::ConnectionRefused  => return "connection refused",
            NetError::ConnectionReset    => return "connection reset by peer",
            NetError::ConnectionAborted  => return "connection aborted",
            NetError::NotConnected       => return "not connected",
            NetError::AddrNotAvailable   => return "address not available",
            NetError::HostUnreachable    => return "host unreachable",
            NetError::NetworkUnreachable => return "network unreachable",
            NetError::TimedOut           => return "operation timed out",
            NetError::WouldBlock         => return "operation would block",
            NetError::DnsFailed          => return "dns resolution failed",
            NetError::InvalidAddr        => return "invalid address",
            NetError::OutOfMemory        => return "out of memory",
            NetError::TooManyFiles       => return "too many open files",
        }
    }
}

//=============================================================================
// 便捷函数
//=============================================================================

/// 快速创建一个 TCP 连接到 host:port（字符串形式）。
/// host 应为点分十进制 IPv4 地址。
pub fn tcp_connect(host: []const u8, port: u16) -> Result<TcpStream, NetError> {
    let addr = match parse_socket_addr(host) {
        Option::Some(a) => a,
        Option::None => return Result::Err(NetError::InvalidAddr),
    };
    return TcpStream::connect(addr);
}

/// 在指定端口启动一个 TCP 回声服务器（阻塞）。
pub fn echo_server(port: u16) -> Result<(), NetError> {
    let addr = SocketAddr::V4(Ipv4Addr::any(), port);
    return serve_echo(addr, echo_fn);
}

/// 回声处理函数（标识函数，供 serve_echo 使用）。
fn echo_fn(input: []u8) -> []u8 {
    return input;
}

/// 发送一条 HTTP GET 请求并打印响应体（极简 fetch）。
pub fn fetch(url_host: []const u8, port: u16, path: []const u8) -> Result<Vec<u8>, NetError> {
    let addr = match parse_socket_addr(url_host) {
        Option::Some(a) => a,
        Option::None => return Result::Err(NetError::InvalidAddr),
    };
    let mut stream = TcpStream::connect(addr)?;
    let resp = http_get(&stream, path, url_host)?;
    stream.shutdown();
    return Result::Ok(resp.body);
}
