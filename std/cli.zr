//=============================================================================
// std/cli.zr — 命令行参数
//
// 入口桩 `_start` 会在调用 `main` 之前把 (argc, argv) 交给运行时
// （`zr_args_init`）。本模块只是那对只读接口的薄封装：
//
//   cli::arg_count()          -> usize       参数个数（至少 1）
//   cli::arg(i)               -> String      第 i 个参数；越界返回空串
//   cli::arg_opt(i)           -> Option<String>
//   cli::args()               -> Vec<String> 全部参数（含程序名）
//   cli::program_name()       -> String      arg(0)
//   cli::get(i, default)      -> String      第 i 个参数，越界返回 default
//
// 参数是进程启动时内核 / dyld 交给进程的原始字节（C 字符串），这里复制成
// `String`，之后即使进程继续运行也不会失效。
//=============================================================================

use core::Option;
use collections::Vec;
use string::String;

extern "C" {
    fn zr_args_count() -> usize;
    fn zr_args_ptr(i: usize) -> *const u8;
}

/// 参数个数（含程序名）。没有参数信息时返回 0。
pub fn arg_count() -> usize {
    return zr_args_count();
}

/// 第 `i` 个参数；越界返回空串。
pub fn arg(i: usize) -> String {
    let p = zr_args_ptr(i);
    if p == 0 as *const u8 {
        return String::new();
    }
    return String::from_cstr(p);
}

/// 第 `i` 个参数；越界返回 None。
pub fn arg_opt(i: usize) -> Option<String> {
    let p = zr_args_ptr(i);
    if p == 0 as *const u8 {
        return Option::None;
    }
    return Option::Some(String::from_cstr(p));
}

/// 第 `i` 个参数，越界时返回 `default`。
pub fn get(i: usize, default: str) -> String {
    let p = zr_args_ptr(i);
    if p == 0 as *const u8 {
        return String::from_bytes(default);
    }
    return String::from_cstr(p);
}

/// 全部参数（下标 0 是程序名）。
pub fn args() -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let n = zr_args_count();
    let mut i: usize = 0;
    while i < n {
        out.push(arg(i));
        i = i + 1;
    }
    return out;
}

/// 程序名（等价于 `arg(0)`）。
pub fn program_name() -> String {
    return arg(0);
}
