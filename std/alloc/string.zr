//=============================================================================
// std/string.zr — 可增长的 UTF-8 字符串
//
// `String` 是堆分配的、可增长的字节缓冲区，保证持有有效的 UTF-8。
// 本节同时提供 `[u8]` 切片上的字符串视图操作。
//=============================================================================

use core::{Option, Result, panic};
use char::is_ascii_whitespace;
use collections::Vec;
use mem::{zr_alloc, zr_dealloc, zr_realloc, memcmp, NULL};

/// 一个可增长的 UTF-8 字符串。
pub struct String {
    pub ptr:       *mut u8,
    pub len:       usize,
    pub capacity:  usize,
}

impl String {
    /// 创建一个空字符串。
    pub fn new() -> String {
        let cap = 8;
        let ptr = zr_alloc(cap, 1) as *mut u8;
        if ptr == 0 as *mut u8 { panic("out of memory"); }
        return String { ptr, len: 0, capacity: cap };
    }

    /// 用一段字节切片构造字符串（拷贝）。
    pub fn from_bytes(bytes: []const u8) -> String {
        let mut s = String::new();
        s.reserve(bytes.len);
        let mut i = 0;
        while i < bytes.len {
            s.push_byte(bytes.ptr[i]);
            i = i + 1;
        }
        return s;
    }

    /// 从 C 字符串（以 NUL 结尾）构造。
    pub fn from_cstr(cstr: *const u8) -> String {
        let mut len = 0;
        while cstr[len] != 0 { len = len + 1; }
        return String::from_bytes(Slice { ptr: cstr, len });
    }

    /// 以给定容量预留空间。
    pub fn with_capacity(cap: usize) -> String {
        let ptr = zr_alloc(cap, 1) as *mut u8;
        if ptr == 0 as *mut u8 { panic("out of memory"); }
        return String { ptr, len: 0, capacity: cap };
    }

    pub fn len(self) -> usize { return self.len; }

    pub fn is_empty(self) -> bool { return self.len == 0; }

    pub fn capacity(self) -> usize { return self.capacity; }

    /// 追加一个 ASCII/UTF-8 码点（单个字节）。
    pub fn push_byte(self: &mut String, b: u8) {
        if self.len + 1 > self.capacity {
            self.grow();
        }
        self.ptr[self.len] = b;
        self.len = self.len + 1;
    }

    /// 追加一个字符（完整 UTF-8 编码）。
    pub fn push(self: &mut String, c: char) {
        // 简化实现：仅处理 ASCII 单字节字符。
        self.push_byte(c as u8);
    }

    /// 追加一段字节切片。
    pub fn push_bytes(self: &mut String, bytes: []const u8) {
        let new_len = self.len + bytes.len;
        if new_len > self.capacity {
            // `reserve(additional)` 保证 `capacity >= len + additional`，
            // 所以要保证 `capacity >= new_len` 必须传 `bytes.len`，而不是
            // `new_len - capacity`（后者只在 `len == capacity` 时够用，
            // 否则会少 reserve，拷贝循环越界写堆）。
            self.reserve(bytes.len);
        }
        let mut i = 0;
        while i < bytes.len {
            self.ptr[self.len + i] = bytes.ptr[i];
            i = i + 1;
        }
        self.len = new_len;
    }

    /// 追加另一个字符串。
    pub fn push_str(self: &mut String, s: &String) {
        self.push_bytes(Slice { ptr: s.ptr, len: s.len });
    }

    /// 追加 `n` 个空格。`#[derive(Debug)]` 生成的多行 `.debug_pretty()` 用它
    /// 做逐层缩进（每层 4 空格），见 `src/typeck/derive.rs`。
    pub fn push_indent(self: &mut String, n: usize) {
        let mut i = 0;
        while i < n {
            self.push_byte(32);
            i = i + 1;
        }
    }

    /// 追加一个数字（十进制）。
    pub fn push_int(self: &mut String, n: i64) {
        if n == 0 {
            self.push_byte(b'0');
            return;
        }
        if n < 0 {
            self.push_byte(b'-');
        }
        let mut val = if n < 0 { -n } else { n };
        let mut buf: [u8; 24] = [0; 24];
        let mut i = 24;
        while val > 0 {
            i = i - 1;
            buf[i] = (val % 10) as u8 + b'0';
            val = val / 10;
        }
        let count = 24 - i;
        self.push_bytes(Slice { ptr: &buf[i] as *const u8, len: count });
    }

    /// 追加一个无符号数字。
    pub fn push_uint(self: &mut String, n: u64) {
        if n == 0 {
            self.push_byte(b'0');
            return;
        }
        let mut val = n;
        let mut buf: [u8; 24] = [0; 24];
        let mut i = 24;
        while val > 0 {
            i = i - 1;
            buf[i] = (val % 10) as u8 + b'0';
            val = val / 10;
        }
        let count = 24 - i;
        self.push_bytes(Slice { ptr: &buf[i] as *const u8, len: count });
    }

    /// 确保容量至少为 `additional`。
    pub fn reserve(self: &mut String, additional: usize) {
        if self.len + additional > self.capacity {
            let mut new_cap = self.capacity;
            while self.len + additional > new_cap {
                new_cap = new_cap * 2;
            }
            self.grow_to(new_cap);
        }
    }

    /// 增长容量到至少 `new_cap`。
    fn grow_to(self: &mut String, new_cap: usize) {
        let new_ptr = zr_realloc(
            self.ptr as *mut void,
            self.capacity,
            new_cap,
            1,
        ) as *mut u8;
        if new_ptr == 0 as *mut u8 { panic("out of memory"); }
        self.ptr = new_ptr;
        self.capacity = new_cap;
    }

    fn grow(self: &mut String) {
        let new_cap = if self.capacity == 0 { 8 } else { self.capacity * 2 };
        self.grow_to(new_cap);
    }

    /// 清空字符串，但保留已分配容量。
    pub fn clear(self: &mut String) {
        self.len = 0;
    }

    /// 释放字符串占用的内存。
    pub fn destroy(self: &mut String) {
        if self.ptr != 0 as *mut u8 {
            zr_dealloc(self.ptr as *mut void, self.len, 1);
            self.ptr = 0 as *mut u8;
            self.len = 0;
            self.capacity = 0;
        }
    }

    /// 取出一个字节切片视图。
    pub fn as_bytes(self) -> []const u8 {
        return Slice { ptr: self.ptr as *const u8, len: self.len };
    }

    /// 比较两个字符串是否相等。
    pub fn eq(self, other: &String) -> bool {
        if self.len != other.len { return false; }
        return memcmp(
            self.ptr as *const void,
            other.ptr as *const void,
            self.len,
        ) == 0;
    }

    /// 字典序比较：小于返回 -1，等于返回 0，大于返回 1。
    pub fn cmp(self, other: &String) -> i32 {
        let min_len = if self.len < other.len { self.len } else { other.len };
        let r = memcmp(
            self.ptr as *const void,
            other.ptr as *const void,
            min_len,
        );
        if r != 0 { return r; }
        if self.len < other.len { return -1; }
        if self.len > other.len { return 1; }
        return 0;
    }

    /// 是否包含子串。
    pub fn contains(self, needle: []const u8) -> bool {
        if needle.len > self.len { return false; }
        let mut i = 0;
        while i <= self.len - needle.len {
            let mut match_ = true;
            let mut j = 0;
            while j < needle.len {
                if self.ptr[i + j] != needle.ptr[j] {
                    match_ = false;
                    break;
                }
                j = j + 1;
            }
            if match_ { return true; }
            i = i + 1;
        }
        return false;
    }

    /// 是否以给定前缀开头。
    pub fn starts_with(self, prefix: []const u8) -> bool {
        if prefix.len > self.len { return false; }
        let mut i = 0;
        while i < prefix.len {
            if self.ptr[i] != prefix.ptr[i] { return false; }
            i = i + 1;
        }
        return true;
    }

    /// 是否以给定后缀结尾。
    pub fn ends_with(self, suffix: []const u8) -> bool {
        if suffix.len > self.len { return false; }
        let offset = self.len - suffix.len;
        let mut i = 0;
        while i < suffix.len {
            if self.ptr[offset + i] != suffix.ptr[i] { return false; }
            i = i + 1;
        }
        return true;
    }

    /// 截取子串 `[start, end)`。
    pub fn substr(self, start: usize, end: usize) -> String {
        // 允许 `start == end`（空串）：`split` / `replace` / `trim` 的边界情形
        // 会产生空片段。容量至少 1，避开 0 字节分配可能返回空指针。
        if start > self.len || end > self.len || start > end {
            panic("substr: index out of range");
        }
        let mut s = String::with_capacity(end - start + 1);
        let mut i = start;
        while i < end {
            s.push_byte(self.ptr[i]);
            i = i + 1;
        }
        return s;
    }

    /// 查找字符首次出现的位置。
    pub fn find_byte(self, b: u8) -> Option<usize> {
        let mut i = 0;
        while i < self.len {
            if self.ptr[i] == b { return Option::Some(i); }
            i = i + 1;
        }
        return Option::None;
    }

    /// 反转字符串（按字节，仅对 ASCII 安全）。
    pub fn reverse(self: &mut String) {
        let mut i = 0;
        let mut j = self.len;
        while i < j {
            j = j - 1;
            let tmp = self.ptr[i];
            self.ptr[i] = self.ptr[j];
            self.ptr[j] = tmp;
            i = i + 1;
        }
    }

    /// 字符串拼接，返回新字符串。
    pub fn concat(a: &String, b: &String) -> String {
        let mut result = String::with_capacity(a.len + b.len);
        result.push_str(a);
        result.push_str(b);
        return result;
    }

    /// 重复字符串 `count` 次。
    pub fn repeat(s: []const u8, count: usize) -> String {
        let mut result = String::with_capacity(s.len * count);
        let mut i = 0;
        while i < count {
            result.push_bytes(s);
            i = i + 1;
        }
        return result;
    }

    //--------------------------------------------------------------------------
    // 以下对齐 Rust `str` 常用方法（`trim` / `split` / `replace` / `parse` …）。
    // zr 的 `String` 按字节处理，非 ASCII 的分割仍按字节进行。
    //--------------------------------------------------------------------------

    /// 去掉首尾 ASCII 空白。
    pub fn trim(self) -> String {
        let start = self.trim_start_offset();
        let end = self.trim_end_offset(start);
        return self.substr(start, end);
    }

    /// 去掉开头 ASCII 空白。
    pub fn trim_start(self) -> String {
        let start = self.trim_start_offset();
        return self.substr(start, self.len);
    }

    /// 去掉结尾 ASCII 空白。
    pub fn trim_end(self) -> String {
        let end = self.trim_end_offset(0);
        return self.substr(0, end);
    }

    fn trim_start_offset(self) -> usize {
        let mut i = 0;
        while i < self.len && is_ascii_whitespace((self.ptr[i] as u8) as char) {
            i = i + 1;
        }
        return i;
    }

    fn trim_end_offset(self, start: usize) -> usize {
        let mut end = self.len;
        while end > start && is_ascii_whitespace((self.ptr[end - 1] as u8) as char) {
            end = end - 1;
        }
        return end;
    }

    /// 全部转小写（仅 ASCII 字母）。
    pub fn to_lowercase(self) -> String {
        let mut s = String::with_capacity(self.len);
        let mut i = 0;
        while i < self.len {
            let b = self.ptr[i];
            if b >= b'A' && b <= b'Z' { s.push_byte(b + 32); }
            else { s.push_byte(b); }
            i = i + 1;
        }
        return s;
    }

    /// 全部转大写（仅 ASCII 字母）。
    pub fn to_uppercase(self) -> String {
        let mut s = String::with_capacity(self.len);
        let mut i = 0;
        while i < self.len {
            let b = self.ptr[i];
            if b >= b'a' && b <= b'z' { s.push_byte(b - 32); }
            else { s.push_byte(b); }
            i = i + 1;
        }
        return s;
    }

    /// 查找子串首次出现位置。
    pub fn find_str(self, needle: []const u8) -> Option<usize> {
        if needle.len > self.len { return Option::None; }
        let mut i = 0;
        while i + needle.len <= self.len {
            let mut j = 0;
            let mut ok = true;
            while j < needle.len {
                if self.ptr[i + j] != needle.ptr[j] { ok = false; break; }
                j = j + 1;
            }
            if ok { return Option::Some(i); }
            i = i + 1;
        }
        return Option::None;
    }

    /// 从后往前查找字节。
    pub fn rfind_byte(self, b: u8) -> Option<usize> {
        let mut i = self.len;
        while i > 0 {
            i = i - 1;
            if self.ptr[i] == b { return Option::Some(i); }
        }
        return Option::None;
    }

    /// 按分隔符切分成若干子串（对应 Rust `str::split`）。
    /// 分隔符为空时返回只含自身的单个元素。
    pub fn split(self, sep: []const u8) -> Vec<String> {
        if sep.len == 0 {
            let mut one: Vec<String> = Vec::with_capacity(1);
            one.push(self.substr(0, self.len));
            return one;
        }
        // 先数出段数，一次性分配，避免聚合元素在增长时搬移。
        let mut count: usize = 1;
        let mut i = 0;
        while i + sep.len <= self.len {
            let mut j = 0;
            let mut ok = true;
            while j < sep.len {
                if self.ptr[i + j] != sep.ptr[j] { ok = false; break; }
                j = j + 1;
            }
            if ok { count = count + 1; i = i + sep.len; }
            else { i = i + 1; }
        }
        let mut out: Vec<String> = Vec::with_capacity(count);
        let mut start = 0;
        let mut k = 0;
        while k + sep.len <= self.len {
            let mut j = 0;
            let mut ok = true;
            while j < sep.len {
                if self.ptr[k + j] != sep.ptr[j] { ok = false; break; }
                j = j + 1;
            }
            if ok {
                out.push(self.substr(start, k));
                k = k + sep.len;
                start = k;
            } else {
                k = k + 1;
            }
        }
        out.push(self.substr(start, self.len));
        return out;
    }

    /// 按空白切分，跳过连续空白（对应 Rust `str::split_whitespace`）。
    pub fn split_whitespace(self) -> Vec<String> {
        let mut count: usize = 0;
        let mut i = 0;
        while i < self.len {
            while i < self.len && is_ascii_whitespace((self.ptr[i] as u8) as char) { i = i + 1; }
            if i < self.len {
                count = count + 1;
                while i < self.len && !is_ascii_whitespace((self.ptr[i] as u8) as char) { i = i + 1; }
            }
        }
        let mut out: Vec<String> = Vec::with_capacity(count);
        i = 0;
        while i < self.len {
            while i < self.len && is_ascii_whitespace((self.ptr[i] as u8) as char) { i = i + 1; }
            let start = i;
            while i < self.len && !is_ascii_whitespace((self.ptr[i] as u8) as char) { i = i + 1; }
            if i > start { out.push(self.substr(start, i)); }
        }
        return out;
    }

    /// 把所有 `from` 替换成 `to`（对应 Rust `str::replace`，非重叠替换）。
    pub fn replace(self, from: []const u8, to: []const u8) -> String {
        if from.len == 0 || from.len > self.len { return self.substr(0, self.len); }
        let mut out = String::with_capacity(self.len);
        let mut i = 0;
        let mut last = 0;
        while i + from.len <= self.len {
            let mut j = 0;
            let mut ok = true;
            while j < from.len {
                if self.ptr[i + j] != from.ptr[j] { ok = false; break; }
                j = j + 1;
            }
            if ok {
                out.push_bytes(self.substr(last, i).as_bytes());
                out.push_bytes(to);
                i = i + from.len;
                last = i;
            } else {
                i = i + 1;
            }
        }
        out.push_bytes(self.substr(last, self.len).as_bytes());
        return out;
    }

    /// 解析成 `i64`。成功返回 `Ok`，格式错误返回 `Err(1)`。
    pub fn parse_i64(self) -> Result<i64, i32> {
        let start = self.trim_start_offset();
        let end = self.trim_end_offset(start);
        if start >= end { return Result::Err(1); }
        let mut i = start;
        let mut neg = false;
        if self.ptr[i] == b'-' { neg = true; i = i + 1; }
        else if self.ptr[i] == b'+' { i = i + 1; }
        if i >= end { return Result::Err(1); }
        let mut val: i64 = 0;
        while i < end {
            let b = self.ptr[i];
            if b < b'0' || b > b'9' { return Result::Err(1); }
            val = val * 10 + ((b - b'0') as i64);
            i = i + 1;
        }
        if neg { val = -val; }
        return Result::Ok(val);
    }

    /// 解析成 `i32`。
    pub fn parse_i32(self) -> Result<i32, i32> {
        match self.parse_i64() {
            Result::Ok(v) => return Result::Ok(v as i32),
            Result::Err(e) => return Result::Err(e),
        }
    }
}

//------------------------------------------------------------------------------
// 常用 trait 实现（供容器 / 泛型算法使用）
//
// 注意 `Eq::eq` 必须手写字节比较，不能调 `self.eq(&other)`：那会解析回
// 同一个 trait 方法，形成无限递归（栈溢出）。
//------------------------------------------------------------------------------

impl Eq for String {
    fn eq(self, other: String) -> bool {
        if self.len != other.len { return false; }
        let mut i = 0;
        while i < self.len {
            if self.ptr[i] != other.ptr[i] { return false; }
            i = i + 1;
        }
        return true;
    }
}

impl Ord for String {
    fn lt(self, other: String) -> bool {
        return self.cmp(&other) < 0;
    }
}

impl Hash for String {
    fn hash(self) -> u64 {
        // FNV-1a 64 位
        let mut h: u64 = 1469598103934665603;
        let mut i = 0;
        while i < self.len {
            h = (h ^ (self.ptr[i] as u64)) * 1099511628211;
            i = i + 1;
        }
        return h;
    }
}

impl Clone for String {
    fn clone(self) -> String {
        let mut s = String::with_capacity(self.len);
        s.push_bytes(Slice { ptr: self.ptr as *const u8, len: self.len });
        return s;
    }
}

impl Default for String {
    fn default() -> String { return String::new(); }
}

/// C 字符串工具：计算以 NUL 结尾的字符串长度。
pub fn cstr_len(ptr: *const u8) -> usize {
    let mut len = 0;
    while ptr[len] != 0 { len = len + 1; }
    return len;
}

/// 把 C 字符串转成切片视图（不拷贝）。
pub fn cstr_as_slice(ptr: *const u8) -> []const u8 {
    return Slice { ptr, len: cstr_len(ptr) };
}

/// 用分隔符把若干 `str` 拼成一个新字符串。
///
/// `parts` 指向连续的 `str` 数组（每个 16 字节），`count` 是元素个数。
///
/// 名字带 `_parts` 是为了不和 `path::join`（路径拼接）在扁平符号表里撞名：
/// 两者一旦同时加载，后加载的会把先加载的覆盖掉。
pub fn join_parts(parts: *const str, count: usize, sep: str) -> String {
    let mut out = String::new();
    let mut i: usize = 0;
    while i < count {
        if i > 0 {
            out.push_bytes(sep);
        }
        // `str` 是 `{ptr, len}`（16 字节），按字节偏移取元素，不依赖
        // 指针对 `str` 元素的步长推断。
        let s = *((parts as usize + i * 16) as *const str);
        out.push_bytes(s);
        i = i + 1;
    }
    return out;
}
