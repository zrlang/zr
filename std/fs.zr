//=============================================================================
// std/fs.zr — 文件系统
//
// 与 Rust 的 `std::fs` 对齐的薄封装。路径用 `str` 传入，内部复制成
// NUL 结尾的字节串再交给运行时（与 io::file_open 的约定一致）。
//
//   fs::create_dir(path)          -> bool   创建目录
//   fs::remove_dir(path)          -> bool   删除空目录
//   fs::remove_file(path)         -> bool   删除文件
//   fs::rename(from, to)          -> bool   重命名 / 移动
//   fs::exists(path)              -> bool   路径是否存在
//   fs::is_dir(path)              -> bool   是否是目录
//   fs::file_size(path)           -> i64    文件字节数，出错 -1
//   fs::read_dir_count(path)      -> i64    条目个数（不含 "." / ".."）
//   fs::read_dir_name(path, i, buf, cap) -> i64  第 i 项名字长度，出错 -1
//   fs::current_dir(buf, cap)     -> i64    当前目录长度，出错 -1
//   fs::temp_file()               -> io::File  创建临时文件（可写），fd 或 -1
//   fs::temp_file_raw()           -> i32    临时文件 fd，出错 -1
//   fs::file_mtime(path)          -> i64    修改时间（Unix 秒），出错 -1
//   fs::file_mode(path)           -> i64    mode 位（st_mode），出错 -1
//
// 目录遍历跳过 "." 与 ".."：下标 0..count-1 直接对应真实条目。
//=============================================================================

use io::{File, FILE_WRITE};

//----- 外部运行时 -------------------------------------------------------------

extern "C" {
    fn zr_mkdir(path: *const u8) -> i32;
}

extern "C" {
    fn zr_rmdir(path: *const u8) -> i32;
}

extern "C" {
    fn zr_unlink(path: *const u8) -> i32;
}

extern "C" {
    fn zr_rename(from: *const u8, to: *const u8) -> i32;
}

extern "C" {
    fn zr_path_exists(path: *const u8) -> i32;
}

extern "C" {
    fn zr_is_dir(path: *const u8) -> i32;
}

extern "C" {
    fn zr_file_size(path: *const u8) -> i64;
}

extern "C" {
    fn zr_readdir_count(path: *const u8) -> i64;
}

extern "C" {
    fn zr_readdir_name(path: *const u8, index: usize, buf: *mut u8, cap: usize) -> i64;
}

extern "C" {
    fn zr_getcwd(buf: *mut u8, cap: usize) -> i64;
}

extern "C" {
    fn zr_time_unix_ns() -> i64;
}

extern "C" {
    fn zr_open(path: *const u8, mode: i32) -> isize;
}

extern "C" {
    fn zr_file_mtime(path: *const u8) -> i64;
}

extern "C" {
    fn zr_file_mode(path: *const u8) -> i64;
}

//----- 辅助 -------------------------------------------------------------------

/// 把 `path` 复制进 `buf` 并补 NUL。放不下返回 false。
fn to_cstr(path: str, buf: *mut u8, cap: usize) -> bool {
    if path.len >= cap {
        return false;
    }
    let mut i = 0;
    while i < path.len {
        buf[i] = path.ptr[i];
        i = i + 1;
    }
    buf[path.len] = 0;
    return true;
}

/// 两个路径都转成 NUL 结尾。任一个放不下返回 false。
fn to_two_cstr(a: str, b: str, ba: *mut u8, bb: *mut u8, cap: usize) -> bool {
    if !to_cstr(a, ba, cap) {
        return false;
    }
    return to_cstr(b, bb, cap);
}

//----- 目录 / 文件操作 --------------------------------------------------------

/// 创建目录（权限 0777，受 umask 影响）。父目录必须已存在。
pub fn create_dir(path: str) -> bool {
    let mut buf: [u8; 1024] = [0; 1024];
    if !to_cstr(path, &mut buf[0], 1024) {
        return false;
    }
    return zr_mkdir(&buf[0] as *const u8) == 0;
}

/// 删除空目录。
pub fn remove_dir(path: str) -> bool {
    let mut buf: [u8; 1024] = [0; 1024];
    if !to_cstr(path, &mut buf[0], 1024) {
        return false;
    }
    return zr_rmdir(&buf[0] as *const u8) == 0;
}

/// 删除文件（不能删目录）。
pub fn remove_file(path: str) -> bool {
    let mut buf: [u8; 1024] = [0; 1024];
    if !to_cstr(path, &mut buf[0], 1024) {
        return false;
    }
    return zr_unlink(&buf[0] as *const u8) == 0;
}

/// 重命名或移动文件 / 目录。
pub fn rename(from: str, to: str) -> bool {
    let mut a: [u8; 1024] = [0; 1024];
    let mut b: [u8; 1024] = [0; 1024];
    if !to_two_cstr(from, to, &mut a[0], &mut b[0], 1024) {
        return false;
    }
    return zr_rename(&a[0] as *const u8, &b[0] as *const u8) == 0;
}

/// 路径是否存在。
pub fn exists(path: str) -> bool {
    let mut buf: [u8; 1024] = [0; 1024];
    if !to_cstr(path, &mut buf[0], 1024) {
        return false;
    }
    return zr_path_exists(&buf[0] as *const u8) == 1;
}

/// 路径是否是目录（不存在返回 false）。
pub fn is_dir(path: str) -> bool {
    let mut buf: [u8; 1024] = [0; 1024];
    if !to_cstr(path, &mut buf[0], 1024) {
        return false;
    }
    return zr_is_dir(&buf[0] as *const u8) == 1;
}

/// 文件字节数；不存在或出错返回 -1。
pub fn file_size(path: str) -> i64 {
    let mut buf: [u8; 1024] = [0; 1024];
    if !to_cstr(path, &mut buf[0], 1024) {
        return -1;
    }
    return zr_file_size(&buf[0] as *const u8);
}

//----- 目录遍历 ---------------------------------------------------------------

/// 目录里的条目个数（不含 "." 与 ".."）。出错返回 -1。
pub fn read_dir_count(path: str) -> i64 {
    let mut buf: [u8; 1024] = [0; 1024];
    if !to_cstr(path, &mut buf[0], 1024) {
        return -1;
    }
    return zr_readdir_count(&buf[0] as *const u8);
}

/// 把第 `index` 个条目的名字写进 `buf`（不含结尾 NUL），返回名字长度。
///
/// 失败返回 -1：下标越界、目录打不开、或名字比 `cap` 长。
pub fn read_dir_name(path: str, index: usize, buf: *mut u8, cap: usize) -> i64 {
    let mut pb: [u8; 1024] = [0; 1024];
    if !to_cstr(path, &mut pb[0], 1024) {
        return -1;
    }
    return zr_readdir_name(&pb[0] as *const u8, index, buf, cap);
}

//----- 当前目录 ---------------------------------------------------------------

/// 把当前工作目录写进 `buf`，返回长度（不含 NUL）；失败返回 -1。
pub fn current_dir(buf: *mut u8, cap: usize) -> i64 {
    return zr_getcwd(buf, cap);
}

//----- 临时文件 ---------------------------------------------------------------
//
// 没有 `TMPDIR` 环境变量接口，固定用 `/tmp`。名字 = `/tmp/zr_tmp_<纳秒时间戳>`，
// 纳秒级时间戳碰撞概率极低；`zr_open` 的 `FILE_WRITE` 模式是
// `O_WRONLY|O_CREAT|O_TRUNC`，名字唯一所以不会截断到已存在的文件。

/// 把 `v` 的十进制数字写进 `buf[pos..]`，返回写后的位置。
fn append_u64(buf: *mut u8, pos: usize, mut v: u64) -> usize {
    let mut tmp: [u8; 20] = [0; 20];
    let mut n: usize = 0;
    if v == 0 {
        tmp[0] = 48;
        n = 1;
    } else {
        while v > 0 {
            tmp[n] = ((v % 10) as u8 + 48) as u8;
            v = v / 10;
            n = n + 1;
        }
    }
    let mut i: usize = 0;
    while i < n {
        buf[pos + i] = tmp[n - 1 - i];
        i = i + 1;
    }
    return pos + n;
}

/// 创建临时文件，返回文件描述符（可写）；失败返回 -1。
pub fn temp_file_raw() -> i32 {
    let mut buf: [u8; 256] = [0; 256];
    let mut i: usize = 0;
    let prefix: str = "/tmp/zr_tmp_";
    while i < prefix.len {
        buf[i] = prefix.ptr[i];
        i = i + 1;
    }
    let ns = zr_time_unix_ns();
    if ns < 0 {
        return -1;
    }
    i = append_u64(&mut buf[0], i, ns as u64);
    buf[i] = 0;
    let fd = zr_open(&buf[0] as *const u8, FILE_WRITE);
    if fd < 0 {
        return -1;
    }
    return fd as i32;
}

/// 创建临时文件并包装成 `io::File`；`is_ok()` 判断是否成功。
pub fn temp_file() -> File {
    return File { fd: temp_file_raw() };
}

//----- 元数据 ---------------------------------------------------------------
//
// `st_mtimespec.tv_sec`（Unix 秒）与 `st_mode` 由运行时的 `zr_file_mtime` /
// `zr_file_mode` 提供；`st_mode` 的低 12 位是权限位，高 4 位是文件类型。

/// 文件 / 目录的最后修改时间（Unix 秒）；不存在或出错返回 -1。
pub fn file_mtime(path: str) -> i64 {
    let mut buf: [u8; 1024] = [0; 1024];
    if !to_cstr(path, &mut buf[0], 1024) {
        return -1;
    }
    return zr_file_mtime(&buf[0] as *const u8);
}

/// 文件 / 目录的 `st_mode` 位（含类型位与权限位）；不存在或出错返回 -1。
pub fn file_mode(path: str) -> i64 {
    let mut buf: [u8; 1024] = [0; 1024];
    if !to_cstr(path, &mut buf[0], 1024) {
        return -1;
    }
    return zr_file_mode(&buf[0] as *const u8);
}

//----- 原始指针接口 -----------------------------------------------------------
//
// 路径必须是 NUL 结尾。适合调用方自己拼好路径（例如 path::join 之后补 0），
// 避免为了构造 `str` 再复制一遍。语义与上面的 `str` 版本完全一致。

pub fn create_dir_raw(path: *const u8) -> bool {
    return zr_mkdir(path) == 0;
}

pub fn remove_dir_raw(path: *const u8) -> bool {
    return zr_rmdir(path) == 0;
}

pub fn remove_file_raw(path: *const u8) -> bool {
    return zr_unlink(path) == 0;
}

pub fn rename_raw(from: *const u8, to: *const u8) -> bool {
    return zr_rename(from, to) == 0;
}

pub fn exists_raw(path: *const u8) -> bool {
    return zr_path_exists(path) == 1;
}

pub fn is_dir_raw(path: *const u8) -> bool {
    return zr_is_dir(path) == 1;
}

pub fn file_size_raw(path: *const u8) -> i64 {
    return zr_file_size(path);
}

pub fn file_mtime_raw(path: *const u8) -> i64 {
    return zr_file_mtime(path);
}

pub fn file_mode_raw(path: *const u8) -> i64 {
    return zr_file_mode(path);
}

pub fn read_dir_count_raw(path: *const u8) -> i64 {
    return zr_readdir_count(path);
}

pub fn read_dir_name_raw(path: *const u8, index: usize, buf: *mut u8, cap: usize) -> i64 {
    return zr_readdir_name(path, index, buf, cap);
}
