//=============================================================================
// std/core/core.zr — core 层：零依赖核心库
//
// 与 Rust 的 core crate 对应：只有类型定义、trait、编译期内建与 panic。
// 不含堆分配（见 alloc/mem.zr）、不含 OS / I/O（见 std/sys.zr）。
//
// 唯一的外部符号是运行时的 `zr_panic`（Rust 的 core 同样自带 panic 入口）。
//=============================================================================

//----- 外部运行时符号声明（仅 panic；分配与 IO 在更高层）---------------------

extern "C" {
    fn zr_panic(msg: *const u8, len: usize) -> !;
}

//=============================================================================
// trait：zr 的核心多态抽象
//=============================================================================

/// 可相等比较。
pub trait Eq {
    fn eq(self, other: Self) -> bool;
    fn ne(self, other: Self) -> bool {
        return !self.eq(other);
    }
}

/// 可全序比较（要求先实现 Eq）。
pub trait Ord: Eq {
    fn lt(self, other: Self) -> bool;
    fn le(self, other: Self) -> bool { return self.lt(other) || self.eq(other); }
    fn gt(self, other: Self) -> bool { return !self.le(other); }
    fn ge(self, other: Self) -> bool { return !self.lt(other); }
}

/// 可复制语义（按位拷贝即可，无资源所有权转移）。
/// 标记 trait，表示类型可以安全地隐式复制。
pub trait Copy {}

/// 可克隆语义（可能需要深拷贝）。
pub trait Clone {
    fn clone(self) -> Self;
}

/// 可格式化输出。
pub trait Display {
    /// 把自身写入给定的文件描述符。
    fn display(self, fd: i32);
}

/// 调试格式化（带类型信息，通常比 Display 更详细）。
pub trait Debug: Display {}

/// 可哈希，用于哈希表等容器。
pub trait Hash {
    fn hash(self) -> u64;
}

/// 默认构造。
pub trait Default {
    fn default() -> Self;
}

/// 迭代器：产生一串同类型的值。
pub trait Iterator {
    type Item;

    /// 返回下一个元素，耗尽时返回 null。
    fn next(self: &mut Self) -> *mut Self::Item;
}

/// 可转换为字符串。
pub trait ToString {
    fn to_string(self) -> String;
}

//=============================================================================
// Option<T> — 可能为空的单值
//=============================================================================

pub enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    pub fn is_some(self) -> bool {
        match self {
            Option::Some(_) => return true,
            Option::None      => return false,
        }
    }

    pub fn is_none(self) -> bool {
        return !self.is_some();
    }

    /// 取出值，为空时触发 panic。
    pub fn unwrap(self) -> T {
        match self {
            Option::Some(v) => return v,
            Option::None    => panic("called `Option::unwrap` on a `None` value"),
        }
    }

    /// 为空时返回给定的默认值。
    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Option::Some(v) => return v,
            Option::None    => return default,
        }
    }

    /// 对内部值做映射。
    pub fn map<U>(self, f: fn(T) -> U) -> Option<U> {
        match self {
            Option::Some(v) => return Option::Some(f(v)),
            Option::None    => return Option::None,
        }
    }

    /// 链式调用，为空则直接传递 None。
    pub fn and_then<U>(self, f: fn(T) -> Option<U>) -> Option<U> {
        match self {
            Option::Some(v) => return f(v),
            Option::None    => return Option::None,
        }
    }

    /// 取出值；为空时用 `msg` 触发 panic（对应 Rust `Option::expect`）。
    pub fn expect(self, msg: []const u8) -> T {
        match self {
            Option::Some(v) => return v,
            Option::None    => panic(msg),
        }
    }

    /// 为空时调用 `f` 生成默认值。
    pub fn unwrap_or_else(self, f: fn() -> T) -> T {
        match self {
            Option::Some(v) => return v,
            Option::None    => return f(),
        }
    }

    /// 映射后取默认值（对应 Rust `Option::map_or`）。
    pub fn map_or<U>(self, default: U, f: fn(T) -> U) -> U {
        match self {
            Option::Some(v) => return f(v),
            Option::None    => return default,
        }
    }

    /// 把 `Option` 转成 `Result`：`Some(v) -> Ok(v)`，`None -> Err(err)`。
    pub fn ok_or<E>(self, err: E) -> Result<T, E> {
        match self {
            Option::Some(v) => return Result::Ok(v),
            Option::None    => return Result::Err(err),
        }
    }

    /// 保留满足谓词的值（对应 Rust `Option::filter`）。
    pub fn filter(self, pred: fn(T) -> bool) -> Option<T> {
        match self {
            Option::Some(v) => {
                if pred(v) { return Option::Some(v); }
                return Option::None;
            }
            Option::None => return Option::None,
        }
    }

    /// 为空时返回 `other`。
    pub fn or(self, other: Option<T>) -> Option<T> {
        match self {
            Option::Some(v) => return Option::Some(v),
            Option::None    => return other,
        }
    }
}

//=============================================================================
// Result<T, E> — 可成功可失败的计算结果
//=============================================================================

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    pub fn is_ok(self) -> bool {
        match self {
            Result::Ok(_)  => return true,
            Result::Err(_) => return false,
        }
    }

    pub fn is_err(self) -> bool {
        return !self.is_ok();
    }

    pub fn unwrap(self) -> T {
        match self {
            Result::Ok(v)  => return v,
            Result::Err(_) => panic("called `Result::unwrap` on an `Err` value"),
        }
    }

    pub fn expect(self, msg: []const u8) -> T {
        match self {
            Result::Ok(v)  => return v,
            Result::Err(_) => panic(msg),
        }
    }

    pub fn map<U>(self, f: fn(T) -> U) -> Result<U, E> {
        match self {
            Result::Ok(v)  => return Result::Ok(f(v)),
            Result::Err(e) => return Result::Err(e),
        }
    }

    pub fn and_then<U>(self, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match self {
            Result::Ok(v)  => return f(v),
            Result::Err(e) => return Result::Err(e),
        }
    }

    /// 成功时返回值，失败时返回 `default`。
    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Result::Ok(v)  => return v,
            Result::Err(_) => return default,
        }
    }

    /// 失败时调用 `f` 生成默认值。
    pub fn unwrap_or_else(self, f: fn(E) -> T) -> T {
        match self {
            Result::Ok(v)  => return v,
            Result::Err(e) => return f(e),
        }
    }

    /// 丢弃错误，转成 `Option<T>`。
    pub fn ok(self) -> Option<T> {
        match self {
            Result::Ok(v)  => return Option::Some(v),
            Result::Err(_) => return Option::None,
        }
    }

    /// 丢弃成功值，转成 `Option<E>`。
    pub fn err(self) -> Option<E> {
        match self {
            Result::Ok(_)  => return Option::None,
            Result::Err(e) => return Option::Some(e),
        }
    }

    /// 映射错误值，成功值不变。
    pub fn map_err<F>(self, f: fn(E) -> F) -> Result<T, F> {
        match self {
            Result::Ok(v)  => return Result::Ok(v),
            Result::Err(e) => return Result::Err(f(e)),
        }
    }
}

//=============================================================================
// 整数基元上的通用实现
//=============================================================================

impl Eq for i32 {
    fn eq(self, other: i32) -> bool { return self == other; }
}
impl Ord for i32 {
    fn lt(self, other: i32) -> bool { return self < other; }
}
impl Copy for i32 {}
impl Clone for i32 {
    fn clone(self) -> i32 { return self; }
}
impl Default for i32 {
    fn default() -> i32 { return 0; }
}

impl Eq for i64 {
    fn eq(self, other: i64) -> bool { return self == other; }
}
impl Ord for i64 {
    fn lt(self, other: i64) -> bool { return self < other; }
}
impl Copy for i64 {}
impl Clone for i64 {
    fn clone(self) -> i64 { return self; }
}

impl Eq for u32 {
    fn eq(self, other: u32) -> bool { return self == other; }
}
impl Ord for u32 {
    fn lt(self, other: u32) -> bool { return self < other; }
}
impl Copy for u32 {}
impl Clone for u32 {
    fn clone(self) -> u32 { return self; }
}

impl Eq for u64 {
    fn eq(self, other: u64) -> bool { return self == other; }
}
impl Ord for u64 {
    fn lt(self, other: u64) -> bool { return self < other; }
}
impl Copy for u64 {}
impl Clone for u64 {
    fn clone(self) -> u64 { return self; }
}

impl Eq for bool {
    fn eq(self, other: bool) -> bool { return self == other; }
}
impl Copy for bool {}
impl Clone for bool {
    fn clone(self) -> bool { return self; }
}

impl Copy for u8 {}
impl Eq for u8 {
    fn eq(self, other: u8) -> bool { return self == other; }
}
impl Ord for u8 {
    fn lt(self, other: u8) -> bool { return self < other; }
}
impl Clone for u8 {
    fn clone(self) -> u8 { return self; }
}
impl Default for u8 {
    fn default() -> u8 { return 0; }
}

impl Copy for char {}
impl Eq for char {
    fn eq(self, other: char) -> bool { return self == other; }
}
impl Ord for char {
    fn lt(self, other: char) -> bool { return self < other; }
}
impl Clone for char {
    fn clone(self) -> char { return self; }
}

//------------------------------------------------------------------------------
// Hash：供 `HashMap` 等容器做键用。
//
// 注意 receiver 必须写成显式的 `self: T`。裸 `self` 会被降成 `&Self`，
// 而 zr 的 `*&scalar` 解引用目前是坏的（`AddrOf => Deref` 占位），
// 写裸 `self` 根本取不到标量的值。
//------------------------------------------------------------------------------

impl Hash for i32 {
    fn hash(self: i32) -> u64 { return self as u64; }
}
impl Hash for i64 {
    fn hash(self: i64) -> u64 { return self as u64; }
}
impl Hash for u32 {
    fn hash(self: u32) -> u64 { return self as u64; }
}
impl Hash for u64 {
    fn hash(self: u64) -> u64 { return self; }
}
impl Hash for u8 {
    fn hash(self: u8) -> u64 { return self as u64; }
}
impl Hash for bool {
    fn hash(self: bool) -> u64 {
        if self { return 1; }
        return 0;
    }
}
impl Hash for char {
    fn hash(self: char) -> u64 { return self as u64; }
}

//=============================================================================
// 数值工具函数
//=============================================================================

/// 两数取小。
pub fn min<T: Ord>(a: T, b: T) -> T {
    if a.lt(b) { return a; }
    return b;
}

/// 两数取大。
pub fn max<T: Ord>(a: T, b: T) -> T {
    if a.lt(b) { return b; }
    return a;
}

/// 将 `value` 钳制在 `[lo, hi]` 范围内。
pub fn clamp<T: Ord>(value: T, lo: T, hi: T) -> T {
    if value.lt(lo) { return lo; }
    if hi.lt(value) { return hi; }
    return value;
}

/// 交换两个可变引用的值。
pub fn swap<T>(a: &mut T, b: &mut T) {
    let tmp = *a;
    *a = *b;
    *b = tmp;
}

//=============================================================================
// panic 与断言实现（core 自带，不依赖 OS）
//=============================================================================

/// 无条件终止程序，并打印消息。
pub fn panic(msg: str) -> ! {
    zr_panic(msg.ptr, msg.len);
}

/// 尚未实现的功能，触发 panic。
pub fn unimplemented() -> ! {
    panic("not yet implemented");
}

/// 不可达分支的兜底，触发 panic。
pub fn unreachable() -> ! {
    panic("internal error: entered unreachable code");
}

/// 条件为假时终止程序。
pub fn assert(cond: bool, msg: []const u8) {
    if !cond {
        panic(msg);
    }
}

/// 两个值不等时终止程序。
pub fn assert_eq<T: Eq>(a: T, b: T, msg: []const u8) {
    if !a.eq(b) {
        panic(msg);
    }
}

//=============================================================================
// 编译期内建（不依赖分配 / OS）
//=============================================================================

/// 编译期内建：类型 `T` 的字节大小。
pub fn size_of<T>() -> usize;

/// 编译期内建：类型 `T` 的对齐。
pub fn align_of<T>() -> usize;
