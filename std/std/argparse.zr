//=============================================================================
// std/argparse.zr — 命令行参数解析
//
// 入口桩 `_start` 会在调用 `main` 之前把 (argc, argv) 交给运行时
// （`zr_args_init`）。本模块在那对只读接口上提供两种读取方式：
//
// **按索引读取**（与原来 `std/cli.zr` 的 API 完全一致）：
//
//   argparse::arg_count()          -> usize       参数个数（至少 1）
//   argparse::arg(i)               -> String      第 i 个参数；越界返回空串
//   argparse::arg_opt(i)           -> Option<String>
//   argparse::args()               -> Vec<String> 全部参数（含程序名）
//   argparse::program_name()       -> String      arg(0)
//   argparse::get(i, default)      -> String      第 i 个参数，越界返回 default
//
// **按参数名读取**（支持 `--name=value`、`--name value`、`-n value`、
// `-n=value`；`name` 写成 `name` 或 `--name` 都行）：
//
//   argparse::value(name)          -> Option<String>
//   argparse::value_or(name, d)    -> String
//   argparse::flag(name)           -> bool        出现且不是 `=false` / `=0`
//   argparse::has(name)            -> bool        出现过（无论带没带值）
//   argparse::positionals()        -> Vec<String> 去掉程序名与选项/选项值后的参数
//
//   argparse::subcommand()         -> String      第一个非选项的位置参数（子命令）
//   argparse::print_help(..)      -> String      生成带子命令列表的帮助文本
//   argparse::help_requested()     -> bool        argv 中有 --help / -h
//
// 另有可注入参数表的 `*_in(argv, ..)` 版本，便于不走进程参数做单测。
//
// 参数是进程启动时内核 / dyld 交给进程的原始字节（C 字符串），这里复制成
// `String`，之后即使进程继续运行也不会失效。
//=============================================================================

use core::{Option, size_of};
use collections::Vec;
use string::String;

extern "C" {
    fn zr_args_count() -> usize;
    fn zr_args_ptr(i: usize) -> *const u8;
}

//----- 按索引读取 -------------------------------------------------------------

/// 参数个数（含程序名）。没有参数信息时返回 0。
pub fn arg_count() -> usize {
    return zr_args_count();
}

/// 第 `i` 个参数；越界返回空串。
pub fn arg(i: usize) -> String {
    let p = zr_args_ptr(i);
    if p == 0 as *const u8 {
        return String::new();
    }
    return String::from_cstr(p);
}

/// 第 `i` 个参数；越界返回 None。
pub fn arg_opt(i: usize) -> Option<String> {
    let p = zr_args_ptr(i);
    if p == 0 as *const u8 {
        return Option::None;
    }
    return Option::Some(String::from_cstr(p));
}

/// 第 `i` 个参数，越界时返回 `default`。
pub fn get(i: usize, default: str) -> String {
    let p = zr_args_ptr(i);
    if p == 0 as *const u8 {
        return String::from_bytes(default);
    }
    return String::from_cstr(p);
}

/// 全部参数（下标 0 是程序名）。
pub fn args() -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let n = zr_args_count();
    let mut i: usize = 0;
    while i < n {
        out.push(arg(i));
        i = i + 1;
    }
    return out;
}

/// 程序名（等价于 `arg(0)`）。
pub fn program_name() -> String {
    return arg(0);
}

//----- 按参数名读取 -----------------------------------------------------------

/// 匹配结果：不是这个键。
const ARG_NONE: i32 = 0;
/// 匹配结果：只有键，没有 `=value`（值可能在下一条参数里）。
const ARG_KEY: i32 = 1;
/// 匹配结果：`--key=value`，第二个返回值是 value 的起始下标。
const ARG_EQ: i32 = 2;

/// 去掉名字前面的 `-` / `--`，返回 (起始下标, 长度)。
fn argparse_name(name: str) -> (usize, usize) {
    let mut i: usize = 0;
    while i < name.len && name.ptr[i] == b'-' {
        i = i + 1;
    }
    return (i, name.len - i);
}

/// 把一条参数与名字比对。
///
/// 返回 `(ARG_*, value_start)`：`ARG_EQ` 时 `value_start` 指向 `=` 后面的
/// 第一个字节；其余情况为 0。
fn argparse_match(
    p: *const u8,
    len: usize,
    np: *const u8,
    nlen: usize,
) -> (i32, usize) {
    // 必须是以 `-` 开头的选项，且不能只有 `-`。
    if len < 2 { return (ARG_NONE, 0); }
    if p[0] != b'-' { return (ARG_NONE, 0); }
    let mut s: usize = 1;
    while s < len && p[s] == b'-' {
        s = s + 1;
    }
    if s >= len { return (ARG_NONE, 0); }
    if len - s < nlen { return (ARG_NONE, 0); }

    let mut k: usize = 0;
    while k < nlen {
        if p[s + k] != np[k] { return (ARG_NONE, 0); }
        k = k + 1;
    }
    // 名字后面必须是结尾或 `=`；`--namex` 不能算匹配 `name`。
    if s + nlen == len { return (ARG_KEY, 0); }
    if p[s + nlen] == b'=' { return (ARG_EQ, s + nlen + 1); }
    return (ARG_NONE, 0);
}

/// 名字归一化后的指针（去掉前导 `-`）。
fn argparse_skip_dashes(np: *const u8, nlen: usize) -> (*const u8, usize) {
    let mut i: usize = 0;
    while i < nlen && np[i] == b'-' {
        i = i + 1;
    }
    return ((np as usize + i) as *const u8, nlen - i);
}

/// 一条参数是否是"选项"（`-x` / `--x`；单独的 `-` 视作位置参数）。
fn argparse_is_option(p: *const u8, len: usize) -> bool {
    if len < 2 { return false; }
    return p[0] == b'-';
}

/// 在给定参数表里按名字取选项值。
///
/// 识别的写法：`--name=value`、`--name value`、`-n=value`、`-n value`。
/// 选项后面紧跟的那条参数如果本身以 `-` 开头（例如另一个选项），则视为
/// 该选项没有值，返回 `None`。
pub fn value_in(argv: &Vec<String>, name: str) -> Option<String> {
    let (np, nlen) = argparse_skip_dashes(name.ptr, name.len);
    if nlen == 0 { return Option::None; }

    let mut i: usize = 1;
    while i < argv.len {
        let t = argv.get(i);
        if argparse_is_option(t.ptr, t.len) {
            let (kind, vstart) = argparse_match(t.ptr, t.len, np, nlen);
            if kind == ARG_EQ {
                return Option::Some(String::from_bytes(
                    Slice { ptr: (t.ptr as usize + vstart) as *const u8, len: t.len - vstart },
                ));
            }
            if kind == ARG_KEY {
                if i + 1 < argv.len {
                    let next = argv.get(i + 1);
                    if !argparse_is_option(next.ptr, next.len) {
                        return Option::Some(next);
                    }
                }
            }
        }
        i = i + 1;
    }
    return Option::None;
}

/// 按名字取选项值，没有时返回 `default`。
pub fn value_or_in(argv: &Vec<String>, name: str, default: str) -> String {
    match value_in(argv, name) {
        Option::Some(v) => { return v; }
        Option::None => { return String::from_bytes(default); }
    }
}

/// 选项是否出现（带不带值都算）。
pub fn has_in(argv: &Vec<String>, name: str) -> bool {
    let (np, nlen) = argparse_skip_dashes(name.ptr, name.len);
    if nlen == 0 { return false; }
    let mut i: usize = 1;
    while i < argv.len {
        let t = argv.get(i);
        if argparse_is_option(t.ptr, t.len) {
            let (kind, _vstart) = argparse_match(t.ptr, t.len, np, nlen);
            if kind != ARG_NONE { return true; }
        }
        i = i + 1;
    }
    return false;
}

/// 布尔开关是否打开。
///
/// `--flag` / `-f` 视为打开；`--flag=true` / `=1` / `=yes` 也视为打开，
/// `=false` / `=0` / `=no` 视为关闭。
pub fn flag_in(argv: &Vec<String>, name: str) -> bool {
    let (np, nlen) = argparse_skip_dashes(name.ptr, name.len);
    if nlen == 0 { return false; }
    let mut i: usize = 1;
    while i < argv.len {
        let t = argv.get(i);
        if argparse_is_option(t.ptr, t.len) {
            let (kind, vstart) = argparse_match(t.ptr, t.len, np, nlen);
            if kind == ARG_KEY {
                // `--key value` 是带值选项，不是布尔开关；只有后面紧跟另一个
                // 选项（或到结尾）时才按开关算。裸开关后面跟位置参数这种歧义
                // 写法请改用 `--key=true`。
                if i + 1 < argv.len {
                    let next = argv.get(i + 1);
                    if !argparse_is_option(next.ptr, next.len) { return false; }
                }
                return true;
            }
            if kind == ARG_EQ {
                let vlen = t.len - vstart;
                if vlen == 0 { return false; }
                let c = t.ptr[vstart];
                if vlen == 4 && c == b't' { return true; }   // true
                if vlen == 1 && c == b'1' { return true; }
                if vlen == 3 && c == b'y' { return true; }   // yes
                return false;
            }
        }
        i = i + 1;
    }
    return false;
}

//----- 子命令与帮助生成 -------------------------------------------------------

/// argv 中第一个非选项的位置参数（从下标 1 开始扫）。
/// 全是选项时返回空串。
pub fn subcommand_in(argv: &Vec<String>) -> String {
    let mut i: usize = 1;
    while i < argv.len {
        let t = argv.get(i);
        if !argparse_is_option(t.ptr, t.len) {
            return t;
        }
        i = i + 1;
    }
    return String::new();
}

/// 进程参数中的子命令。
pub fn subcommand() -> String {
    return subcommand_in(&args());
}

/// 生成带 USAGE + SUBCOMMANDS 列表的帮助文本。
///
/// `cmd_names` / `cmd_descs` 分别是命令名和命令描述的切片，长度必须等于
/// `ncmd`。每条子命令行前加 4 空格，命令名补到 12 字符。
pub fn print_help(
    name: str,
    desc: str,
    cmd_names: []const str,
    cmd_descs: []const str,
    ncmd: usize,
) -> String {
    let mut out = String::new();

    // <name> - <desc>\n\n
    out.push_bytes(name);
    out.push_byte(b' ');
    out.push_byte(b'-');
    out.push_byte(b' ');
    out.push_bytes(desc);
    out.push_byte(b'\n');
    out.push_byte(b'\n');

    // USAGE 段
    out.push_bytes("USAGE:");
    out.push_byte(b'\n');
    out.push_byte(b' ');
    out.push_byte(b' ');
    out.push_byte(b' ');
    out.push_byte(b' ');
    out.push_bytes(name);
    out.push_byte(b' ');
    out.push_bytes("[OPTIONS]");
    out.push_byte(b' ');
    out.push_bytes("[SUBCOMMAND]");
    out.push_byte(b'\n');
    out.push_byte(b'\n');

    // SUBCOMMANDS 段
    out.push_bytes("SUBCOMMANDS:");
    out.push_byte(b'\n');

    let mut i: usize = 0;
    while i < ncmd {
        // 每行前 4 空格缩进
        out.push_byte(b' ');
        out.push_byte(b' ');
        out.push_byte(b' ');
        out.push_byte(b' ');

        // 命令名（str 是 16 字节的 fat pointer）
        let nm = *((cmd_names.ptr as usize + i * 16) as *const str);
        out.push_bytes(nm);

        // padding 到 12 字符
        let mut pad: usize = nm.len;
        while pad < 12 {
            out.push_byte(b' ');
            pad = pad + 1;
        }

        // 命令描述
        let ds = *((cmd_descs.ptr as usize + i * 16) as *const str);
        out.push_bytes(ds);
        out.push_byte(b'\n');

        i = i + 1;
    }

    return out;
}

/// argv 里是否请求了帮助（`--help` 或 `-h`）。
pub fn help_requested_in(argv: &Vec<String>) -> bool {
    let mut i: usize = 1;
    while i < argv.len {
        let t = argv.get(i);
        // --help
        if t.len == 6
            && t.ptr[0] == b'-'
            && t.ptr[1] == b'-'
            && t.ptr[2] == b'h'
            && t.ptr[3] == b'e'
            && t.ptr[4] == b'l'
            && t.ptr[5] == b'p'
        {
            return true;
        }
        // -h
        if t.len == 2 && t.ptr[0] == b'-' && t.ptr[1] == b'h' {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// 进程参数里是否请求了帮助。
pub fn help_requested() -> bool {
    return help_requested_in(&args());
}

//----- 子命令配置与分发 -------------------------------------------------------

/// 单条参数/标志定义。
pub struct ArgDef {
    pub name: str,          // e.g. "verbose"
    pub short_name: str,    // e.g. "v"（空串 = 无短标志）
    pub kind: i32,          // 0=FLAG, 1=VALUE, 2=POSITIONAL
    pub desc: str,          // 帮助文本
}

/// 子命令配置。
pub struct CmdConfig {
    pub name: str,          // 子命令名
    pub desc: str,          // 帮助描述
    pub args: *const ArgDef,
    pub nargs: usize,
}

/// 按名字查子命令配置。
fn argparse_find_cmd(cmd: str, cmds: *const CmdConfig, ncmds: usize) -> *const CmdConfig {
    let mut i: usize = 0;
    while i < ncmds {
        let c: *const CmdConfig = (cmds as usize + i * size_of::<CmdConfig>()) as *const CmdConfig;
        let nm = c.name;
        if nm.len == cmd.len {
            let mut j: usize = 0;
            let mut eq = true;
            while j < nm.len {
                if nm.ptr[j] != cmd.ptr[j] { eq = false; break; }
                j = j + 1;
            }
            if eq { return c; }
        }
        i = i + 1;
    }
    return 0 as *const CmdConfig;
}

/// 当前子命令是否设置了某个布尔开关。
///
/// 先检查 `subcommand_in(argv) == cmd`，再用已有 `flag_in` / `has_in` 逻辑。
/// `flag_short` 或 `flag_long` 传空串表示不用该形式。
pub fn has_flag_for(
    cmd: str,
    flag_short: str,
    flag_long: str,
    argv: &Vec<String>,
) -> bool {
    let cur = subcommand_in(argv);
    if cur.len != cmd.len { return false; }
    let mut k: usize = 0;
    while k < cur.len {
        if cur.ptr[k] != cmd.ptr[k] { return false; }
        k = k + 1;
    }
    // 子命令名要跳过 argv[0] 和子命令本身
    let short_ok = flag_short.len > 0 && flag_in(argv, flag_short);
    let long_ok = flag_long.len > 0 && flag_in(argv, flag_long);
    return short_ok || long_ok;
}

/// 当前子命令的带值选项。
///
/// `flag_short` / `flag_long` 任一匹配即可；优先长形式。
pub fn value_for(
    cmd: str,
    flag_short: str,
    flag_long: str,
    argv: &Vec<String>,
) -> String {
    let cur = subcommand_in(argv);
    if cur.len != cmd.len { return String::new(); }
    let mut k: usize = 0;
    while k < cur.len {
        if cur.ptr[k] != cmd.ptr[k] { return String::new(); }
        k = k + 1;
    }
    if flag_long.len > 0 {
        match value_in(argv, flag_long) {
            Option::Some(v) => { return v; }
            Option::None => {}
        }
    }
    if flag_short.len > 0 {
        match value_in(argv, flag_short) {
            Option::Some(v) => { return v; }
            Option::None => {}
        }
    }
    return String::new();
}

/// 根据 argv 返回当前子命令名，并在 cmds 里匹配，返回子命令名（未匹配返回空串）。
///
/// 主程序可这样用：
///
///   let invoked = argparse::dispatch(argparse::args().as_ref(), cmds, ncmds);
///   if invoked.len == 0 {
///       // 打印全局帮助
///   }
///   // match invoked ...
pub fn dispatch(argv: &Vec<String>, cmds: *const CmdConfig, ncmds: usize) -> String {
    let cur = subcommand_in(argv);
    if cur.len == 0 { return String::new(); }
    let mut i: usize = 0;
    while i < ncmds {
        let c: *const CmdConfig = (cmds as usize + i * size_of::<CmdConfig>()) as *const CmdConfig;
        let nm = c.name;
        if nm.len == cur.len {
            let mut j: usize = 0;
            let mut eq = true;
            while j < nm.len {
                if nm.ptr[j] != cur.ptr[j] { eq = false; break; }
                j = j + 1;
            }
            if eq { return cur; }
        }
        i = i + 1;
    }
    return String::new();
}

/// 为指定子命令生成帮助文本。
///
/// 列出子命令描述及其所有 FLAG / VALUE / POSITIONAL 参数的短名、长名与说明。
pub fn print_cmd_help(cmd: *const CmdConfig) -> String {
    let mut out = String::new();
    if cmd == 0 as *const CmdConfig { return out; }

    // <name> - <desc>\n
    out.push_bytes(cmd.name);
    out.push_byte(b' ');
    out.push_byte(b'-');
    out.push_byte(b' ');
    out.push_bytes(cmd.desc);
    out.push_byte(b'\n');
    out.push_byte(b'\n');

    // FLAGS / OPTIONS / ARGUMENTS
    let mut printed_any = false;
    let mut i: usize = 0;
    while i < cmd.nargs {
        let a: *const ArgDef = (cmd.args as usize + i * size_of::<ArgDef>()) as *const ArgDef;
        if a.kind == 2 {
            // POSITIONAL
        } else if a.kind == 0 || a.kind == 1 {
            if !printed_any {
                out.push_bytes("OPTIONS:");
                out.push_byte(b'\n');
                printed_any = true;
            }
            out.push_byte(b' ');
            out.push_byte(b' ');
            if a.short_name.len > 0 {
                out.push_byte(b'-');
                out.push_bytes(a.short_name);
                out.push_byte(b',');
                out.push_byte(b' ');
            } else {
                out.push_bytes("    ");
            }
            if a.kind == 1 {
                out.push_bytes("--");
                out.push_bytes(a.name);
                out.push_bytes(" <value>");
            } else {
                out.push_bytes("--");
                out.push_bytes(a.name);
            }
            out.push_byte(b'\n');
            out.push_byte(b' ');
            out.push_byte(b' ');
            out.push_byte(b' ');
            out.push_byte(b' ');
            out.push_bytes(a.desc);
            out.push_byte(b'\n');
        }
        i = i + 1;
    }

    // POSITIONALS
    let mut printed_pos = false;
    i = 0;
    while i < cmd.nargs {
        let a: *const ArgDef = (cmd.args as usize + i * size_of::<ArgDef>()) as *const ArgDef;
        if a.kind == 2 {
            if !printed_pos {
                out.push_byte(b'\n');
                out.push_bytes("ARGUMENTS:");
                out.push_byte(b'\n');
                printed_pos = true;
            }
            out.push_byte(b' ');
            out.push_byte(b' ');
            out.push_bytes(a.name);
            out.push_byte(b'\n');
            out.push_byte(b' ');
            out.push_byte(b' ');
            out.push_byte(b' ');
            out.push_byte(b' ');
            out.push_bytes(a.desc);
            out.push_byte(b'\n');
        }
        i = i + 1;
    }

    return out;
}

/// 位置参数：去掉程序名、选项本身以及选项的值。
pub fn positionals_in(argv: &Vec<String>) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut i: usize = 1;
    while i < argv.len {
        let t = argv.get(i);
        if argparse_is_option(t.ptr, t.len) {
            // `--key=value` 自带值；`--key value` 要看下一条。
            let mut has_eq = false;
            let mut k: usize = 0;
            while k < t.len {
                if t.ptr[k] == b'=' { has_eq = true; break; }
                k = k + 1;
            }
            if !has_eq && i + 1 < argv.len {
                let next = argv.get(i + 1);
                if !argparse_is_option(next.ptr, next.len) {
                    i = i + 2;
                    continue;
                }
            }
            i = i + 1;
            continue;
        }
        out.push(t);
        i = i + 1;
    }
    return out;
}

/// 按名字取进程参数里的选项值。
pub fn value(name: str) -> Option<String> {
    return value_in(&args(), name);
}

/// 按名字取进程参数里的选项值，没有时返回 `default`。
pub fn value_or(name: str, default: str) -> String {
    return value_or_in(&args(), name, default);
}

/// 进程参数里是否有该选项。
pub fn has(name: str) -> bool {
    return has_in(&args(), name);
}

/// 进程参数里的布尔开关。
pub fn flag(name: str) -> bool {
    return flag_in(&args(), name);
}

/// 进程参数里的位置参数。
pub fn positionals() -> Vec<String> {
    return positionals_in(&args());
}
