//=============================================================================
// std/thread.zr — 线程支持
//
// 提供 Rust 风格的线程 API：
//   thread::start_thread(fn)
//   thread::current_id()
//   thread::sleep_ms(n)
//
// 平台支持：Linux 用 `clone` 系统调用起真线程；macOS 目前的运行时只提供
// 占位实现（`zr_thread_create` 返回 ENOSYS），调用会 panic。
//=============================================================================

//----- 外部运行时符号 ----------------------------------------------------------

extern "C" {
    fn zr_thread_create(start: fn(*mut void), arg: *mut void) -> *mut void;
    fn zr_thread_join(thread: *mut void, retval: *mut *mut void) -> i32;
    fn zr_thread_self() -> u64;
    fn zr_panic(msg: *const u8, len: usize) -> !;
    fn zr_alloc(size: usize, align: usize) -> *mut void;
    fn zr_dealloc(ptr: *mut void, size: usize, align: usize);
}

/// ThreadHandle 的大小：一个函数值（16 字节 `{code, env}` 记录）+ 一个 i32（4 字节）。
fn size_of_thread_handle() -> usize {
    24
}

/// 线程句柄
pub struct Thread {
    /// 运行时的线程句柄槽（`zr_thread_create` 返回）。
    handle: *mut void,
    /// 用户函数与它的返回值槽。
    slot: *mut ThreadHandle,
    joined: bool,
}

/// 线程 ID
pub struct ThreadId { value: u64 }

/// 当前线程的 ID
pub fn current_id() -> ThreadId {
    ThreadId { value: zr_thread_self() }
}

/// 睡眠指定的毫秒数
pub fn sleep_ms(ms: u64) {
    let mut i: u64 = 0;
    while i < ms * 10000 {
        i = i + 1;
    }
}

/// 启动一个新线程
pub fn start_thread(f: fn()) -> Thread {
    let slot = alloc_thread_handle();
    (*slot).func = f;
    let handle = zr_thread_create(thread_entry_impl, slot as *mut void);
    if handle == 0 as *mut void {
        dealloc_thread_handle(slot);
        let msg = "thread spawn failed";
        zr_panic(msg.ptr, msg.len);
    }
    Thread { handle, slot, joined: false }
}

/// 线程真正跑的函数：从句柄里取出用户给的函数并调用。
fn thread_entry_impl(arg: *mut void) {
    let handle = arg as *mut ThreadHandle;
    let f = (*handle).func;
    f();
    (*handle).result = 0;
}

/// 线程启动时用的数据结构：一个函数指针 + 一个返回值槽。
struct ThreadHandle {
    func: fn(),
    result: i32,
}

fn alloc_thread_handle() -> *mut ThreadHandle {
    let ptr = zr_alloc(size_of_thread_handle(), 16);
    ptr as *mut ThreadHandle
}

fn dealloc_thread_handle(ptr: *mut ThreadHandle) {
    zr_dealloc(ptr as *mut void, size_of_thread_handle(), 16);
}

impl Thread {
    /// 等待线程结束，返回 0 表示成功。
    pub fn join(self) -> i32 {
        let mut retval: *mut void = 0 as *mut void;
        let result = zr_thread_join(self.handle, &mut retval);
        self.joined = true;
        result
    }
}

//----- 互斥锁（pthread_mutex 封装，当前平台 macOS/Linux） --------------------

extern "C" {
    fn zr_mutex_init(mutex: *mut void) -> i32;
    fn zr_mutex_lock(mutex: *mut void);
    fn zr_mutex_unlock(mutex: *mut void);
    fn zr_mutex_destroy(mutex: *mut void) -> i32;
}

/// pthread_mutex_t 在 macOS 上是 64 字节（含私有字段）；调用方分配缓冲区。
const MUTEX_SIZE: usize = 64;

/// 互斥锁：持锁保护 `value`，`lock()` 返回可变指针访问临界区，
/// 用完必须 `unlock()`。与 `Box` 同约定：用完显式 `free()`（销毁 + 释放）。
pub struct Mutex<T> {
    lock: *mut void,
    value: T,
}

impl<T> Mutex<T> {
    pub fn new(value: T) -> Mutex<T> {
        let lock = zr_alloc(MUTEX_SIZE, 8) as *mut void;
        if lock == 0 as *mut void { panic("Mutex: out of memory"); }
        if zr_mutex_init(lock) != 0 { panic("Mutex: init failed"); }
        return Mutex { lock: lock, value: value };
    }

    /// 加锁，返回临界区值的可变指针。调用方保证访问后调 `unlock()`。
    pub fn lock(self: &mut Mutex<T>) -> *mut T {
        zr_mutex_lock(self.lock);
        return &self.value;
    }

    /// 解锁。
    pub fn unlock(self: &mut Mutex<T>) {
        zr_mutex_unlock(self.lock);
    }

    /// 销毁互斥锁并释放缓冲区。
    pub fn free(self: &mut Mutex<T>) {
        if self.lock == 0 as *mut void { return; }
        zr_mutex_destroy(self.lock);
        zr_dealloc(self.lock, MUTEX_SIZE, 8);
        self.lock = 0 as *mut void;
    }
}

/// 便捷构造。
pub fn mutex_new<T>(value: T) -> Mutex<T> {
    return Mutex::new(value);
}

/// `Send`：线程间可安全转移所有权。
///
/// zr 无自动 trait 求解，`Send` 是显式 marker——所有类型默认可 Send
/// （除 `Rc<T>` / `RefCell<T>` 这类线程不安全类型，它们不实现本 trait）。
/// 这里提供 trait 定义与 blanket impl 的占位：单线程代码无需显式标注，
/// 跨线程 API 的边界检查留待完整 trait 求解实现。
pub trait Send {}

impl<T> Send for T {}
