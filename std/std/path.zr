//=============================================================================
// std/path.zr — 路径处理
//
// 纯字符串运算，不碰文件系统。因为 zr 的切片（`s[a..b]`）尚未完全可用，
// 这里的"取子串"接口分两种：
//
//   - 偏移 + 长度：`basename_off` / `basename_len` / `extension_off` / ...
//     调用方自己用 `p.ptr[off + i]` 访问；
//   - 写入缓冲区：`join` / `normalize` 把结果写进调用方给的 `out`，返回长度。
//
// 以 0 作为"失败"：结果为空时也返回 0，调用方需要空串时自行处理。
//=============================================================================

/// 是否是绝对路径（以 '/' 开头）。
pub fn is_absolute(p: str) -> bool {
    return p.len > 0 && p.ptr[0] == 47;
}

/// 文件名（最后一个 '/' 之后的部分）在原串里的起始下标。
pub fn basename_off(p: str) -> usize {
    let mut i = p.len;
    while i > 0 {
        if p.ptr[i - 1] == 47 {
            return i;
        }
        i = i - 1;
    }
    return 0;
}

/// 文件名长度。
pub fn basename_len(p: str) -> usize {
    return p.len - basename_off(p);
}

/// 扩展名（最后一个 '.' 之后）的起始下标；没有扩展名时返回 `p.len`。
///
/// 与 Rust 一致：`.bashrc` 这种"点开头"的文件没有扩展名。
pub fn extension_off(p: str) -> usize {
    let off = basename_off(p);
    let mut i = p.len;
    while i > off {
        if p.ptr[i - 1] == 46 {
            if i - 1 == off {
                return p.len;
            }
            return i;
        }
        i = i - 1;
    }
    return p.len;
}

/// 扩展名长度（不含点）。
pub fn extension_len(p: str) -> usize {
    return p.len - extension_off(p);
}

/// 扩展名是否等于 `ext`（区分大小写，`ext` 不带点）。
pub fn has_extension(p: str, ext: str) -> bool {
    let off = extension_off(p);
    if off >= p.len {
        return false;
    }
    let n = p.len - off;
    if n != ext.len {
        return false;
    }
    let mut i = 0;
    while i < n {
        if p.ptr[off + i] != ext.ptr[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// 取 `[start, end)` 的子串；越界或起止颠倒时返回空串。
pub fn substr(s: str, start: usize, end: usize) -> str {
    if start > end || end > s.len {
        return s[0..0];
    }
    return s[start..end];
}

/// 文件名（最后一个 '/' 之后），可能是空串。
pub fn basename(p: str) -> str {
    return p[basename_off(p)..];
}

/// 扩展名（不含点），可能是空串。
pub fn extname(p: str) -> str {
    return p[extension_off(p)..];
}

/// 把 `s` 原样复制进 `out`，返回长度；放不下返回 0。
pub fn copy_into(s: str, out: *mut u8, cap: usize) -> usize {
    if s.len > cap {
        return 0;
    }
    let mut i = 0;
    while i < s.len {
        out[i] = s.ptr[i];
        i = i + 1;
    }
    return s.len;
}

/// 拼接 `a` 与 `b`，写进 `out`，返回长度；放不下返回 0。
///
/// `b` 是绝对路径时直接覆盖 `a`。不会产生重复的 '/'。
pub fn join(a: str, b: str, out: *mut u8, cap: usize) -> usize {
    if is_absolute(b) {
        return copy_into(b, out, cap);
    }
    if a.len == 0 {
        return copy_into(b, out, cap);
    }
    let mut i: usize = 0;
    while i < a.len {
        if i >= cap {
            return 0;
        }
        out[i] = a.ptr[i];
        i = i + 1;
    }
    // 只在 a 不以 '/' 结尾时补分隔符。
    if a.ptr[a.len - 1] != 47 {
        if i >= cap {
            return 0;
        }
        out[i] = 47;
        i = i + 1;
    }
    let mut j: usize = 0;
    while j < b.len {
        if i >= cap {
            return 0;
        }
        out[i] = b.ptr[j];
        i = i + 1;
        j = j + 1;
    }
    return i;
}

/// 词法归一化：合并重复的 '/'、去掉 '.'、按字面解析 '..'。
///
/// 例：`/a//b/./../c` -> `/a/c`，`a/b/..` -> `a`。
/// 不访问文件系统，`..` 不会跨符号链接。空结果写成 `"."`。
pub fn normalize(p: str, out: *mut u8, cap: usize) -> usize {
    let absolute = is_absolute(p);
    let mut len: usize = 0;
    if absolute {
        if cap < 1 {
            return 0;
        }
        out[0] = 47;
        len = 1;
    }
    let mut i: usize = 0;
    while i < p.len {
        // 跳过连续分隔符
        while i < p.len && p.ptr[i] == 47 {
            i = i + 1;
        }
        if i >= p.len {
            break;
        }
        let start = i;
        while i < p.len && p.ptr[i] != 47 {
            i = i + 1;
        }
        let clen = i - start;
        let is_dot = clen == 1 && p.ptr[start] == 46;
        let is_dotdot = clen == 2 && p.ptr[start] == 46 && p.ptr[start + 1] == 46;
        if is_dot {
            // 无需处理
        } else if is_dotdot {
            if len == 0 || (len == 1 && absolute) {
                // 相对路径开头的 ".." 要保留；绝对路径到根就停。
                if !absolute {
                    if len > 0 {
                        if len + 1 > cap {
                            return 0;
                        }
                        out[len] = 47;
                        len = len + 1;
                    }
                    if len + 2 > cap {
                        return 0;
                    }
                    out[len] = 46;
                    out[len + 1] = 46;
                    len = len + 2;
                }
            } else {
                // 弹出最后一段
                if len > 1 && out[len - 1] == 47 {
                    len = len - 1;
                }
                while len > 0 && out[len - 1] != 47 {
                    len = len - 1;
                }
                if len > 1 && out[len - 1] == 47 {
                    len = len - 1;
                }
            }
        } else {
            if len > 0 && out[len - 1] != 47 {
                if len + 1 > cap {
                    return 0;
                }
                out[len] = 47;
                len = len + 1;
            }
            if len + clen > cap {
                return 0;
            }
            let mut k: usize = 0;
            while k < clen {
                out[len] = p.ptr[start + k];
                len = len + 1;
                k = k + 1;
            }
        }
    }
    if len == 0 {
        if cap < 1 {
            return 0;
        }
        out[0] = 46;
        len = 1;
    }
    return len;
}
