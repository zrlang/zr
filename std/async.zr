//=============================================================================
// std/async.zr — 协程、Future 与异步运行时
//
// zr 把 `async fn` 编译为状态机（在 MIR 阶段完成脱糖），本节提供
// 运行时的核心抽象：Future trait、Task 调度器、事件循环与常用组合子。
//=============================================================================

use core::{Option, Result, panic};
use mem::{memcmp, NULL};

//=============================================================================
// Future 协议
//=============================================================================

/// 异步计算的最终产出类型。
pub enum Poll<T> {
    /// 尚未就绪，需稍后再次 poll。
    Pending,
    /// 已就绪，产出 `T`。
    Ready(T),
}

/// Future：可被轮询的异步计算。
/// 编译器把 `async fn` 降级为实现了本 trait 的状态机结构体。
pub trait Future {
    type Output;

    /// 推进计算一步，返回当前状态。
    fn poll(self: &mut Self) -> Poll<Self::Output>;
}

/// 一个就绪的 Future，直接返回给定值。
pub struct Ready<T> {
    pub value: T,
    pub taken: bool,
}

impl<T> Ready<T> {
    pub fn new(v: T) -> Ready<T> {
        return Ready { value: v, taken: false };
    }
}

impl<T> Future for Ready<T> {
    type Output = T;

    fn poll(self: &mut Ready<T>) -> Poll<T> {
        if self.taken {
            panic("polled a completed Ready future");
        }
        self.taken = true;
        return Poll::Ready(self.value);
    }
}

/// 立即就绪的 Future 构造器。
pub fn ready<T>(v: T) -> Ready<T> {
    return Ready::new(v);
}

//=============================================================================
// 任务（Task）
//=============================================================================

/// 一个轻量级任务（协程）的句柄。
/// 在真实实现中，它持有一个指向协程帧的指针与当前状态。
pub struct Task {
    /// 协程帧指针（编译器生成的 resume 函数通过它恢复执行）。
    pub frame: *mut void,
    /// 当前状态。
    pub state: TaskState,
    /// 任务 ID（由调度器分配）。
    pub id:    u64,
}

pub enum TaskState {
    /// 尚未开始运行。
    Created,
    /// 正在运行。
    Running,
    /// 已挂起，等待某个事件。
    Suspended,
    /// 已执行完毕。
    Completed,
    /// 发生错误。
    Failed,
}

impl Task {
    pub fn new(frame: *mut void, id: u64) -> Task {
        return Task { frame, state: TaskState::Created, id };
    }

    /// 手动推进一次任务。由调度器调用。
    pub fn poll(self: &mut Task) {
        if self.state == TaskState::Completed || self.state == TaskState::Failed {
            return;
        }
        self.state = TaskState::Running;
        // 真实实现：调用编译器生成的 resume 函数：
        //   zr_resume(self.frame);
        // 并根据返回值判断是挂起还是完成。
        self.state = TaskState::Completed;
    }

    pub fn is_ready(self) -> bool {
        return self.state == TaskState::Completed;
    }
}

//=============================================================================
// 执行器（Executor）
//=============================================================================

/// 简单的 FIFO 任务调度器。
pub struct Executor {
    pub ready:  Vec<Task>,
    pub waiting: Vec<Task>,
    pub next_id: u64,
}

impl Executor {
    pub fn new() -> Executor {
        return Executor {
            ready:   Vec::new(),
            waiting: Vec::new(),
            next_id: 1,
        };
    }

    /// 提交一个任务并返回其句柄。
    pub fn spawn(self: &mut Executor, frame: *mut void) -> u64 {
        let id = self.next_id;
        self.next_id = self.next_id + 1;
        let task = Task::new(frame, id);
        self.ready.push(task);
        return id;
    }

    /// 运行所有任务直到全部完成。
    pub fn run(self: &mut Executor) {
        while self.ready.len() > 0 || self.waiting.len() > 0 {
            // 处理就绪队列
            let mut i = 0;
            while i < self.ready.len {
                let mut task = self.ready.get(i);
                task.poll();
                if task.state == TaskState::Completed {
                    // 移除并继续
                    self.ready.remove(i);
                } else if task.state == TaskState::Suspended {
                    // 移到等待队列
                    let t = self.ready.remove(i).unwrap();
                    self.waiting.push(t);
                } else {
                    i = i + 1;
                }
            }

            // 事件循环：检查等待中的任务是否可以唤醒
            // （真实实现会调用 epoll / kqueue / io_uring）
            self.progress_waiting();
        }
    }

    /// 唤醒等待中的任务。这里用轮询模拟。
    fn progress_waiting(self: &mut Executor) {
        let mut i = 0;
        while i < self.waiting.len {
            // 简化：假设所有等待任务都已就绪
            let t = self.waiting.remove(i).unwrap();
            self.ready.push(t);
        }
    }

    /// 阻塞等待单个任务完成，并返回其结果。
    pub fn block_on<F: Future>(self: &mut Executor, mut future: F) -> F::Output {
        loop {
            match future.poll() {
                Poll::Ready(v)  => return v,
                Poll::Pending   => {
                    // 让出执行权
                    yield_now();
                }
            }
        }
    }
}

/// 全局默认执行器实例。
pub static mut GLOBAL_EXECUTOR: Executor = Executor {
    ready:   Vec { data: 0 as *mut Task, len: 0, capacity: 0 },
    waiting: Vec { data: 0 as *mut Task, len: 0, capacity: 0 },
    next_id: 1,
};

/// 在全局执行器上 spawn 一个任务。
pub fn spawn(frame: *mut void) -> u64 {
    // 注：访问全局可变状态。zr 当前未实现 `unsafe` 关键字，
    // 此处直接访问；待语言支持 unsafe 块后迁移为 unsafe { ... }。
    return GLOBAL_EXECUTOR.spawn(frame);
}

/// 运行全局执行器直到所有任务完成。
pub fn run_all() {
    // 注：访问全局可变状态。zr 当前未实现 `unsafe` 关键字，
    // 此处直接访问；待语言支持 unsafe 块后迁移为 unsafe { ... }。
    GLOBAL_EXECUTOR.run();
}

//=============================================================================
// 协程原语
//=============================================================================

/// 挂起当前协程，交出执行权。
/// 编译器会把它翻译成对运行时 `yield` 的调用。
pub fn yield_now() {
    // 编译器内建：挂起当前协程并让出给调度器。
    intrinsic!(yield)
}

/// 异步地等待一个 Future 完成。
pub fn await_ready<T>(f: *mut Ready<T>) -> T {
    loop {
        let p = (*f).poll();
        match p {
            Poll::Ready(v)  => return v,
            Poll::Pending   => yield_now(),
        }
    }
}

/// 休眠指定的毫秒数（异步）。
pub async fn sleep(ms: u64) {
    // 真实实现会通过定时器事件挂起当前任务。
    // 这里用忙等待模拟。
    let target = now_ms() + ms;
    while now_ms() < target {
        yield_now();
    }
}

/// 获取当前时间戳（毫秒）。由运行时提供。
pub fn now_ms() -> u64 {
    // 编译器内建：调用 clock_gettime 系统调用。
    intrinsic!(now_ms)
}

//=============================================================================
// 组合子
//=============================================================================

/// 等待两个 Future 都完成。
pub struct Join2<F1, F2, O1, O2>
where
    F1: Future<Output = O1>,
    F2: Future<Output = O2>,
{
    pub f1: F1,
    pub f2: F2,
    pub done1: bool,
    pub done2: bool,
    pub v1:    Option<O1>,
    pub v2:    Option<O2>,
}

impl<F1, F2, O1, O2> Future for Join2<F1, F2, O1, O2>
where
    F1: Future<Output = O1>,
    F2: Future<Output = O2>,
{
    type Output = (O1, O2);

    fn poll(self: &mut Join2<F1, F2, O1, O2>) -> Poll<(O1, O2)> {
        if !self.done1 {
            match self.f1.poll() {
                Poll::Ready(v) => { self.v1 = Option::Some(v); self.done1 = true; }
                Poll::Pending  => {}
            }
        }
        if !self.done2 {
            match self.f2.poll() {
                Poll::Ready(v) => { self.v2 = Option::Some(v); self.done2 = true; }
                Poll::Pending  => {}
            }
        }
        if self.done1 && self.done2 {
            return Poll::Ready((self.v1.unwrap(), self.v2.unwrap()));
        }
        return Poll::Pending;
    }
}

/// 等待两个 Future，返回第一个完成的结果。
pub struct Race<F1, F2, O>
where
    F1: Future<Output = O>,
    F2: Future<Output = O>,
{
    pub f1: F1,
    pub f2: F2,
    pub finished: bool,
    pub value: Option<O>,
}

impl<F1, F2, O> Future for Race<F1, F2, O>
where
    F1: Future<Output = O>,
    F2: Future<Output = O>,
{
    type Output = O;

    fn poll(self: &mut Race<F1, F2, O>) -> Poll<O> {
        if self.finished { panic("polling completed Race"); }

        match self.f1.poll() {
            Poll::Ready(v) => { self.finished = true; self.value = Option::Some(v); }
            Poll::Pending  => {}
        }
        if self.finished { return Poll::Ready(self.value.unwrap()); }

        match self.f2.poll() {
            Poll::Ready(v) => { self.finished = true; self.value = Option::Some(v); }
            Poll::Pending  => {}
        }
        if self.finished { return Poll::Ready(self.value.unwrap()); }

        return Poll::Pending;
    }
}

//=============================================================================
// 通道（Channel）：多任务间通信
//=============================================================================

/// 一个无锁的单生产者单消费者通道。
pub struct Channel<T> {
    pub buffer:  Vec<T>,
    pub capacity: usize,
}

impl<T> Channel<T> {
    pub fn new(cap: usize) -> Channel<T> {
        return Channel { buffer: Vec::new(), capacity: cap };
    }

    /// 发送一个值，通道满时挂起。
    pub fn send(self: &mut Channel<T>, value: T) {
        while self.buffer.len >= self.capacity {
            yield_now();
        }
        self.buffer.push(value);
    }

    /// 接收一个值，通道空时挂起。
    pub fn recv(self: &mut Channel<T>) -> T {
        while self.buffer.len == 0 {
            yield_now();
        }
        return self.buffer.remove(0).unwrap();
    }

    pub fn len(self) -> usize { return self.buffer.len; }

    pub fn is_empty(self) -> bool { return self.buffer.len == 0; }
}

/// 创建一个通道并返回（发送端, 接收端）。
pub fn channel<T>(cap: usize) -> (Sender<T>, Receiver<T>) {
    let ch = Channel::new(cap);
    return (Sender { inner: ch }, Receiver { inner: ch });
}

pub struct Sender<T> {
    pub inner: Channel<T>,
}

pub struct Receiver<T> {
    pub inner: Channel<T>,
}
